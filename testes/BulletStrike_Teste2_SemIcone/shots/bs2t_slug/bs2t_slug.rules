// [TESTE] Projetil do railgun Tupa de teste. Copia do projetil vanilla 0.30.3 (shots/bullet_railgun/bullet_railgun.rules,
// que tem o comportamento do 0.30.4c) com o buff PROPRIO BS2T_RailShot no lugar de RailgunShot e numeros do estudo:
// alcance 360 (max 600), velocidade 420 (max 1200), poco de dano 20000, penetracao 18, escudo 12000, estrutural 1800.
// Sem campos que so existem no 0.30.5 (StructuralDamageRetentionPerHit etc.). Arte e particulas vanilla por ./Data.

ID = "rafaeltessaro.bs2t_slug_tiro"
Range = { BaseValue=360; BuffType=BS2T_RailShot; BuffMode=Multiply; MaxValue=600; }
IdealRange
[
	{ BaseValue=180; BuffType=BS2T_RailShot; BuffMode=Multiply; MaxValue=300; }
	{ BaseValue=360; BuffType=BS2T_RailShot; BuffMode=Multiply; MaxValue=600; }
]
IdealRadius = [5, 50]
Speed = { BaseValue=420; BuffType=BS2T_RailShot; BuffMode=Multiply; MaxValue=1200; }
ReceivableBuffs = [BS2T_RailShot]

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.3
		Density = 0.0001
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 3d
		ModifiesLinearVelocity = true
		VelocityCompensation = 100%
	}

	Death
	{
		Type = DeathByLifetime
	}

	Targetable
	{
		Type = Targetable
		Health = 8000
		TargetCategory = "bullet"

		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}

	DamagePool
	{
		Type = DamagePool
		Damage = { BaseValue=20000; BuffType=BS2T_RailShot; BuffMode=Multiply; }
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = { BaseValue=18; BuffType=BS2T_RailShot; BuffMode=Multiply; }
		PenetrationSpeed = &~/Speed

		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational

		HitShield
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=12000; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
				}
				{
					Type = Impulse
					Impulse = { BaseValue=140; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = 0
					DamagePool = DamagePool
					DamagePoolFactor = { BaseValue=1; EffectScaleExponent=1; }
				}
				{
					Type = Impulse
					Impulse = { BaseValue=140; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
				}
			]

			MediaEffectsScale = { BaseValue=1; BuffType=BS2T_RailShot; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/shots/bullet_railgun/particles/bullet_hit_railgun.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_railgun_sparks.rules>
				&<./Data/shots/bullet_large/particles/bullet_smoke_large.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_flash_railgun.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/bullet_railgun/sounds/railgun_impact_01.wav",
									"./Data/shots/bullet_railgun/sounds/railgun_impact_02.wav",
									"./Data/shots/bullet_railgun/sounds/railgun_impact_03.wav"]
					Volume = { BaseValue=.75; BuffType=BS2T_RailShot; BuffMode=Multiply; }
					SpeedVariation = .15
				}

				: /BASE_SHAKE
				{
					ShakeAmount = { BaseValue=.1; BuffType=BS2T_RailShot; BuffMode=Multiply; }
					Duration = .75
				}
			]
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=1800; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
				}
				{
					Type = Impulse
					Impulse = { BaseValue=34; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
				}
			]

			MediaEffectsScale = { BaseValue=1; BuffType=BS2T_RailShot; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/shots/bullet_railgun/particles/bullet_hit_struct_railgun.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_hit_struct_railgun_sparks.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/bullet_railgun/sounds/railgun_impact_01.wav",
									"./Data/shots/bullet_railgun/sounds/railgun_impact_02.wav",
									"./Data/shots/bullet_railgun/sounds/railgun_impact_03.wav"]
					Volume = { BaseValue=.5; BuffType=BS2T_RailShot; BuffMode=Multiply; }
					SpeedVariation = .15
				}
			]
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue=1000; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
					DamagePool = DamagePool
					DoPooledDamageFirst = true
				}
				{
					Type = Impulse
					Impulse = { BaseValue=140; BuffType=BS2T_RailShot; BuffMode=Multiply; EffectScaleExponent=1; }
				}
			]

			MediaEffectsScale = { BaseValue=1; BuffType=BS2T_RailShot; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/shots/bullet_railgun/particles/bullet_penetrate_railgun.rules>
			]
		}
		PenetratingStructural
		{
			// Sem efeito (igual ao vanilla 0.30.3/0.30.4c).
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite
	{
		Type = AnimatedSprite
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "./Data/shots/bullet_railgun/bullet_railgun.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [2.25*1.25, 1.5*1.25]
				TargetBlendMode
				{
					SourceRgbFactor = SourceAlpha
					DestRgbFactor = One
					RgbOperator = Add
					SourceAlphaFactor = Zero
					DestAlphaFactor = One
					AlphaOperator = Add
				}
			}
			FrameCount = 16
			FrameSize = [128, 128]
			FramesPerRow = 4
			FramesPerSecond = 60
		}
	}

	GlowSprite
	{
		Type = Sprite
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		RenderBucket = BulletUpper2
		Z = .25
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [10, 10]
			VertexColor
			{
				Rf = 1
				Gf = 0.82
				Bf = 0.5
				Af = 1
			}
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.2
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		MediaEffectsScale = { BaseValue=1; BuffType=BS2T_RailShot; BuffMode=Multiply; }
		MediaEffects
		[
			&<./Data/shots/bullet_railgun/particles/bullet_trail_railgun.rules>
			&<./Data/shots/bullet_railgun/particles/bullet_trail_railgun_ring.rules>
			&<./Data/shots/bullet_railgun/particles/bullet_trail_railgun_ring_distortion.rules>
		]
	}
}
