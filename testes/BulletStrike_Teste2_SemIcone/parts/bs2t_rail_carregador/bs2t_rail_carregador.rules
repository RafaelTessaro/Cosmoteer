		Capacitores
		{
			Type = ResourceSprites
			Location = [1.5, 2.6]
			ResourceStorage = LoaderBattery
			Layer = "doodads_high"
			ResourceLevels
			[
				{ File = "capacitores1.png"; Size = [3, 1] }
				{ File = "capacitores2.png"; Size = [3, 1] }
				{ File = "capacitores3.png"; Size = [3, 1] }
			]
		}

		FireEffect
		{
			Type = TriggeredEffects
			Trigger = ProjectileStartTrigger
			Location = [1.5, 0.5]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/ships/terran/railgun_loader/sounds/railgun_shot_01.wav",
									"./Data/ships/terran/railgun_loader/sounds/railgun_shot_02.wav",
									"./Data/ships/terran/railgun_loader/sounds/railgun_shot_03.wav"]
					Volume = 1
					SpeedVariation = .15
				}
			]
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [1.5, 2]
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 2]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 2]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3, 4]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3, 4]
				}
				{
					Toggle = AmmoPrereq
					Delay = 6
					AtlasSprite
					{
						File = &/INDICATORS/NoAmmo
						Size = [1, 1]
					}
				}
				{
					Toggle = LoaderBattery
					Delay = 6
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 4]
		}
	}

	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = (&~/Part/Components/AmmoStorage/GridRect/2) * (&~/Part/Components/AmmoStorage/GridRect/3) * (&<./Data/resources/bullet/bullet.rules>/MaxStackSize) + (&~/Part/Components/LoadedAmmo/MaxResources)
		PowerCapacity = (&~/Part/Components/LoaderBattery/MaxResources) / 1000
	}
}
