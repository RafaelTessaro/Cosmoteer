				{ File = "../../gui/digitos/digito8.png"; Size = [0.3, 0.5] }
				{ File = "../../gui/digitos/digito9.png"; Size = [0.3, 0.5] }
			]
		}
		DigitoDezena
		{
			Type = ValueSprites
