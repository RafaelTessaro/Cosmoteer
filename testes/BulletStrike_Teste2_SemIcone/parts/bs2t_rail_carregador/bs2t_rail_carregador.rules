		// culatra fecha quando a municao entra e abre depois do tiro (D:564-683: DoodadToggle = LoadedAmmo)
		CulatraGraficos
		{
			Type = Graphics
			Location = [1.5, 0.5]
			OperationalToggle = IsOperational
			DoodadToggle = LoadedAmmo
			ShowToggledDoodadsWhenNotOperational = true
			ToggleOnDoodad
			{
				Layer = "doodads_high"
