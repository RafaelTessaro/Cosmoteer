// =====================================================================================================
//  [TESTE] Esteira de municao (bloco fechado 1x1). Copia do cano de calor adaptavel vanilla com tipo de porta
//  PROPRIO (rafaeltessaro.bs2t_esteira): canos de calor e radiadores (porta "thermal") nunca se ligam nela.
//  A esteira nao guarda nada; quem move a municao sao fabricas (entrada), paiois (deposito) e armas (saida).
//  Custo acima das 2 de aco da estrutura de baixo (senao a construcao trava: AW 04-creating-parts.md:358-381).
// =====================================================================================================

Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/BS2TEsteira"
	IconNameKey = "Parts/BS2TEsteiraIcon"
	DescriptionKey = "Parts/BS2TEsteiraDesc"
	ID = rafaeltessaro.bs2t_esteira
	EditorGroups = ["BS2Teste"]
	Resources
	[
		[steel, 4]
		[coil, 1]
	]
	Size = [1, 1]
	IsRotateable = false
	IsFlippable = false
	SelectionPriority = 0
	MaxHealth = 1000
	TypeCategories = [bs2t_esteira]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	CrewSpeedFactor = 0
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		NoEsteira
		{
			// no de roteamento da esteira = receptor do sinal "esteira andando" (padrao do cano de calor vanilla
			// e do medidor do exemplo coolant, rodado no motor 0.30.4c)
			Type = NetworkValueReceiver
			Mode = Max
			Categories = [ rafaeltessaro.bs2t_atividade ]
			AllowUncategorized = false
		}
		Andando
		{
			// liga quando algum paiol desta rede mudou o estoque no ultimo segundo (V railgun_loader IsOverclocked: mesmo padrao)
			Type = ThresholdToggle
			ValueFrom = NoEsteira
			MinAmount = 0
			MaxAmount = 0
			Invert = true
		}
		BlueprintNetworkNode
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}
		Port_Up
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ rafaeltessaro.bs2t_esteira ]
			RouteSource = NoEsteira
			RouteEndpoint = NoEsteira
			BlueprintRouteSource = BlueprintNetworkNode
			BlueprintRouteEndpoint = BlueprintNetworkNode
			Overlay
			{
				OverlayIcon = "ThermalPort"
				IconDrawMode = Never
				RouteDrawMode = Connected
				RouteLine = "Thermal"
				DrawRouteHub = false
			}
		}
		Port_Right : Port_Up { Direction = Right }
		Port_Down : Port_Up { Direction = Down }
		Port_Left : Port_Up { Direction = Left }

		FloorBlendSprites : <bs2t_esteira_blend.rules>/FloorBlendSprites {}
		RoofBlendSprites : <bs2t_esteira_blend.rules>/RoofBlendSprites {}
		BlueprintBlendSprites : <bs2t_esteira_blend.rules>/BlueprintBlendSprites {}

		// cartuchos andando: camada doodads_high (embaixo do teto, visivel pelo canal aberto do teto)
		Cartuchos_U
		{
			// meia esteira do centro ate esta borda; aparece se a porta estiver ligada e anda quando a rede tem atividade
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = Port_Up
			AnimationToggle = Andando
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"carts_U1.png"
							"carts_U2.png"
							"carts_U3.png"
							"carts_U4.png"
							"carts_U5.png"
							"carts_U6.png"
							"carts_U7.png"
							"carts_U8.png"
						]
						Size = [1, 1]
						AnimationInterval = .0333
						AnimationStartTime = Zero
					}
				]
			}
		}
		Cartuchos_R
		{
			// meia esteira do centro ate esta borda; aparece se a porta estiver ligada e anda quando a rede tem atividade
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = Port_Right
			AnimationToggle = Andando
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"carts_R1.png"
							"carts_R2.png"
							"carts_R3.png"
							"carts_R4.png"
							"carts_R5.png"
							"carts_R6.png"
							"carts_R7.png"
							"carts_R8.png"
						]
						Size = [1, 1]
						AnimationInterval = .0333
						AnimationStartTime = Zero
					}
				]
			}
		}
		Cartuchos_D
		{
			// meia esteira do centro ate esta borda; aparece se a porta estiver ligada e anda quando a rede tem atividade
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = Port_Down
			AnimationToggle = Andando
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"carts_D1.png"
							"carts_D2.png"
							"carts_D3.png"
							"carts_D4.png"
							"carts_D5.png"
							"carts_D6.png"
							"carts_D7.png"
							"carts_D8.png"
						]
						Size = [1, 1]
						AnimationInterval = .0333
						AnimationStartTime = Zero
					}
				]
			}
		}
		Cartuchos_L
		{
			// meia esteira do centro ate esta borda; aparece se a porta estiver ligada e anda quando a rede tem atividade
			Type = Graphics
			Location = [0.5, 0.5]
			OperationalToggle = Port_Left
			AnimationToggle = Andando
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"carts_L1.png"
							"carts_L2.png"
							"carts_L3.png"
							"carts_L4.png"
							"carts_L5.png"
							"carts_L6.png"
							"carts_L7.png"
							"carts_L8.png"
						]
						Size = [1, 1]
						AnimationInterval = .0333
						AnimationStartTime = Zero
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 0.5]
		}
	}
}
