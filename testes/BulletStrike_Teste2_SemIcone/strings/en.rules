// Strings of the Bullet Strike 2.0 test mod (English). Do not put __Name / __DebugOnly in mod files.

BS2TTag = "\n<s16><gray>Mod: [TESTE] Bullet Strike 2.0</gray></s16>"
EditorGroups
{
	BS2Teste = "BS Test 2.0"
}
Parts
{
	BS2TFabBala = "[TESTE] Test factory - Cannon Ammo"
	BS2TFabBalaIcon = "[TESTE] Test fab. ammo"
	BS2TFabBalaDesc = "Makes cannon ammo from nothing (test only): 10 every 1 s.\n\nFirst it sends it over the belt to depots set to Cannon Ammo. If no depot takes it (full or missing), the rest stays in the output grid and crew haul it, like a normal factory. On/off button to pause.<string id='BS2TTag'/>"
	BS2TFabHE = "[TESTE] Test factory - HE Missile Part"
	BS2TFabHEIcon = "[TESTE] Test fab. HE"
	BS2TFabHEDesc = "Makes HE missile parts from nothing (test only): 4 every 1 s.\n\nFirst it sends them over the belt to depots set to HE Missile Part; the rest stays in the output grid for crew.<string id='BS2TTag'/>"
	BS2TControleFonte = "[TESTE] Control - Heat source"
	BS2TControleFonteIcon = "[TESTE] Heat source"
	BS2TControleFonteDesc = "CONTROL part for the belt test. Makes heat from nothing (10 per second) and sends it over the belt, the same way the Test factory sends ammo. Heat is a resource the game already moves over networks. The orange light stays on while it sends.\n\nIf the Heat tank fills and the Simple depot does not, the belt works and the problem is the ammo. If neither fills, the problem is the belt. Does not connect to the game's heat pipes.<string id='BS2TTag'/>"
	BS2TControleTanque = "[TESTE] Control - Heat tank"
	BS2TControleTanqueIcon = "[TESTE] Heat tank"
	BS2TControleTanqueDesc = "CONTROL part for the belt test: stores 200 heat coming from the belt. Built the same as the Simple depot, only the resource differs. Green bar = full. Does not connect to the game's heat pipes.\n\nStock button (test): normal / +1 per second / fast fill / fast empty.<string id='BS2TTag'/>"
	BS2TPaiolSimples = "[TESTE] Simple depot 1x1 (ammo only)"
	BS2TPaiolSimplesIcon = "[TESTE] Simple depot"
	BS2TPaiolSimplesDesc = "SEALED depot (crew cannot enter) for 200 cannon ammo, no type selector and no own explosion. It is the part for the main test: factory -> belt -> depot -> belt -> gun, with no crew.\n\nStock button (test): normal / +1 per second / fast fill / fast empty.<string id='BS2TTag'/>"
	BS2TPaiol1x1 = "[TESTE] Depot 1x1"
	BS2TPaiol1x1Icon = "[TESTE] Depot 1x1"
	BS2TPaiol1x1Desc = "SEALED depot with a type selector: 400 cannon ammo OR 100 HE missile parts. Switching the type while full sends the old type over the belt to ANOTHER depot of that type (nothing is converted). Explodes when destroyed, scaled by how full it is. Type switch uses MECHANISM A.\n\nTest buttons: stock (normal / +1 per s / fill / empty) and Detonate.<string id='BS2TTag'/>"
	BS2TPaiol1x1B = "[TEST] Depot 1x1 B (mechanism B)"
	BS2TPaiol1x1BIcon = "[TEST] Depot 1x1 B"
	BS2TPaiol1x1BDesc = "Same as the Depot 1x1 (400 cannon ammo OR 100 HE missile parts, no counter), but the type switch uses MECHANISM B, the same as the Depot 3x3. Blue stripes on the roof. Used to compare both mechanisms in the selector test without depending on the counter.\n\nTest buttons: stock (normal / +1 per s / fill / empty) and Detonate.<string id='BS2TTag'/>"
	BS2TPaiol2x2 = "[TESTE] Depot 2x2 (with counter)"
	BS2TPaiol2x2Icon = "[TESTE] Depot 2x2"
	BS2TPaiol2x2Desc = "SEALED depot with a type selector: 1839 cannon ammo OR 459 HE missile parts. Shows the fill bar, the roof gauge and a 4-digit COUNTER (how much of the selected type is stored). Explodes when destroyed, scaled by how full it is.\n\nTest buttons: stock (normal / +1 per s / fill / empty) and Detonate.<string id='BS2TTag'/>"
	BS2TPaiol3x3 = "[TESTE] Depot 3x3 (with counter)"
	BS2TPaiol3x3Icon = "[TESTE] Depot 3x3"
	BS2TPaiol3x3Desc = "SEALED depot with a type selector: 4680 cannon ammo OR 1170 HE missile parts, with bar, gauge and 4-digit counter. Explodes when destroyed, scaled by how full it is.\n\nType switch uses MECHANISM B (same as the Depot 1x1 B; the 1x1 and 2x2 use mechanism A).\n\nTest buttons: stock and Detonate.<string id='BS2TTag'/>"
	BS2TPaiolExplosao = "[TESTE] Explosion depot 2x2"
	BS2TPaiolExplosaoIcon = "[TESTE] Explosion depot"
	BS2TPaiolExplosaoDesc = "2x2 depot for 1839 cannon ammo with NO own explosion that does NOT drop its ammo when destroyed (has a counter). Only used to see whether the ammo itself explodes harder the more is stored: fill it (stock button) and press Detonate, away from the main ship.<string id='BS2TTag'/>"
	BS2TPaiolExplosaoSolta = "[TESTE] Explosion depot 2x2 (drops ammo)"
	BS2TPaiolExplosaoSoltaIcon = "[TESTE] Explosion depot (drops)"
	BS2TPaiolExplosaoSoltaDesc = "Same as the Explosion depot, but it DROPS its ammo when destroyed, as the game's weapons do with their ammo. No counter (red stripes on the roof). Compare both to see whether ammo only explodes when it is dropped.<string id='BS2TTag'/>"
	BS2TEsteira = "[TESTE] Ammo belt"
	BS2TEsteiraIcon = "[TESTE] Belt"
	BS2TEsteiraDesc = "Sealed tile that carries ammo between factories, hoppers, depots and weapons, with no crew. Connects by itself to neighbours and other belt tiles. The rounds move while some depot on this belt is filling or emptying.\n\nOwn port type: heat pipes and radiators do NOT connect to it.<string id='BS2TTag'/>"
	BS2TEsteiraCorredor = "[TESTE] Belt corridor"
	BS2TEsteiraCorredorIcon = "[TESTE] Belt corridor"
	BS2TEsteiraCorredorDesc = "A normal corridor crew walk on, with the belt running under the floor grating (seen with roofs hidden). Connects to the sealed belt and to neighbouring parts like it.<string id='BS2TTag'/>"
	BS2TTremonha = "[TESTE] Hopper"
	BS2TTremonhaIcon = "[TESTE] Hopper"
	BS2TTremonhaDesc = "1x1 room where crew drop ammo brought from cargo or a factory grid. Each unit goes onto the belt and then into depots of the selected type. If no depot has room, it fills up and crew stop bringing more.<string id='BS2TTag'/>"
	BS2TArma = "[TESTE] Test gun"
	BS2TArmaIcon = "[TESTE] Test gun"
	BS2TArmaDesc = "Stands in for a weapon: eats 4 units per second of the selected type while the on/off button is on (= firing). Draws from the belt (green light); crew only resupply below half the internal stock. Two bars, one per type, to prove nothing is converted.<string id='BS2TTag'/>"
	BS2TRailCarregador = "[TESTE] Tupa - Loader (railgun)"
	BS2TRailCarregadorIcon = "[TESTE] Tupa loader"
	BS2TRailCarregadorDesc = "Breech of the test railgun, 2 crew. It is the ONLY entry for ammo (cannon ammo, 6 per shot, by crew or by belt) and for power (6000 battery) of the whole gun.\n\nBattery button (test): normal (crew recharge) / fill now / locked (nobody recharges; use it to count the cost per shot).\n\nBuild: Loader at the back, 1 to 6 Barrels in the middle and the Muzzle in front, all facing the same way.<string id='BS2TTag'/>"
	BS2TRailCarregadorSC = "[TESTE] Tupa - Loader without counter (fallback)"
	BS2TRailCarregadorSCIcon = "[TESTE] Tupa loader no counter"
	BS2TRailCarregadorSCDesc = "Same as the Tupa Loader, but without the 4-digit battery counter. Use it only if the counter crashes the game: then fill the battery (Battery button: fill now), lock it (Battery: locked) and count the shots until the Muzzle stops.<string id='BS2TTag'/>"
	BS2TRailCano = "[TESTE] Tupa - Barrel A (railgun)"
	BS2TRailCanoIcon = "[TESTE] Tupa barrel A"
	BS2TRailCanoDesc = "Sealed armoured barrel segment, 1 to 6 between loader and muzzle. Each barrel raises damage, speed, penetration and range and adds 0.25 s of charge.\n\nVariant A: each barrel takes 500 power per shot straight from the loader battery (this is what the test checks).<string id='BS2TTag'/>"
	BS2TRailCanoB = "[TESTE] Tupa - Barrel B (railgun, fallback)"
	BS2TRailCanoBIcon = "[TESTE] Tupa barrel B"
	BS2TRailCanoBDesc = "Same as Barrel A, but the extra power (500 per barrel per shot) is charged by the loader. Blue stripe on the roof. Use only B barrels on one gun to compare with variant A.<string id='BS2TTag'/>"
	BS2TRailPonta = "[TESTE] Tupa - Muzzle (railgun)"
	BS2TRailPontaIcon = "[TESTE] Tupa muzzle"
	BS2TRailPontaDesc = "Muzzle of the test railgun: fires every 6 s. On firing it charges 1.0 s + 0.25 s per barrel (the glow runs from breech to muzzle), the slug runs down the barrel and leaves. Uses 2000 power per shot plus 500 per barrel.\n\nIt only takes the Tupa's own buffs: vanilla railgun accelerators do NOT boost it.<string id='BS2TTag'/>"
}
PartToggles
{
	BS2TTipoBala = "Cannon Ammo"
	BS2TTipoHE = "HE Missile Part"
	BS2TEstoqueNormal = "Stock: normal"
	BS2TEstoqueMais1 = "Stock (test): +1 per second"
	BS2TEstoqueEncher = "Stock (test): fast fill"
	BS2TEstoqueEsvaziar = "Stock (test): fast empty"
	BS2TBateriaNormal = "Battery: normal (crew recharge)"
	BS2TBateriaEncher = "Battery (test): fill now, no crew"
	BS2TBateriaTravada = "Battery (test): locked, nobody recharges"
}
