// Textos do mod de testes do Bullet Strike 2.0 (pt-BR). Nao coloque __Name / __DebugOnly em arquivos de mod.

BS2TTag = "\n<s16><gray>Mod: [TESTE] Bullet Strike 2.0</gray></s16>"
EditorGroups
{
	BS2Teste = "BS Teste 2.0"
}
Parts
{
	BS2TFabBala = "[TESTE] Fábrica de teste - Munição"
	BS2TFabBalaIcon = "[TESTE] Fáb. munição"
	BS2TFabBalaDesc = "Cria munição de canhão do nada (só para testes): 10 a cada 1 s.\n\nPrimeiro manda pela esteira para os paióis que estiverem com Munição selecionada. Se nenhum paiol aceitar (cheio ou ausente), a sobra fica na grade de saída e a tripulação carrega, como numa fábrica normal. Botão liga/desliga para pausar.<string id='BS2TTag'/>"
	BS2TFabHE = "[TESTE] Fábrica de teste - Peça de míssil A.E."
	BS2TFabHEIcon = "[TESTE] Fáb. míssil A.E."
	BS2TFabHEDesc = "Cria peças de míssil A.E. do nada (só para testes): 4 a cada 1 s.\n\nPrimeiro manda pela esteira para os paióis com Peça de míssil A.E. selecionada; a sobra fica na grade de saída para a tripulação.<string id='BS2TTag'/>"
	BS2TControleFonte = "[TESTE] Controle - Fonte de calor"
	BS2TControleFonteIcon = "[TESTE] Fonte de calor"
	BS2TControleFonteDesc = "Peça de CONTROLE do teste da esteira. Cria calor do nada (10 por segundo) e manda pela esteira, do mesmo jeito que a Fábrica de teste manda munição. O calor é um recurso que o jogo já move por rede. A luz laranja fica acesa enquanto ela manda.\n\nSe o Tanque de calor encher e o Paiol simples não, a esteira funciona e o problema é a munição. Se nenhum dos dois encher, o problema é a esteira. Não se liga nos canos de calor do jogo.<string id='BS2TTag'/>"
	BS2TControleTanque = "[TESTE] Controle - Tanque de calor"
	BS2TControleTanqueIcon = "[TESTE] Tanque de calor"
	BS2TControleTanqueDesc = "Peça de CONTROLE do teste da esteira: guarda 200 de calor vindo da esteira. É montado igual ao Paiol simples, só muda o recurso. Barra verde = cheio. Não se liga nos canos de calor do jogo.\n\nBotão de estoque (teste): normal / +1 por segundo / encher rápido / esvaziar rápido.<string id='BS2TTag'/>"
	BS2TPaiolSimples = "[TESTE] Paiol simples 1x1 (só munição)"
	BS2TPaiolSimplesIcon = "[TESTE] Paiol simples"
	BS2TPaiolSimplesDesc = "Paiol FECHADO (a tripulação não entra) para 200 munições de canhão, sem seletor de tipo e sem explosão própria. É a peça do teste principal: fábrica -> esteira -> paiol -> esteira -> arma, sem tripulação.\n\nBotão de estoque (teste): normal / +1 por segundo / encher rápido / esvaziar rápido.<string id='BS2TTag'/>"
	BS2TPaiol1x1 = "[TESTE] Paiol 1x1"
	BS2TPaiol1x1Icon = "[TESTE] Paiol 1x1"
	BS2TPaiol1x1Desc = "Paiol FECHADO com seletor de tipo: 400 munições de canhão OU 100 peças de míssil A.E. Ao trocar o tipo com ele cheio, o tipo antigo sai pela esteira para OUTRO paiol daquele tipo (nada é convertido). Explode ao ser destruído, proporcional ao quanto está cheio. Troca de tipo pelo MECANISMO A.\n\nBotões de teste: estoque (normal / +1 por s / encher / esvaziar) e Detonar.<string id='BS2TTag'/>"
	BS2TPaiol1x1B = "[TESTE] Paiol 1x1 B (mecanismo B)"
	BS2TPaiol1x1BIcon = "[TESTE] Paiol 1x1 B"
	BS2TPaiol1x1BDesc = "Igual ao Paiol 1x1 (400 munições de canhão OU 100 peças de míssil A.E., sem contador), mas a troca de tipo usa o MECANISMO B, o mesmo do Paiol 3x3. Faixas azuis no teto. Serve para comparar os dois mecanismos no teste do seletor sem depender do contador.\n\nBotões de teste: estoque (normal / +1 por s / encher / esvaziar) e Detonar.<string id='BS2TTag'/>"
	BS2TPaiol2x2 = "[TESTE] Paiol 2x2 (com contador)"
	BS2TPaiol2x2Icon = "[TESTE] Paiol 2x2"
	BS2TPaiol2x2Desc = "Paiol FECHADO com seletor de tipo: 1839 munições de canhão OU 459 peças de míssil A.E. Mostra a barra de enchimento, o medidor no teto e um CONTADOR de 4 dígitos (quanto há do tipo selecionado). Explode ao ser destruído, proporcional ao quanto está cheio.\n\nBotões de teste: estoque (normal / +1 por s / encher / esvaziar) e Detonar.<string id='BS2TTag'/>"
	BS2TPaiol3x3 = "[TESTE] Paiol 3x3 (com contador)"
	BS2TPaiol3x3Icon = "[TESTE] Paiol 3x3"
	BS2TPaiol3x3Desc = "Paiol FECHADO com seletor de tipo: 4680 munições de canhão OU 1170 peças de míssil A.E., com barra, medidor e contador de 4 dígitos. Explode ao ser destruído, proporcional ao quanto está cheio.\n\nTroca de tipo pelo MECANISMO B (o mesmo do Paiol 1x1 B; o 1x1 e o 2x2 usam o mecanismo A).\n\nBotões de teste: estoque e Detonar.<string id='BS2TTag'/>"
	BS2TPaiolExplosao = "[TESTE] Paiol de explosão 2x2"
	BS2TPaiolExplosaoIcon = "[TESTE] Paiol explosão"
	BS2TPaiolExplosaoDesc = "Paiol 2x2 para 1839 munições de canhão SEM explosão própria e que NÃO solta a munição quando é destruído (tem contador). Serve só para ver se a própria munição explode mais quanto mais estoque houver: encha (botão de estoque) e aperte Detonar, longe da nave principal.<string id='BS2TTag'/>"
	BS2TPaiolExplosaoSolta = "[TESTE] Paiol de explosão 2x2 (solta a munição)"
	BS2TPaiolExplosaoSoltaIcon = "[TESTE] Paiol explosão (solta)"
	BS2TPaiolExplosaoSoltaDesc = "Igual ao Paiol de explosão, mas SOLTA a munição quando é destruído, como as armas do jogo fazem com a munição delas. Não tem contador (faixas vermelhas no teto). Compare os dois para ver se a munição só explode quando é solta.<string id='BS2TTag'/>"
	BS2TEsteira = "[TESTE] Esteira de munição"
	BS2TEsteiraIcon = "[TESTE] Esteira"
	BS2TEsteiraDesc = "Bloco fechado que leva munição entre fábricas, tremonhas, paióis e armas, sem tripulação. Liga sozinha nos vizinhos e nos outros blocos de esteira. Os cartuchos andam quando algum paiol desta esteira está enchendo ou esvaziando.\n\nTem porta própria: canos de calor e radiadores NÃO se ligam nela.<string id='BS2TTag'/>"
	BS2TEsteiraCorredor = "[TESTE] Corredor com esteira"
	BS2TEsteiraCorredorIcon = "[TESTE] Corredor esteira"
	BS2TEsteiraCorredorDesc = "Corredor normal por onde a tripulação anda, com a esteira passando por baixo da grade do piso (vista com o teto escondido). Liga na esteira fechada e nas peças vizinhas como ela.<string id='BS2TTag'/>"
	BS2TTremonha = "[TESTE] Tremonha"
	BS2TTremonhaIcon = "[TESTE] Tremonha"
	BS2TTremonhaDesc = "Sala 1x1 onde a tripulação despeja munição trazida de uma baia de armazenamento ou da grade de uma fábrica. Cada unidade vai para a esteira e daí para os paióis do tipo selecionado. Se nenhum paiol tiver espaço, ela enche e a tripulação para de trazer.<string id='BS2TTag'/>"
	BS2TArma = "[TESTE] Arma de teste"
	BS2TArmaIcon = "[TESTE] Arma de teste"
	BS2TArmaDesc = "Imita uma arma: gasta 4 unidades por segundo do tipo selecionado com o botão liga/desliga ligado (= atirando). Puxa da esteira (luz verde) e a tripulação só abastece abaixo da metade do estoque interno. Duas barras, uma por tipo, para provar que nada é convertido.<string id='BS2TTag'/>"
	BS2TRailCarregador = "[TESTE] Tupã - Carregador (railgun)"
	BS2TRailCarregadorIcon = "[TESTE] Tupã carregador"
	BS2TRailCarregadorDesc = "Culatra do railgun de teste, com 2 tripulantes. É a ÚNICA entrada de munição (munição de canhão, 6 por tiro, pela tripulação ou pela esteira) e de energia (bateria de 6000) do canhão inteiro.\n\nBotão Bateria (teste): normal (a tripulação recarrega) / encher já / travada (ninguém recarrega; use para contar o gasto por tiro).\n\nMonte: Carregador atrás, de 1 a 6 Canos no meio e a Ponta na frente, todos virados para o mesmo lado.<string id='BS2TTag'/>"
	BS2TRailCarregadorSC = "[TESTE] Tupã - Carregador sem contador (reserva)"
	BS2TRailCarregadorSCIcon = "[TESTE] Tupã carregador s/ contador"
	BS2TRailCarregadorSCDesc = "Igual ao Carregador do Tupã, mas sem o contador de 4 dígitos da bateria. Use só se o jogo travar por causa do contador: aí encha a bateria (botão Bateria: encher já), trave (Bateria: travada) e conte os tiros até a Ponta parar.<string id='BS2TTag'/>"
	BS2TRailCano = "[TESTE] Tupã - Cano A (railgun)"
	BS2TRailCanoIcon = "[TESTE] Tupã cano A"
	BS2TRailCanoDesc = "Segmento de cano blindado e fechado, de 1 a 6 entre o carregador e a ponta. Cada cano aumenta dano, velocidade, penetração e alcance e acrescenta 0,25 s de carga.\n\nVariante A: cada cano tira 500 de energia por tiro direto da bateria do carregador (é isto que o teste confere).<string id='BS2TTag'/>"
	BS2TRailCanoB = "[TESTE] Tupã - Cano B (railgun, reserva)"
	BS2TRailCanoBIcon = "[TESTE] Tupã cano B"
	BS2TRailCanoBDesc = "Igual ao Cano A, mas a energia extra (500 por cano por tiro) é cobrada pelo carregador. Faixa azul no teto. Use só canos B num canhão para comparar com a variante A.<string id='BS2TTag'/>"
	BS2TRailPonta = "[TESTE] Tupã - Ponta (railgun)"
	BS2TRailPontaIcon = "[TESTE] Tupã ponta"
	BS2TRailPontaDesc = "Boca do railgun de teste: dispara a cada 6 s. Ao disparar, carrega 1,0 s + 0,25 s por cano (o brilho corre da culatra até a boca), o projétil corre pelo cano e sai. Gasta 2000 de energia por tiro, mais 500 por cano.\n\nSó recebe os buffs próprios do Tupã: aceleradores de railgun do jogo base NÃO a reforçam.<string id='BS2TTag'/>"
}
PartToggles
{
	BS2TTipoBala = "Munição de canhão"
	BS2TTipoHE = "Peça de míssil A.E."
	BS2TEstoqueNormal = "Estoque: normal"
	BS2TEstoqueMais1 = "Estoque (teste): +1 por segundo"
	BS2TEstoqueEncher = "Estoque (teste): encher rápido"
	BS2TEstoqueEsvaziar = "Estoque (teste): esvaziar rápido"
	BS2TBateriaNormal = "Bateria: normal (a tripulação recarrega)"
	BS2TBateriaEncher = "Bateria (teste): encher já, sem tripulação"
	BS2TBateriaTravada = "Bateria (teste): travada, ninguém recarrega"
}
