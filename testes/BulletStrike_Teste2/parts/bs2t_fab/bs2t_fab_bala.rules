// =====================================================================================================
//  [TESTE] Fabrica de teste 2x2 (com tripulacao circulando) que CRIA bullet do nada (so para testes) e entrega:
//   1) pela esteira, direto para qualquer paiol ligado com esse tipo selecionado e com espaco;
//   2) se nenhum paiol aceitar (cheio ou ausente), na grade de saida, onde a tripulacao recolhe como numa
//      fabrica vanilla (factory_ammo.rules:116-127, SuppliesResources = true).
//  Mecanismo = roteamento de calor vanilla: MultiResourceStorage [entrada da rede, sobra] com AddMode = InOrder
//  (V base_part_overclock.rules:165-187; o mesmo codigo roda no SW:ACD 0.30.4: base_part_terran_sw_overclock.rules:171-192).
// =====================================================================================================

FABRICA
{
	POR_CICLO = 10
	INTERVALO = 1
}

Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/BS2TFabBala"
	IconNameKey = "Parts/BS2TFabBalaIcon"
	DescriptionKey = "Parts/BS2TFabBalaDesc"
	ID = rafaeltessaro.bs2t_fab_bala
	EditorGroups = ["BS2Teste"]
	Resources
	[
		[steel, 20]
	]
	Size = [2, 2]
	SelectionPriority = 1
	MaxHealth = 4000
	TypeCategories = [provides_ammo]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	EditorIcon
	{
		Texture
		{
			File = "bala/icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		// 1) lado da esteira: empurra so para depositos de paiol (filtro por categoria, AllowUncategorized desligado)
		EntradaRede
		{
			Type = NetworkResourceInput
			ResourceType = bullet
			Mode = DistributeProportionallyByAvailable
			Categories = [ rafaeltessaro.bs2t_paiol ]
			AllowUncategorized = false
		}
		// 2) lado da tripulacao: grade de saida como a da fabrica vanilla
		GradeSaida
		{
			Type = TypedResourceGrid
			ResourceType = bullet
			GridRect = [1, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}
		// primeiro a rede, depois a sobra (InOrder)
		RoteadorSaida
		{
			Type = MultiResourceStorage
			ResourceType = bullet
			ResourceStorages = [EntradaRede, GradeSaida]
			AddMode = InOrder
			RemoveMode = InReverseOrder
		}
		Produtor
		{
			Type = ResourceConverter
			OperationalToggle = PowerToggle
			ToStorage = RoteadorSaida
			ToQuantity = &~/FABRICA/POR_CICLO
			MinToQuantityForConversion = &~/FABRICA/POR_CICLO
			Interval = &~/FABRICA/INTERVALO
		}
		// o que sobrou na grade volta para a esteira assim que algum paiol tiver espaco
		Retorno
		{
			Type = ResourceConverter
			OperationalToggle = PowerToggle
			FromStorage = GradeSaida
			FromQuantity = 1
			ToStorage = EntradaRede
			ToQuantity = 1
			Interval = 0.1
		}
		BlueprintNetworkNode
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}
		PortaEsteira_Up_0_0
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ rafaeltessaro.bs2t_esteira ]
			RouteSource = EntradaRede
			RouteEndpoint = EntradaRede
			BlueprintRouteSource = BlueprintNetworkNode
			BlueprintRouteEndpoint = BlueprintNetworkNode
			Overlay
			{
				OverlayIcon = "BS2TPortaEsteira"
				RouteLine = "BS2TEsteira"
				DrawRouteHub = false
			}
		}
		PortaEsteira_Up_1_0 : PortaEsteira_Up_0_0 { Location = [1, 0]; Direction = Up }
		PortaEsteira_Right_1_0 : PortaEsteira_Up_0_0 { Location = [1, 0]; Direction = Right }
		PortaEsteira_Right_1_1 : PortaEsteira_Up_0_0 { Location = [1, 1]; Direction = Right }
		PortaEsteira_Down_0_1 : PortaEsteira_Up_0_0 { Location = [0, 1]; Direction = Down }
		PortaEsteira_Down_1_1 : PortaEsteira_Up_0_0 { Location = [1, 1]; Direction = Down }
		PortaEsteira_Left_0_0 : PortaEsteira_Up_0_0 { Location = [0, 0]; Direction = Left }
		PortaEsteira_Left_0_1 : PortaEsteira_Up_0_0 { Location = [0, 1]; Direction = Left }

		// (sem barra de progresso na grade: nenhum vanilla/SW usa ProgressBar num TypedResourceGrid; a grade ja mostra as pilhas)
		// luz "produzindo" (Timer usado como interruptor, V chaingun.rules:197-207)
		ProduziuRecente
		{
			Type = Timer
			Duration = 1.5
			StartTrigger = Produtor
			ResetTrigger = Produtor
			StartExpired = true
			InvertToggle = true
		}
		Luz
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = ProduziuRecente
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{ File = "bala/lamp.png"; Size = [2, 2] }
				]
			}
		}
		Graficos
		{
			Type = Graphics
			Location = [1, 1]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{ File = "bala/floor.png"; Size = [2, 2] }
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{ File = "bala/walls.png"; Size = [2, 2] }
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{ File = "bala/roof.png"; NormalsFile = "bala/roof_normals.png"; Size = [2, 2] }
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "bala/blueprints.png"
			Size = [2, 2]
		}
		Indicadores
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
				}
			]
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1, 1]
		}
	}
}
