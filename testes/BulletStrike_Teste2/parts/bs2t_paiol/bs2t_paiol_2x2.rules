			Type = ResourceConverter
			OperationalToggle = EncherLigado0
			ToStorage = Estoque0
			ToQuantity = &~/PAIOL/ENCHER_QTD
			MinToQuantityForConversion = 1
			Interval = 0.1
		}
		TesteEsvaziar0
		{
			Type = ResourceConverter
			OperationalToggle = EsvaziarLigado0
			FromStorage = Estoque0
			FromQuantity = &~/PAIOL/ENCHER_QTD
			MinFromQuantityForConversion = 1
			Interval = 0.1
		}
		Mais1Ligado1 { Type = MultiToggle; Toggles = [EhTipo1, ModoMais1]; Mode = All }
		EncherLigado1 { Type = MultiToggle; Toggles = [EhTipo1, ModoEncher]; Mode = All }
		EsvaziarLigado1 { Type = MultiToggle; Toggles = [EhTipo1, ModoEsvaziar]; Mode = All }
		TesteMais1_1
		{
			Type = ResourceConverter
			OperationalToggle = Mais1Ligado1
			ToStorage = Estoque1
			ToQuantity = 1
			Interval = 1
		}
		TesteEncher1
		{
			Type = ResourceConverter
			OperationalToggle = EncherLigado1
			ToStorage = Estoque1
			ToQuantity = &~/PAIOL/ENCHER_QTD
			MinToQuantityForConversion = 1
			Interval = 0.1
		}
		TesteEsvaziar1
		{
			Type = ResourceConverter
			OperationalToggle = EsvaziarLigado1
			FromStorage = Estoque1
			FromQuantity = &~/PAIOL/ENCHER_QTD
			MinFromQuantityForConversion = 1
			Interval = 0.1
		}
		// botao vanilla "Detonar" (mesmo da carga explosiva): destroi o paiol e dispara as DeathEffects
		// RequiresCommand = false: o padrao e true (PartUITriggerRules, manifesto 0.30.4c) e a nave-bomba do teste
		// de explosao nao tem ponte; sem isto o botao fica cinza. Campo bool, igual aos UIToggle vanilla.
		Detonar
		{
			Type = UITrigger
			TriggerID = "detonate"
			RequiresCommand = false
		}
		DetonarEfeito
		{
			Type = TriggeredEffects
			Trigger = Detonar
			Location = [0.5, 0.5]
			HitEffects
			[
				{
					Type = Damage
					Damage = 999999
					Filter
					{
						Friendlies = true
						IgnoreInvulnerability = true
					}
				}
			]
		}

