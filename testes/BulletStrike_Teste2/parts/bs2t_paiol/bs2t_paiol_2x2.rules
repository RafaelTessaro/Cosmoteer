// =====================================================================================================
//  [TESTE] Paiol 2x2 (seletor de tipo, contador) - Bullet Strike 2.0 (mod de testes). NAO e conteudo final.
//  Fechado (sem tripulacao), so a esteira enche e esvazia. Recursos do jogo: bullet (municao de canhao) e missile_part_he (peca de missil A.E.).
//  Evidencias (V = dados vanilla, AW = wiki do codigo 0.30.4c, H = exemplo coolant rodado no motor 0.30.4c):
//   * peca fechada .................. V thermal_battery.rules:23-25
//   * deposito na rede .............. V thermal_battery.rules:86-92; H coolant_tank.rules (deposito = no da porta)
//   * deposito por tipo em bloco ligado/desligado .. V missile_launcher_thermal.rules:225-254
//   * empurrar para a rede .......... V base_part_overclock.rules:165-171; H coolant_pump.rules
//   * barra / medidor ............... V base_part_overclock.rules:132-142, thermal_battery.rules:131-175
//   * contador de 4 digitos ......... campo Modulus das sprites de valor (vanilla 0.30.3 factory_emp.rules:337-343
//                                     usa ResourceSprites com Modulus = 20); SEM o operador Modulo (enum nao comprovado)
//   * botao detonar ................. V explosive_charge.rules:35-60 (UITrigger "detonate" + dano 999999)
//   * conversor sem origem / destino . V reactor_small.rules (cria), radiator.rules / H heat_sink (destroi)
// =====================================================================================================
PAIOL
{
	CAP_0 = 1839		// Int32: so inteiros
	CAP_1 = 459		// Int32: so inteiros
	EXPULSAR_QTD = 10		// tipo desmarcado sai a 10 por 0,1 s = 100 unidades/s
	ENCHER_QTD = 100		// botao de teste: +100 a cada 0,1 s
	EXPLOSAO_OP = 240000	// dano operacional do paiol CHEIO (Int; escala com o enchimento)
	EXPLOSAO_ESTR = 60000	// dano estrutural do paiol CHEIO (Int)
	RAIO_OP = 4
	RAIO_ESTR = 3
}

Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/BS2TPaiol2x2"
	IconNameKey = "Parts/BS2TPaiol2x2Icon"
	DescriptionKey = "Parts/BS2TPaiol2x2Desc"
	ID = rafaeltessaro.bs2t_paiol_2x2
	EditorGroups = ["BS2Teste"]
	Resources
	[
		[steel, 32]
	]
	Size = [2, 2]
	IsRotateable = false
	IsFlippable = false
	SelectionPriority = 0
	MaxHealth = 10000
	TypeCategories = [bs2t_paiol]
	ReceivableBuffs : ^/0/ReceivableBuffs []
	// fechado: sem interior, sem portas, a tripulacao nao entra (V thermal_battery.rules:22-25)
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	CrewSpeedFactor = 0
	EditorIcon
	{
		Texture
		{
			File = "icon_2x2.png"
			SampleMode = Linear
		}
		Size = [48, 48]
	}
	Components : ^/0/Components
	{
		// ------------------------------------------------------------ seletor do tipo de municao
		TipoMunicao
		{
			Type = UIToggle
			ToggleID = "bs2t_tipo"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		EhTipo0 { Type = ModeToggle; Mode = TipoMunicao; OnMode = 0 }
		EhTipo1 { Type = ModeToggle; Mode = TipoMunicao; OnMode = 1 }
		NaoTipo0 { Type = ModeToggle; Mode = TipoMunicao; OnModes = [1] }
		NaoTipo1 { Type = ModeToggle; Mode = TipoMunicao; OnModes = [0] }

		// ------------------------------------------------------------ um deposito por tipo (guardado ao trocar de tipo)
		Estoque0
		{
			Type = ResourceStorage
			ResourceType = bullet
			MaxResources = &~/PAIOL/CAP_0
			DropResourcesWhenDestroyed = false
		}
		Estoque1
		{
			Type = ResourceStorage
			ResourceType = missile_part_he
			MaxResources = &~/PAIOL/CAP_1
			DropResourcesWhenDestroyed = false
		}

		// ------------------------------------------------------------ rede
		NoEsteira
		{
			// no de roteamento da esteira = receptor do sinal "esteira andando" (padrao do cano de calor vanilla
			// e do medidor do exemplo coolant, rodado no motor 0.30.4c)
			Type = NetworkValueReceiver
			Mode = Max
			Categories = [ rafaeltessaro.bs2t_atividade ]
			AllowUncategorized = false
		}
		BlueprintNetworkNode
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}
		// MECANISMO A do seletor: so o tipo SELECIONADO fica visivel na rede (deposito + roteador dentro de um bloco
		// ligado/desligado, como o lancador termico vanilla troca seus nos de rede). [INFERIDO] o roteador de dentro do
		// bloco cita NoEsteira, que fica fora (sempre existe, entao nao ha referencia quebrada).
		BlocoDeposito0
		{
			Type = ToggledComponents
			Toggle = EhTipo0
			Components
			{
				Deposito0
				{
					Type = NetworkResourceStore
					ResourceType = bullet
					ResourceStorage = Estoque0
					Categories = [ rafaeltessaro.bs2t_paiol ]
				}
				RoteadorDeposito0
				{
					Type = NetworkRouter
					RouteGenerators
					[
						{
							Type = Bidirectional
							Routes
							[
								[NoEsteira, Deposito0, 0]
							]
						}
					]
				}
			}
		}
		BlocoDeposito1
		{
			Type = ToggledComponents
			Toggle = EhTipo1
			Components
			{
				Deposito1
				{
					Type = NetworkResourceStore
					ResourceType = missile_part_he
					ResourceStorage = Estoque1
					Categories = [ rafaeltessaro.bs2t_paiol ]
				}
				RoteadorDeposito1
				{
					Type = NetworkRouter
					RouteGenerators
					[
						{
							Type = Bidirectional
							Routes
							[
								[NoEsteira, Deposito1, 0]
							]
						}
					]
				}
			}
		}
		// expulsao: o tipo desmarcado volta para a esteira, para OUTRO paiol que tenha esse tipo selecionado
		// (o deposito deste tipo aqui esta desligado, entao nao volta para si mesmo). Nada e convertido.
		Expulsar0
		{
			Type = ResourceConverter
			OperationalToggle = NaoTipo0
			FromStorage = Estoque0
			FromQuantity = &~/PAIOL/EXPULSAR_QTD
			MinFromQuantityForConversion = 1
			ToStorage = SaidaExpulsao0
			ToQuantity = &~/PAIOL/EXPULSAR_QTD
			MinToQuantityForConversion = 1
			Interval = 0.1
		}
		SaidaExpulsao0
		{
			Type = NetworkResourceInput
			ResourceType = bullet
			Mode = DistributeProportionallyByAvailable
			Categories = [ rafaeltessaro.bs2t_paiol ]
			AllowUncategorized = false
		}
		Expulsar1
		{
			Type = ResourceConverter
			OperationalToggle = NaoTipo1
			FromStorage = Estoque1
			FromQuantity = &~/PAIOL/EXPULSAR_QTD
			MinFromQuantityForConversion = 1
			ToStorage = SaidaExpulsao1
			ToQuantity = &~/PAIOL/EXPULSAR_QTD
			MinToQuantityForConversion = 1
			Interval = 0.1
		}
		SaidaExpulsao1
		{
			Type = NetworkResourceInput
			ResourceType = missile_part_he
			Mode = DistributeProportionallyByAvailable
			Categories = [ rafaeltessaro.bs2t_paiol ]
			AllowUncategorized = false
		}
		Mudou0 { Type = ValueChangeTrigger; ValueSource = Estoque0 }
		Mudou1 { Type = ValueChangeTrigger; ValueSource = Estoque1 }
		MudouAlgum
		{
			Type = MultiTrigger
			Triggers = [ Mudou0, Mudou1 ]
		}
		AtividadeTimer
		{
			Type = Timer
			Duration = 1
			StartTrigger = MudouAlgum
			ResetTrigger = MudouAlgum
			StartExpired = true
			InvertToggle = true
		}
		Zero { Type = StaticValue; Value = 0 }
		Um { Type = StaticValue; Value = 1 }
		AtividadeValor
		{
			Type = ToggleValueSelector
			Toggle = AtividadeTimer
			ToggleOnValue = Um
			ToggleOffValue = Zero
		}
		AtividadeSaida
		{
			Type = NetworkValue
			ValueSource = AtividadeValor
			Categories = [ rafaeltessaro.bs2t_atividade ]
		}
		Roteador
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NoEsteira, SaidaExpulsao0, 0]
						[NoEsteira, SaidaExpulsao1, 0]
						[NoEsteira, AtividadeSaida, 0]
					]
				}
			]
		}
		PortaEsteira_Up_0_0
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ rafaeltessaro.bs2t_esteira ]
			RouteSource = NoEsteira
			RouteEndpoint = NoEsteira
			BlueprintRouteSource = BlueprintNetworkNode
			BlueprintRouteEndpoint = BlueprintNetworkNode
			Overlay
			{
				OverlayIcon = "BS2TPortaEsteira"
				RouteLine = "BS2TEsteira"
				DrawRouteHub = false
			}
		}
		PortaEsteira_Up_1_0 : PortaEsteira_Up_0_0 { Location = [1, 0]; Direction = Up }
		PortaEsteira_Right_1_0 : PortaEsteira_Up_0_0 { Location = [1, 0]; Direction = Right }
		PortaEsteira_Right_1_1 : PortaEsteira_Up_0_0 { Location = [1, 1]; Direction = Right }
		PortaEsteira_Down_0_1 : PortaEsteira_Up_0_0 { Location = [0, 1]; Direction = Down }
		PortaEsteira_Down_1_1 : PortaEsteira_Up_0_0 { Location = [1, 1]; Direction = Down }
		PortaEsteira_Left_0_0 : PortaEsteira_Up_0_0 { Location = [0, 0]; Direction = Left }
		PortaEsteira_Left_0_1 : PortaEsteira_Up_0_0 { Location = [0, 1]; Direction = Left }
		NaEsteira
		{
			Type = MultiToggle
			Toggles = [ PortaEsteira_Up_0_0, PortaEsteira_Up_1_0, PortaEsteira_Right_1_0, PortaEsteira_Right_1_1, PortaEsteira_Down_0_1, PortaEsteira_Down_1_1, PortaEsteira_Left_0_0, PortaEsteira_Left_0_1 ]
			Mode = Any
		}

		// ------------------------------------------------------------ botoes de TESTE do estoque (so neste mod)
		// 0 = normal, 1 = +1 por segundo (contagem lenta), 2 = encher rapido, 3 = esvaziar rapido.
		// Atuam no tipo selecionado. Conversor sem origem cria; sem destino destroi (vanilla reactor_small / radiator).
		ModoEstoque
		{
			Type = UIToggle
			ToggleID = "bs2t_estoque"
			Default = 0
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		ModoMais1 { Type = ModeToggle; Mode = ModoEstoque; OnMode = 1 }
		ModoEncher { Type = ModeToggle; Mode = ModoEstoque; OnMode = 2 }
		ModoEsvaziar { Type = ModeToggle; Mode = ModoEstoque; OnMode = 3 }
		Mais1Ligado0 { Type = MultiToggle; Toggles = [EhTipo0, ModoMais1]; Mode = All }
		EncherLigado0 { Type = MultiToggle; Toggles = [EhTipo0, ModoEncher]; Mode = All }
		EsvaziarLigado0 { Type = MultiToggle; Toggles = [EhTipo0, ModoEsvaziar]; Mode = All }
		TesteMais1_0
		{
			Type = ResourceConverter
			OperationalToggle = Mais1Ligado0
			ToStorage = Estoque0
			ToQuantity = 1
			Interval = 1
		}
		TesteEncher0
