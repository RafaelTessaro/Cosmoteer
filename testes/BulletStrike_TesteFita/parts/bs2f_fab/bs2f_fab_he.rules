// =====================================================================================================
//  [TESTE] Fabrica de teste 2x2 que CRIA missile_part_he do nada (so para testes) na grade de saida, como uma fabrica vanilla
//  (a tripulacao recolhe dali: reserva quando nao ha fita).
//  Com uma Fita grudada, o Envio teletransporta da grade para os paioies de missile_part_he que tambem tem fita, em qualquer
//  lugar do navio: ViaBuffs IncomingBuffTypes = [BS2F_Fita] junta os componentes PaiolHE de todos os paioies
//  que dao o buff (padrao vanilla do propulsor -> Sala de Motores, thruster_small.rules:199-216, engine_room.rules:256-262).
// =====================================================================================================

FABRICA
{
	POR_CICLO = 8			// > 4/s gastos pela arma; cabe na grade de 1 celula (missile_part_he MaxStackSize = 10)
	INTERVALO = 1
	ENVIO_INTERVALO = 0.1		// 10 por segundo pela fita
}

Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/BS2FFabHE"
	IconNameKey = "Parts/BS2FFabHEIcon"
	DescriptionKey = "Parts/BS2FFabHEDesc"
	ID = rafaeltessaro.bs2f_fab_he
	EditorGroups = ["BS2Fita"]
	Resources
	[
		[steel, 20]
	]
	Size = [2, 2]
	SelectionPriority = 1
	MaxHealth = 4000
	TypeCategories = [provides_ammo, bs2f_maquina]
	ReceivableBuffs : ^/0/ReceivableBuffs [BS2F_FitaLink, BS2F_Fita]
	EditorIcon
	{
		Texture
		{
			File = "he/icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		// grade de saida igual a da fabrica vanilla: a tripulacao recolhe daqui quando nao ha fita
		GradeSaida
		{
			Type = TypedResourceGrid
			ResourceType = missile_part_he
			GridRect = [1, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}
		Produtor
		{
			Type = ResourceConverter
			OperationalToggle = PowerToggle
			ToStorage = GradeSaida
			ToQuantity = &~/FABRICA/POR_CICLO
			MinToQuantityForConversion = &~/FABRICA/POR_CICLO
			Interval = &~/FABRICA/INTERVALO
		}

		// ------------------------------------------------ fita: teletransporte para os paioies com fita
		FitaLigada
		{
			Type = BuffToggle
			BuffType = BS2F_FitaLink
		}
		// ancora: um elemento sempre DESLIGADO (capacidade 0) para a lista nunca ficar vazia; os paioies/armas de verdade
		// entram pelo ViaBuffs. Proxy com ProxyToggle desligado = estado vanilla (engine_room.rules:113-125, um dos dois
		// proxies da Sala de Motores esta sempre desligado).
		Desligado { Type = StaticToggle; ToggleOn = false }
		Ancora
		{
			Type = ResourceStorageProxy
			ResourceType = missile_part_he
			ComponentID = GradeSaida
			ProxyToggle = Desligado
		}
		ParaPaiois
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [Ancora]
			ViaBuffs
			{
				IncomingBuffTypes = [BS2F_Fita]
				ComponentIDs = [PaiolHE]
			}
			AddMode = PrioritizeLeastResources
		}
		Envio
		{
			Type = ResourceConverter
			OperationalToggle = FitaLigada
			FromStorage = GradeSaida
			FromQuantity = 1
			MinFromQuantityForConversion = 1
			ToStorage = ParaPaiois
			ToQuantity = 1
			Interval = &~/FABRICA/ENVIO_INTERVALO
		}
		SaindoRecente
		{
			Type = Timer
			Duration = 0.6
			StartTrigger = Envio
			ResetTrigger = Envio
			StartExpired = true
			InvertToggle = true
		}
		AnimSaindo
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = SaindoRecente
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"../fx/cartucho_sai1.png"
							"../fx/cartucho_sai2.png"
							"../fx/cartucho_sai3.png"
							"../fx/cartucho_sai4.png"
							"../fx/cartucho_sai5.png"
							"../fx/cartucho_sai6.png"
							"../fx/cartucho_sai7.png"
							"../fx/cartucho_sai8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"../fx/brilho_sai1.png"
							"../fx/brilho_sai2.png"
							"../fx/brilho_sai3.png"
							"../fx/brilho_sai4.png"
							"../fx/brilho_sai5.png"
							"../fx/brilho_sai6.png"
							"../fx/brilho_sai7.png"
							"../fx/brilho_sai8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075
					}
				]
			}
		}

		// ------------------------------------------------ responde para a Fita vizinha (luz verde na Fita)
		AvisaFitaHorizontal
		{
			Type = AreaBuffProvider
			BuffType = BS2F_FitaAck
			BuffArea = [-1, 0, 4, 2]
			Criteria
			{
				Category = bs2f_fita
			}
		}
		AvisaFitaVertical : AvisaFitaHorizontal
		{
			BuffArea = [0, -1, 2, 4]
		}

		// luz "produzindo" (Timer usado como interruptor, V chaingun.rules:197-207)
		ProduziuRecente
		{
			Type = Timer
			Duration = 1.5
			StartTrigger = Produtor
			ResetTrigger = Produtor
			StartExpired = true
			InvertToggle = true
		}
		Luz
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = ProduziuRecente
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{ File = "he/lamp.png"; Size = [2, 2] }
				]
			}
		}
		Graficos
		{
			Type = Graphics
			Location = [1, 1]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{ File = "he/floor.png"; Size = [2, 2] }
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{ File = "he/walls.png"; Size = [2, 2] }
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{ File = "he/roof.png"; NormalsFile = "he/roof_normals.png"; Size = [2, 2] }
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "he/blueprints.png"
			Size = [2, 2]
		}
		Indicadores
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
				}
			]
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1, 1]
		}
	}
}
