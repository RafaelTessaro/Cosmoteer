// Textos do Bullet Strike. Nao coloque __Name / __DebugOnly em arquivos de mod.

BSModTag = "\n<s16><gray>Mod: Bullet Strike</gray></s16>"
EditorGroups
{
	BulletStrike = "Bullet Strike"
}
Parts
{
	BSLmg = "Light Deck Machine Gun"
	BSLmgIcon = "Marimbondo"
	BSLmgDesc = "A cheap pintle-mounted machine gun. Small enough to fit anywhere on deck. \"Marimbondo\"\n\nEarly-game deck weapon. Range 220 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).<string id='BSModTag'/>"
	BSHmg = "Heavy Deck Machine Gun"
	BSHmgIcon = "Mangangá"
	BSHmgDesc = "Heavy machine gun that keeps a steady stream of tracers on target. \"Mangangá\"\n\nEarly-game deck weapon. Range 240 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).<string id='BSModTag'/>"
	BSAutocannon20 = "20mm Deck Autocannon"
	BSAutocannon20Icon = "Carcará"
	BSAutocannon20Desc = "Twin 20 mm autocannon: the first real teeth of a gunboat. \"Carcará\"\n\nEarly-game deck weapon. Range 250 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).<string id='BSModTag'/>"
	BSQuadHmg = "Quad Heavy Machine Gun"
	BSQuadHmgIcon = "Saci"
	BSQuadHmgDesc = "Heavy machine gun that keeps a steady stream of tracers on target. \"Saci\"\n\nMid-game deck weapon. Range 300 m. Needs no power: 2 crew and Magazines. Can be overclocked.<string id='BSModTag'/>"
	BSQuadHmgOverclock = "Overclocked Quad Heavy Machine Gun"
	BSQuadHmgOverclockDesc = "Whirlwind: the feed governor is pinned open - four barrels hammer at 19.6 rounds/s and the mount spins like the Saci's dust devil. Produces waste heat while firing."
	BSMinigun = "Deck Minigun"
	BSMinigunIcon = "Cigarra"
	BSMinigunDesc = "Six spinning barrels. Takes a few seconds to spin up, then turns targets into scrap. \"Cigarra\"\n\nMid-game deck weapon. Range 300 m. Needs no power: 2 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSMinigunOverclock = "Overclocked Deck Minigun"
	BSMinigunOverclockDesc = "Dragon's Breath: the spin governor is removed - barrels scream to 36 rounds/s, glow red-hot and the tracer stream becomes a solid whip. Produces waste heat while firing."
	BSNaval76 = "76mm Naval Automatic Cannon"
	BSNaval76Icon = "Tambor"
	BSNaval76Desc = "A naval automatic cannon: not the fastest gun around, but every 'thump' lands a heavy shell. \"Tambor\"\n\nMid-game deck weapon. Range 340 m. Needs no power: 3 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSNaval76Overclock = "Overclocked 76mm Naval Automatic Cannon"
	BSNaval76OverclockDesc = "Rapid Salvo: the autoloader goes to emergency cadence - 'tum, tum, tum' becomes 'TUMTUMTUM' and the deck shakes. Produces waste heat while firing."
	BSPlasmaGatling = "Plasma Gatling"
	BSPlasmaGatlingIcon = "Boitatá"
	BSPlasmaGatlingDesc = "Fires superheated plasma bolts that tear through shields. \"Boitatá\"\n\nMid-game deck weapon. Range 320 m. Needs no power: 2 crew and Plasma Cells. Can be overclocked.<string id='BSModTag'/>"
	BSPlasmaGatlingOverclock = "Overclocked Plasma Gatling"
	BSPlasmaGatlingOverclockDesc = "Overcharge: cells are dumped hotter - fatter, faster, white-hot bolts at a slightly lower cadence. Produces waste heat while firing."
	BSRotary30 = "30mm Heavy Rotary Cannon"
	BSRotary30Icon = "Furacão"
	BSRotary30Desc = "A 30 mm rotary cannon. Slow to spin up, devastating once it does. \"Furacão\"\n\nLate-game deck weapon. Range 500 m. Needs no power: 4 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSRotary30Overclock = "Overclocked 30mm Heavy Rotary Cannon"
	BSRotary30OverclockDesc = "Hurricane: governor removed - seven barrels wind up to 16.8 rounds/s in 4 s and the gun howls 'BRRRRT'. Produces waste heat while firing."
	BSNaval155 = "155mm Twin Naval Gun"
	BSNaval155Icon = "Trovão"
	BSNaval155Desc = "Twin 155 mm naval turret. Long-range artillery for capital ships. \"Trovão\"\n\nLate-game deck weapon. Range 520 m. Needs no power: 5 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSNaval155Overclock = "Overclocked 155mm Twin Naval Gun"
	BSNaval155OverclockDesc = "Supercharge: double powder bags and the rammer on manual override - the twins alternate every 0.96 s and the shells reach 598 m. Produces waste heat while firing."
	BSPlasmaHeavy = "Heavy Plasma Cannon"
	BSPlasmaHeavyIcon = "Curupira"
	BSPlasmaHeavyDesc = "A heavy plasma cannon that hurls blinding bolts at extreme range. A shield breaker. \"Curupira\"\n\nLate-game deck weapon. Range 550 m. Needs no power: 4 crew and Plasma Cells. Can be overclocked.<string id='BSModTag'/>"
	BSPlasmaHeavyOverclock = "Overclocked Heavy Plasma Cannon"
	BSPlasmaHeavyOverclockDesc = "Solar Flare: bolts are over-compressed until they burst on impact - 600 m reach and a fiery splash. Produces waste heat while firing."
	BSNukeHowitzer = "Nuclear Deck Howitzer"
	BSNukeHowitzerIcon = "Boiúna"
	BSNukeHowitzerDesc = "Nuclear howitzer. Very slow, very loud, and nothing survives the blast radius. Shells can be shot down. \"Boiúna\"\n\nLate-game deck weapon. Range 600 m. Needs no power: 6 crew and Nuclear Shells. Can be overclocked.<string id='BSModTag'/>"
	BSNukeHowitzerOverclock = "Overclocked Nuclear Deck Howitzer"
	BSNukeHowitzerOverclockDesc = "Fat Boy: boosted-yield charge - a bigger, brighter mushroom and a faster shell. Produces waste heat while firing."
	BSNaval406 = "406mm Triple Naval Turret"
	BSNaval406Icon = "Mapinguari"
	BSNaval406Desc = "The flagship's crown: a triple 406 mm battleship turret that fires full broadsides. \"Mapinguari\"\n\nLate-game deck weapon. Range 600 m. Needs no power: 10 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSNaval406Overclock = "Overclocked 406mm Triple Naval Turret"
	BSNaval406OverclockDesc = "Full Broadside: all three guns on emergency cycle - a salvo every 2.25 s, the whole flagship rocks. Produces waste heat while firing."
	BSFlakLight = "Light Deck Flak"
	BSFlakLightIcon = "Tatu"
	BSFlakLightDesc = "Light flak mount that bursts near incoming projectiles, destroying several at once. \"Tatu\"\n\nEarly-game deck weapon. Range 180 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).\n\nDEFENSE. Airburst flak that damages EVERY missile, mine, shell, laser bolt and ion shot inside its blast. Set it to Defend, Attack or Both.<string id='BSModTag'/>"
	BSCiws = "Deck CIWS"
	BSCiwsIcon = "Tamanduá"
	BSCiwsDesc = "Close-in weapon system: a radar-guided rotary gun that fills the sky with airburst flak. \"Tamanduá\"\n\nMid-game deck weapon. Range 250 m. Needs no power: 2 crew and Standard Magazines. Can be overclocked.\n\nDEFENSE. Airburst flak that damages EVERY missile, mine, shell, laser bolt and ion shot inside its blast. Set it to Defend, Attack or Both.<string id='BSModTag'/>"
	BSCiwsOverclock = "Overclocked Deck CIWS"
	BSCiwsOverclockDesc = "Barrage: the rotary runs flat out - a carpet of airbursts at 6.5 per second, at the price of 1.3 magazines per second. Produces waste heat while firing."
	BSFlakHeavy = "Heavy Flak Battery"
	BSFlakHeavyIcon = "Pororoca"
	BSFlakHeavyDesc = "Quad heavy flak battery: a wall of fire against missiles, torpedoes, shells and bolts. \"Pororoca\"\n\nLate-game deck weapon. Range 320 m. Needs no power: 4 crew and Standard Magazines. Can be overclocked.\n\nDEFENSE. Airburst flak that damages EVERY missile, mine, shell, laser bolt and ion shot inside its blast. Set it to Defend, Attack or Both.<string id='BSModTag'/>"
	BSFlakHeavyOverclock = "Overclocked Heavy Flak Battery"
	BSFlakHeavyOverclockDesc = "Flak Wall: faster bursts, and every burst leaves a lingering shrapnel cloud that shreds anything flying through it - the tidal bore in front of the flagship. Produces waste heat while firing."
	BSFactoryMagStd = "Magazine Press"
	BSFactoryMagStdIcon = "Magazine Press"
	BSFactoryMagStdDesc = "Turns 5 bullet (no power needed) into 1 Standard Magazine every 1.25 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryMagAp = "Armor-Piercing Magazine Press"
	BSFactoryMagApIcon = "Armor-Piercing Mag"
	BSFactoryMagApDesc = "Turns 2 bs_mag_std + 0.1 tristeel and 0.2 power into 2 Armor-Piercing Magazine every 4 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryMagEmp = "EMP Magazine Charger"
	BSFactoryMagEmpIcon = "EMP Magazine Charg"
	BSFactoryMagEmpDesc = "Turns 2 bs_mag_std + 0.25 copper and 0.4 power into 2 EMP Magazine every 4 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryPlasma = "Plasma Cell Factory"
	BSFactoryPlasmaIcon = "Plasma Cell Factor"
	BSFactoryPlasmaDesc = "Turns 0.5 sulfur + 0.25 coil and 0.4 power into 1 Plasma Cell every 2 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryShellNuke = "Nuclear Shell Foundry"
	BSFactoryShellNukeIcon = "Nuclear Shell Foun"
	BSFactoryShellNukeDesc = "Turns 0.125 enriched_uranium + 2 bs_mag_std and 0.8 power into 1 Nuclear Shell every 8 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSMslBox = "Deck Micro-Missile Box"
	BSMslBoxIcon = "Tocandira"
	BSMslBoxDesc = "A RAM-style micro-missile box: the gunner cranks it around and twelve micro-missiles hiss out, pair by pair. \"Tocandira\"\n\nEarly-game deck missile launcher. A full rack ripples 12 missiles in 0.73 s, then a crewed autoloader refills it one cassette at a time (1.39 s each; reloading stops while nobody mans it): one salvo every 9.1 s. Range 300 m. Missiles: Muriçoca (High-Explosive), Taturana-mirim (Napalm).\n\nNeeds no power: 1 crew and vanilla H.E. Missile Parts / T.C. Missile Parts carried into its internal magazines (12 parts each). Switching the missile type costs one full reload; a dry magazine still fires the partial rack. The missiles fly over your own deck and can be shot down by point defense. A loaded launcher cooks off when it burns or is destroyed.<string id='BSModTag'/>"
}
PartToggles
{
	BSAmmo_Std = "<b>Ammo: Standard</b>\n\nAll-round ammunition. Shell guns fire high-explosive rounds that burst on impact."
	BSAmmo_StdName = "Standard Magazines"
	BSAmmo_StdDesc = "All-round ammunition. Shell guns fire high-explosive rounds that burst on impact."
	BSAmmo_AP = "<b>Ammo: Armor-Piercing</b>\n\nHardened penetrators that punch through armor (armor counts as half) to wreck the parts behind it. Weak against shields."
	BSAmmo_APName = "Armor-Piercing Magazines"
	BSAmmo_APDesc = "Hardened penetrators that punch through armor (armor counts as half) to wreck the parts behind it. Weak against shields."
	BSAmmo_APHE = "<b>Ammo: AP-Explosive</b>\n\nPenetrates one or two armor plates and then detonates INSIDE the enemy hull."
	BSAmmo_APHEName = "AP-Explosive Magazines"
	BSAmmo_APHEDesc = "Penetrates one or two armor plates and then detonates INSIDE the enemy hull."
	BSAmmo_EMP = "<b>Ammo: EMP</b>\n\nEach hit drains battery from shields and powered parts. Lower hull damage, but great against energy-hungry ships and shields."
	BSAmmo_EMPName = "EMP Magazines"
	BSAmmo_EMPDesc = "Each hit drains battery from shields and powered parts. Lower hull damage, but great against energy-hungry ships and shields."
	BSMissile_He = "<b>Missile: Jararaca (High-Explosive)</b>\n\nA fast, direct high-explosive warhead: the reference missile. Big salvos saturate point defense."
	BSMissile_HeName = "Jararaca Missiles (High-Explosive)"
	BSMissile_HeDesc = "A fast, direct high-explosive warhead: the reference missile. Big salvos saturate point defense."
	BSMissile_Cluster = "<b>Missile: Piranha (Cluster)</b>\n\nOpens 25 m from the enemy hull (or on impact, or at the end of its flight) and releases a school of mini-missiles that spread over several parts. Shot down before it opens, it releases nothing."
	BSMissile_ClusterName = "Piranha Missiles (Cluster)"
	BSMissile_ClusterDesc = "Opens 25 m from the enemy hull (or on impact, or at the end of its flight) and releases a school of mini-missiles that spread over several parts. Shot down before it opens, it releases nothing."
	BSMissile_Limpet = "<b>Missile: Carrapato (Limpet)</b>\n\nSticks to the hull and explodes 2.5 s later, with a high chance to kill crew rushing in to repair. Shot down in flight it is lost; on a shield it only pops."
	BSMissile_LimpetName = "Carrapato Missiles (Limpet)"
	BSMissile_LimpetDesc = "Sticks to the hull and explodes 2.5 s later, with a high chance to kill crew rushing in to repair. Shot down in flight it is lost; on a shield it only pops."
	BSMissile_Napalm = "<b>Missile: Taturana (Napalm)</b>\n\nSmall blast, guaranteed fire on the part it hits and a heat pool that keeps lighting new fires. Useless against armor; extinguishers and foam are the counter."
	BSMissile_NapalmName = "Taturana Missiles (Napalm)"
	BSMissile_NapalmDesc = "Small blast, guaranteed fire on the part it hits and a heat pool that keeps lighting new fires. Useless against armor; extinguishers and foam are the counter."
	BSMissile_Emp = "<b>Missile: Poraquê (EMP)</b>\n\nDrains batteries and shields in an area and keeps draining powered parts for a few seconds. Bullet Strike weapons have no battery and are immune."
	BSMissile_EmpName = "Poraquê Missiles (EMP)"
	BSMissile_EmpDesc = "Drains batteries and shields in an area and keeps draining powered parts for a few seconds. Bullet Strike weapons have no battery and are immune."
	BSMissile_Torpedo = "<b>Missile: Boto (Decoy Torpedo)</b>\n\nA slow, tough torpedo: 1.5 s after launch the warhead separates among decoys that soak up point defense and flak."
	BSMissile_TorpedoName = "Boto Missiles (Decoy Torpedo)"
	BSMissile_TorpedoDesc = "A slow, tough torpedo: 1.5 s after launch the warhead separates among decoys that soak up point defense and flak."
	BSMissile_Nuclear = "<b>Missile: Iara (Nuclear Torpedo)</b>\n\nHeavy battery only. Counts toward the nuclear limit (2 per ship, shared with the Boiúna) and overclock never speeds up its reload. Dies to area flak on its own: mask it with a heavy salvo fired right after it."
	BSMissile_NuclearName = "Iara Missiles (Nuclear Torpedo)"
	BSMissile_NuclearDesc = "Heavy battery only. Counts toward the nuclear limit (2 per ship, shared with the Boiúna) and overclock never speeds up its reload. Dies to area flak on its own: mask it with a heavy salvo fired right after it."
}
