// Textos do Bullet Strike. Nao coloque __Name / __DebugOnly em arquivos de mod.

BSModTag = "\n<s16><gray>Mod: Bullet Strike</gray></s16>"
EditorGroups
{
	BulletStrike = "Bullet Strike"
}
Parts
{
	BSLmg = "Light Deck MG"
	BSLmgIcon = "Wasp"
	BSLmgDesc = "A cheap pintle-mounted machine gun. Small enough to fit anywhere on deck. \"Wasp\"\n\nEarly-game deck weapon. Range 220 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).<string id='BSModTag'/>"
	BSHmg = "Heavy Deck MG"
	BSHmgIcon = "Hornet"
	BSHmgDesc = "Heavy machine gun that keeps a steady stream of tracers on target. \"Hornet\"\n\nEarly-game deck weapon. Range 240 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).<string id='BSModTag'/>"
	BSAutocannon20 = "20mm Deck Autocannon"
	BSAutocannon20Icon = "Stinger"
	BSAutocannon20Desc = "Twin 20 mm autocannon: the first real teeth of a gunboat. \"Stinger\"\n\nEarly-game deck weapon. Range 250 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).<string id='BSModTag'/>"
	BSQuadHmg = "Quad Heavy MG"
	BSQuadHmgIcon = "Quadra"
	BSQuadHmgDesc = "Heavy machine gun that keeps a steady stream of tracers on target. \"Quadra\"\n\nMid-game deck weapon. Range 300 m. Needs no power: 2 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSQuadHmgOverclock = "Overclocked Quad Heavy MG"
	BSQuadHmgOverclockDesc = "Overpressure: all four barrels hammer at once, louder and wilder. Produces waste heat while firing."
	BSMinigun = "Deck Minigun"
	BSMinigunIcon = "Buzzsaw"
	BSMinigunDesc = "Six spinning barrels. Takes a few seconds to spin up, then turns targets into scrap. \"Buzzsaw\"\n\nMid-game deck weapon. Range 310 m. Needs no power: 2 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSMinigunOverclock = "Overclocked Deck Minigun"
	BSMinigunOverclockDesc = "Dragon's Breath: barrels glow red, incendiary tracers, insane rate. Produces waste heat while firing."
	BSNaval76 = "76mm Naval Automatic Cannon"
	BSNaval76Icon = "Thumper"
	BSNaval76Desc = "A naval automatic cannon: not the fastest gun around, but every 'thump' lands a heavy shell. \"Thumper\"\n\nMid-game deck weapon. Range 340 m. Needs no power: 3 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSNaval76Overclock = "Overclocked 76mm Naval Automatic Cannon"
	BSNaval76OverclockDesc = "Rapid Salvo: the 'tum, tum, tum' becomes 'TUMTUMTUM'. Produces waste heat while firing."
	BSPlasmaGatling = "Plasma Gatling"
	BSPlasmaGatlingIcon = "Sunspray"
	BSPlasmaGatlingDesc = "Fires superheated plasma bolts that tear through shields. \"Sunspray\"\n\nMid-game deck weapon. Range 320 m. Needs no power: 2 crew and Plasma Cells. Can be overclocked.<string id='BSModTag'/>"
	BSPlasmaGatlingOverclock = "Overclocked Plasma Gatling"
	BSPlasmaGatlingOverclockDesc = "Superheated: white-hot bolts, double target heating. Produces waste heat while firing."
	BSRotary30 = "30mm Heavy Rotary Cannon"
	BSRotary30Icon = "Thunderclap"
	BSRotary30Desc = "A 30 mm rotary cannon. Slow to spin up, devastating once it does. \"Thunderclap\"\n\nLate-game deck weapon. Range 500 m. Needs no power: 4 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSRotary30Overclock = "Overclocked 30mm Heavy Rotary Cannon"
	BSRotary30OverclockDesc = "BRRRT: full-auto roar, the turret shakes the deck. Produces waste heat while firing."
	BSNaval155 = "155mm Twin Naval Gun"
	BSNaval155Icon = "Hammerfall"
	BSNaval155Desc = "Twin 155 mm naval turret. Long-range artillery for capital ships. \"Hammerfall\"\n\nLate-game deck weapon. Range 520 m. Needs no power: 5 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSNaval155Overclock = "Overclocked 155mm Twin Naval Gun"
	BSNaval155OverclockDesc = "Supercharge: super-heavy charges, flatter and longer shots. Produces waste heat while firing."
	BSPlasmaHeavy = "Heavy Plasma Cannon"
	BSPlasmaHeavyIcon = "Sunhammer"
	BSPlasmaHeavyDesc = "A heavy plasma cannon that hurls blinding bolts at extreme range. A shield breaker. \"Sunhammer\"\n\nLate-game deck weapon. Range 550 m. Needs no power: 4 crew and Plasma Cells. Can be overclocked.<string id='BSModTag'/>"
	BSPlasmaHeavyOverclock = "Overclocked Heavy Plasma Cannon"
	BSPlasmaHeavyOverclockDesc = "Star-core: bolts become miniature suns. Produces waste heat while firing."
	BSNukeHowitzer = "Nuclear Howitzer"
	BSNukeHowitzerIcon = "Judgement"
	BSNukeHowitzerDesc = "Nuclear howitzer. Very slow, very loud, and nothing survives the blast radius. Shells can be shot down. \"Judgement\"\n\nLate-game deck weapon. Range 600 m. Needs no power: 5 crew and Nuclear Shells. Can be overclocked.<string id='BSModTag'/>"
	BSNukeHowitzerOverclock = "Overclocked Nuclear Howitzer"
	BSNukeHowitzerOverclockDesc = "Rapid Breech: forced loading cycle, the ground (deck) trembles. Produces waste heat while firing."
	BSNaval406 = "406mm Triple Naval Turret"
	BSNaval406Icon = "Leviathan"
	BSNaval406Desc = "The flagship's crown: a triple 406 mm battleship turret that fires full broadsides. \"Leviathan\"\n\nLate-game deck weapon. Range 600 m. Needs no power: 8 crew and Magazines (selectable: Standard / AP / AP-Explosive / EMP). Can be overclocked.<string id='BSModTag'/>"
	BSNaval406Overclock = "Overclocked 406mm Triple Naval Turret"
	BSNaval406OverclockDesc = "Full Broadside: faster ramming cycle, heavier charges, the whole ship rocks. Produces waste heat while firing."
	BSFlakLight = "Light Deck Flak"
	BSFlakLightIcon = "Umbrella"
	BSFlakLightDesc = "Light flak mount that bursts near incoming projectiles, destroying several at once. \"Umbrella\"\n\nEarly-game deck weapon. Range 180 m. Needs no power: 1 crew and loose Ammo (the vanilla Cannon Ammo).\n\nDEFENSE. Airburst flak that damages EVERY missile, mine, shell, laser bolt and ion shot inside its blast. Set it to Defend, Attack or Both.<string id='BSModTag'/>"
	BSCiws = "Deck CIWS"
	BSCiwsIcon = "Bastion"
	BSCiwsDesc = "Close-in weapon system: a radar-guided rotary gun that fills the sky with airburst flak. \"Bastion\"\n\nMid-game deck weapon. Range 240 m. Needs no power: 2 crew and Standard Magazines. Can be overclocked.\n\nDEFENSE. Airburst flak that damages EVERY missile, mine, shell, laser bolt and ion shot inside its blast. Set it to Defend, Attack or Both.<string id='BSModTag'/>"
	BSCiwsOverclock = "Overclocked Deck CIWS"
	BSCiwsOverclockDesc = "Shrapnel Curtain: each burst leaves a lingering shrapnel cloud. Produces waste heat while firing."
	BSFlakHeavy = "Heavy Flak Battery"
	BSFlakHeavyIcon = "Skywall"
	BSFlakHeavyDesc = "Quad heavy flak battery: a wall of fire against missiles, torpedoes, shells and bolts. \"Skywall\"\n\nLate-game deck weapon. Range 320 m. Needs no power: 4 crew and Standard Magazines. Can be overclocked.\n\nDEFENSE. Airburst flak that damages EVERY missile, mine, shell, laser bolt and ion shot inside its blast. Set it to Defend, Attack or Both.<string id='BSModTag'/>"
	BSFlakHeavyOverclock = "Overclocked Heavy Flak Battery"
	BSFlakHeavyOverclockDesc = "Flak Wall: every burst leaves a 4 s wall of shrapnel. Produces waste heat while firing."
	BSFactoryMagStd = "Magazine Press"
	BSFactoryMagStdIcon = "Magazine Press"
	BSFactoryMagStdDesc = "Turns 6 bullet (no power needed) into 1 Standard Magazine every 1 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryMagAp = "AP Magazine Line"
	BSFactoryMagApIcon = "AP Magazine Line"
	BSFactoryMagApDesc = "Turns 12 bullet + 1 iron and 0.15 power into 2 AP Magazine every 2 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryMagAphe = "APHE Magazine Line"
	BSFactoryMagApheIcon = "APHE Magazine Line"
	BSFactoryMagApheDesc = "Turns 12 bullet + 1 iron + 1 sulfur and 0.2 power into 2 APHE Magazine every 2 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryMagEmp = "EMP Magazine Line"
	BSFactoryMagEmpIcon = "EMP Magazine Line"
	BSFactoryMagEmpDesc = "Turns 18 bullet + 1 copper and 0.6 power into 3 EMP Magazine every 3 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryPlasma = "Plasma Cell Condenser"
	BSFactoryPlasmaIcon = "Plasma Cell Conden"
	BSFactoryPlasmaDesc = "Turns 1 sulfur + 1 copper and 1.5 power into 5 Plasma Cell every 5 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
	BSFactoryNukeShell = "Nuclear Shell Foundry"
	BSFactoryNukeShellIcon = "Nuclear Shell Foun"
	BSFactoryNukeShellDesc = "Turns 1 enriched_uranium + 40 bullet and 2 power into 8 Nuclear Shell every 16 s. +25% speed for each adjacent factory.<string id='BSModTag'/>"
}
PartToggles
{
	BSAmmo_Std = "<b>Ammo: Standard</b>\n\nAll-round ammunition. Shell guns fire high-explosive rounds that burst on impact."
	BSAmmo_StdName = "Standard Magazines"
	BSAmmo_StdDesc = "All-round ammunition. Shell guns fire high-explosive rounds that burst on impact."
	BSAmmo_AP = "<b>Ammo: Armor-Piercing</b>\n\nHardened penetrators that punch through armor (armor counts as half) to wreck the parts behind it. Weak against shields."
	BSAmmo_APName = "Armor-Piercing Magazines"
	BSAmmo_APDesc = "Hardened penetrators that punch through armor (armor counts as half) to wreck the parts behind it. Weak against shields."
	BSAmmo_APHE = "<b>Ammo: AP-Explosive</b>\n\nPenetrates one or two armor plates and then detonates INSIDE the enemy hull."
	BSAmmo_APHEName = "AP-Explosive Magazines"
	BSAmmo_APHEDesc = "Penetrates one or two armor plates and then detonates INSIDE the enemy hull."
	BSAmmo_EMP = "<b>Ammo: EMP</b>\n\nEach hit drains battery from shields and powered parts. Lower hull damage, but great against energy-hungry ships and shields."
	BSAmmo_EMPName = "EMP Magazines"
	BSAmmo_EMPDesc = "Each hit drains battery from shields and powered parts. Lower hull damage, but great against energy-hungry ships and shields."
}
