	BSMagEmpDesc = "A sealed magazine that crew carry to Bullet Strike guns. Each gun opens it into a number of shots. Bullet Strike ammunition."
	BSPlasmaCell = "Plasma Cell"
	BSPlasmaCellPlural = "Plasma Cells"
	BSPlasmaCellDesc = "A magnetically sealed cell of plasma for plasma weapons. Bullet Strike ammunition."
	BSShellNuke = "Nuclear Shell"
