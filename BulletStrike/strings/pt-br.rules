// Textos do Bullet Strike. Nao coloque __Name / __DebugOnly em arquivos de mod.

BSModTag = "\n<s16><gray>Mod: Bullet Strike</gray></s16>"
EditorGroups
{
	BulletStrike = "Bullet Strike"
}
Parts
{
	BSLmg = "Metralhadora Leve de Convés"
	BSLmgIcon = "Marimbondo"
	BSLmgDesc = "Metralhadora barata em reparo de pino. Pequena o bastante para caber em qualquer canto do convés. \"Marimbondo\"\n\nInício de jogo - arma de convés. Alcance 220 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSHmg = "Metralhadora Pesada de Convés"
	BSHmgIcon = "Mangangá"
	BSHmgDesc = "Metralhadora pesada que mantém um fluxo constante de traçantes no alvo. \"Mangangá\"\n\nInício de jogo - arma de convés. Alcance 240 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSAutocannon20 = "Canhão Automático de Convés 20 mm"
	BSAutocannon20Icon = "Carcará"
	BSAutocannon20Desc = "Autocanhão duplo de 20 mm: os primeiros dentes de verdade de uma canhoneira. \"Carcará\"\n\nInício de jogo - arma de convés. Alcance 250 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSQuadHmg = "Metralhadora Pesada Quádrupla"
	BSQuadHmgIcon = "Saci"
	BSQuadHmgDesc = "Metralhadora pesada que mantém um fluxo constante de traçantes no alvo. \"Saci\"\n\nMeio de jogo - arma de convés. Alcance 300 m. Não usa energia: 2 tripulantes e carregadores. Aceita overclock.<string id='BSModTag'/>"
	BSQuadHmgOverclock = "Metralhadora Pesada Quádrupla (Overclocking)"
	BSQuadHmgOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSMinigun = "Minigun de Convés"
	BSMinigunIcon = "Cigarra"
	BSMinigunDesc = "Seis canos girando. Leva alguns segundos para acelerar e depois transforma o alvo em sucata. \"Cigarra\"\n\nMeio de jogo - arma de convés. Alcance 300 m. Não usa energia: 2 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSMinigunOverclock = "Minigun de Convés (Overclocking)"
	BSMinigunOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNaval76 = "Canhão Naval Automático 76 mm"
	BSNaval76Icon = "Tambor"
	BSNaval76Desc = "Um canhão naval automático: não é o mais rápido, mas cada 'tum' entrega uma granada pesada. \"Tambor\"\n\nMeio de jogo - arma de convés. Alcance 340 m. Não usa energia: 3 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSNaval76Overclock = "Canhão Naval Automático 76 mm (Overclocking)"
	BSNaval76OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSPlasmaGatling = "Gatling de Plasma"
	BSPlasmaGatlingIcon = "Boitatá"
	BSPlasmaGatlingDesc = "Dispara rajadas de plasma superaquecido que rasgam escudos. \"Boitatá\"\n\nMeio de jogo - arma de convés. Alcance 320 m. Não usa energia: 2 tripulantes e células de plasma. Aceita overclock.<string id='BSModTag'/>"
	BSPlasmaGatlingOverclock = "Gatling de Plasma (Overclocking)"
	BSPlasmaGatlingOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSRotary30 = "Canhão Rotativo Pesado 30 mm"
	BSRotary30Icon = "Furacão"
	BSRotary30Desc = "Canhão rotativo de 30 mm. Demora para acelerar, devastador quando acelera. \"Furacão\"\n\nFim de jogo - arma de convés. Alcance 500 m. Não usa energia: 4 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSRotary30Overclock = "Canhão Rotativo Pesado 30 mm (Overclocking)"
	BSRotary30OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNaval155 = "Canhão Naval Duplo 155 mm"
	BSNaval155Icon = "Trovão"
	BSNaval155Desc = "Torre naval dupla de 155 mm. Artilharia de longo alcance para naves capitais. \"Trovão\"\n\nFim de jogo - arma de convés. Alcance 520 m. Não usa energia: 5 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSNaval155Overclock = "Canhão Naval Duplo 155 mm (Overclocking)"
	BSNaval155OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSPlasmaHeavy = "Canhão de Plasma Pesado"
	BSPlasmaHeavyIcon = "Curupira"
	BSPlasmaHeavyDesc = "Um canhão de plasma pesado que lança disparos ofuscantes a distâncias extremas. Quebra escudos. \"Curupira\"\n\nFim de jogo - arma de convés. Alcance 550 m. Não usa energia: 4 tripulantes e células de plasma. Aceita overclock.<string id='BSModTag'/>"
	BSPlasmaHeavyOverclock = "Canhão de Plasma Pesado (Overclocking)"
	BSPlasmaHeavyOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNukeHowitzer = "Obuseiro Nuclear de Convés"
	BSNukeHowitzerIcon = "Boiúna"
	BSNukeHowitzerDesc = "Obuseiro nuclear. Muito lento, muito barulhento, e nada sobrevive à explosão. Os projéteis podem ser abatidos. \"Boiúna\"\n\nFim de jogo - arma de convés. Alcance 600 m. Não usa energia: 6 tripulantes e projéteis nucleares. Aceita overclock.<string id='BSModTag'/>"
	BSNukeHowitzerOverclock = "Obuseiro Nuclear de Convés (Overclocking)"
	BSNukeHowitzerOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNaval406 = "Torre Naval Tripla 406 mm"
	BSNaval406Icon = "Mapinguari"
	BSNaval406Desc = "A coroa da nave capitânia: uma torre tripla de 406 mm de encouraçado que dispara salvas completas. \"Mapinguari\"\n\nFim de jogo - arma de convés. Alcance 600 m. Não usa energia: 10 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSNaval406Overclock = "Torre Naval Tripla 406 mm (Overclocking)"
	BSNaval406OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSFlakLight = "Flak Leve de Convés"
	BSFlakLightIcon = "Tatu"
	BSFlakLightDesc = "Flak leve que explode perto dos projéteis que chegam, destruindo vários de uma vez. \"Tatu\"\n\nInício de jogo - arma de convés. Alcance 180 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Ambos.<string id='BSModTag'/>"
	BSCiws = "CIWS de Convés"
	BSCiwsIcon = "Tamanduá"
	BSCiwsDesc = "Sistema de defesa de curto alcance: um canhão rotativo guiado por radar que enche o céu de flak. \"Tamanduá\"\n\nMeio de jogo - arma de convés. Alcance 250 m. Não usa energia: 2 tripulantes e carregadores padrão. Aceita overclock.\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Ambos.<string id='BSModTag'/>"
	BSCiwsOverclock = "CIWS de Convés (Overclocking)"
	BSCiwsOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSFlakHeavy = "Bateria Flak Pesada"
	BSFlakHeavyIcon = "Pororoca"
	BSFlakHeavyDesc = "Bateria quádrupla de flak pesada: uma muralha de fogo contra mísseis, torpedos, granadas e disparos. \"Pororoca\"\n\nFim de jogo - arma de convés. Alcance 320 m. Não usa energia: 4 tripulantes e carregadores padrão. Aceita overclock.\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Ambos.<string id='BSModTag'/>"
	BSFlakHeavyOverclock = "Bateria Flak Pesada (Overclocking)"
	BSFlakHeavyOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSFactoryMagStd = "Prensa de Carregadores"
	BSFactoryMagStdIcon = "Prensa de Carregad"
	BSFactoryMagStdDesc = "Transforma 5 bullet (não usa energia) em 1 Carregador Padrão a cada 1.25 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryMagAp = "Prensa de Carregadores Perfurantes"
	BSFactoryMagApIcon = "Prensa de Carregad"
	BSFactoryMagApDesc = "Transforma 2 bs_mag_std + 0.1 tristeel e 0.2 de energia em 2 Carregador Perfurante a cada 4 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryMagEmp = "Carregadora de Carregadores EMP"
	BSFactoryMagEmpIcon = "Carregadora de Car"
	BSFactoryMagEmpDesc = "Transforma 2 bs_mag_std + 0.25 copper e 0.4 de energia em 2 Carregador EMP a cada 4 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryPlasma = "Fábrica de Células de Plasma"
	BSFactoryPlasmaIcon = "Fábrica de Células"
	BSFactoryPlasmaDesc = "Transforma 0.5 sulfur + 0.25 coil e 0.4 de energia em 1 Célula de Plasma a cada 2 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryShellNuke = "Fundição de Projéteis Nucleares"
	BSFactoryShellNukeIcon = "Fundição de Projét"
	BSFactoryShellNukeDesc = "Transforma 0.125 enriched_uranium + 2 bs_mag_std e 0.8 de energia em 1 Projétil Nuclear a cada 8 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSMslBox = "Caixa de Micromísseis de Convés"
	BSMslBoxIcon = "Tocandira"
	BSMslBoxDesc = "Uma caixa de micromísseis estilo RAM: o atirador gira a caixa e doze micromísseis saem chiando, de dois em dois. \"Tocandira\"\n\nInício de jogo - lança-mísseis de convés. Com o rack cheio, dispara 12 mísseis em sequência em 0,73 s; depois um autocarregador tripulado recarrega um cassete por vez (1,39 s cada; sem tripulação no posto a recarga para): uma salva a cada 9,1 s. Alcance 300 m. Mísseis: Muriçoca (alto-explosivo), Taturana-mirim (napalm).\n\nNão usa energia: 1 tripulante e peças de míssil A.E. / peças de míssil T.C. do jogo base levadas até os paióis internos (12 peças cada). Trocar o tipo de míssil custa uma recarga completa; com o paiol vazio, o rack parcial dispara mesmo assim. Os mísseis passam por cima do próprio convés e podem ser abatidos pela defesa de ponto. Carregado, o lançador explode quando pega fogo ou é destruído.<string id='BSModTag'/>"
	BSMslTwin = "Lançador de Mísseis de Convés de Casulo Duplo"
	BSMslTwinIcon = "Caipora"
	BSMslTwinDesc = "Dois casulos octogonais ladeiam uma cúpula blindada com olho sensor; o rack cheio vira um rufar de dezesseis mísseis em dois segundos, o casulo direito primeiro. \"Caipora\"\n\nMeio de jogo - lança-mísseis de convés. Com o rack cheio, dispara 16 mísseis em sequência em 2 s; depois um autocarregador tripulado recarrega uma célula por vez (1,06 s cada; sem tripulação no posto a recarga para): uma salva a cada 19 s. Alcance 400 m. Mísseis: Jararaca (alto-explosivo), Piranha (submunições), Carrapato (grudento), Taturana (napalm), Poraquê (PEM), Boto (torpedo com iscas). Mísseis por salva: Jararaca, Piranha, Carrapato, Taturana, Poraquê 16; Boto 2.\n\nNão usa energia: 2 tripulantes e peças de míssil A.E. / peças de míssil T.C. / peças de míssil PEM do jogo base levadas até os paióis internos (64 peças cada). Trocar o tipo de míssil custa uma recarga completa; com o paiol vazio, o rack parcial dispara mesmo assim. Os mísseis passam por cima do próprio convés e podem ser abatidos pela defesa de ponto. Carregado, o lançador explode quando pega fogo ou é destruído. Aceita overclock.<string id='BSModTag'/>"
	BSMslTwinOverclock = "Lançador de Mísseis de Convés de Casulo Duplo (Overclocking)"
	BSMslTwinOverclockDesc = "\"Fúria da Caipora\": o autocarregador trabalha 1,5 vez mais rápido (Poraquê: 1,2 vez); ripple, dano e alcance não mudam. Custa 425 de calor por peça de míssil carregada mais 100 de calor/s (precisa de radiador). Cerca de 1 em cada 16 mísseis é descartado do paiol a cada salva (torpedos isentos). Desligar dá uma pausa de 3 s e o paiol esvazia mais rápido. Sem refrigeração suficiente, esquenta, pega fogo e explode junto com o estoque."
	BSMslQuad = "Bateria Pesada de Mísseis Quádrupla"
	BSMslQuadIcon = "Mula-sem-Cabeça"
	BSMslQuadDesc = "Um corpo blindado sem cabeça carrega quatro casulos longos em braços hidráulicos: um estouro de 48 mísseis pesados em três segundos. Carregada, é a peça mais perigosa da sua nave. \"Mula-sem-Cabeça\"\n\nFim de jogo - lança-mísseis de convés. Com o rack cheio, dispara 48 mísseis em sequência em 3,13 s; depois um autocarregador tripulado recarrega uma célula por vez (0,26 s cada; sem tripulação no posto a recarga para): uma salva a cada 15,8 s. Alcance 600 m. Mísseis: Jararaca (alto-explosivo), Piranha (submunições), Carrapato (grudento), Taturana (napalm), Poraquê (PEM), Boto (torpedo com iscas), Iara (torpedo nuclear). Mísseis por salva: Jararaca 48; Piranha, Carrapato, Taturana, Poraquê 16; Boto 4; Iara 2.\n\nNão usa energia: 8 tripulantes e peças de míssil A.E. / peças de míssil T.C. / peças de míssil PEM / peças de míssil nuclear do jogo base levadas até os paióis internos (A.E. 192, térmica 192, PEM 96, nuclear 32 peças). Trocar o tipo de míssil custa uma recarga completa; com o paiol vazio, o rack parcial dispara mesmo assim. Os mísseis passam por cima do próprio convés e podem ser abatidos pela defesa de ponto. Carregado, o lançador explode quando pega fogo ou é destruído. Aceita overclock.\n\nLimite: 2 por nave, junto com o obuseiro nuclear Boiúna (armas nucleares, em qualquer combinação).<string id='BSModTag'/>"
	BSMslQuadOverclock = "Bateria Pesada de Mísseis Quádrupla (Overclocking)"
	BSMslQuadOverclockDesc = "\"Estouro da Boiada\": o autocarregador trabalha 1,5 vez mais rápido (Poraquê: 1,2 vez); ripple, dano e alcance não mudam. Nunca acelera a recarga do torpedo nuclear Iara. Custa 400 de calor por peça de míssil carregada mais 150 de calor/s (precisa de radiador). Cerca de 1 em cada 16 mísseis é descartado do paiol a cada salva (torpedos isentos). Desligar dá uma pausa de 3 s e o paiol esvazia mais rápido. Sem refrigeração suficiente, esquenta, pega fogo e explode junto com o estoque."
}
PartToggles
{
	BSAmmo_Std = "<b>Munição: Padrão</b>\n\nMunição versátil. Os canhões disparam granadas explosivas que estouram no impacto."
	BSAmmo_StdName = "Carregadores: Padrão"
	BSAmmo_StdDesc = "Munição versátil. Os canhões disparam granadas explosivas que estouram no impacto."
	BSAmmo_AP = "<b>Munição: Perfurante</b>\n\nPenetradores endurecidos que atravessam blindagem (a blindagem conta pela metade) e destroem o que está atrás. Fracos contra escudos."
	BSAmmo_APName = "Carregadores: Perfurante"
	BSAmmo_APDesc = "Penetradores endurecidos que atravessam blindagem (a blindagem conta pela metade) e destroem o que está atrás. Fracos contra escudos."
	BSAmmo_APHE = "<b>Munição: Perfurante-Explosiva</b>\n\nAtravessa uma ou duas placas de blindagem e então detona DENTRO do casco inimigo."
	BSAmmo_APHEName = "Carregadores: Perfurante-Explosiva"
	BSAmmo_APHEDesc = "Atravessa uma ou duas placas de blindagem e então detona DENTRO do casco inimigo."
	BSAmmo_EMP = "<b>Munição: EMP</b>\n\nCada acerto drena bateria de escudos e partes energizadas. Menos dano ao casco, mas ótima contra naves que dependem de energia e escudos."
	BSAmmo_EMPName = "Carregadores: EMP"
	BSAmmo_EMPDesc = "Cada acerto drena bateria de escudos e partes energizadas. Menos dano ao casco, mas ótima contra naves que dependem de energia e escudos."
	BSMissile_He = "<b>Míssil: Jararaca (Alto-Explosivo)</b>\n\nOgiva alto-explosiva rápida e direta: o míssil de referência. Salvas grandes saturam a defesa de ponto."
	BSMissile_HeName = "Mísseis Jararaca (alto-explosivo)"
	BSMissile_HeDesc = "Ogiva alto-explosiva rápida e direta: o míssil de referência. Salvas grandes saturam a defesa de ponto."
	BSMissile_Cluster = "<b>Míssil: Piranha (Submunições)</b>\n\nAbre a 25 m do casco inimigo (ou no impacto, ou no fim do voo) e solta um cardume de minimísseis que se espalham por várias peças. Abatido antes de abrir, não solta nada."
	BSMissile_ClusterName = "Mísseis Piranha (submunições)"
	BSMissile_ClusterDesc = "Abre a 25 m do casco inimigo (ou no impacto, ou no fim do voo) e solta um cardume de minimísseis que se espalham por várias peças. Abatido antes de abrir, não solta nada."
	BSMissile_Limpet = "<b>Míssil: Carrapato (Grudento)</b>\n\nGruda no casco e explode 2,5 s depois, com alta chance de matar a tripulação que vier consertar. Abatido no voo, se perde; num escudo só estoura."
	BSMissile_LimpetName = "Mísseis Carrapato (grudento)"
	BSMissile_LimpetDesc = "Gruda no casco e explode 2,5 s depois, com alta chance de matar a tripulação que vier consertar. Abatido no voo, se perde; num escudo só estoura."
	BSMissile_Napalm = "<b>Míssil: Taturana (Napalm)</b>\n\nExplosão pequena, fogo garantido na peça atingida e calor em volta que continua acendendo incêndios. Inútil contra blindagem; extintor e espuma são o contra."
	BSMissile_NapalmName = "Mísseis Taturana (napalm)"
	BSMissile_NapalmDesc = "Explosão pequena, fogo garantido na peça atingida e calor em volta que continua acendendo incêndios. Inútil contra blindagem; extintor e espuma são o contra."
	BSMissile_Emp = "<b>Míssil: Poraquê (PEM)</b>\n\nDrena baterias e escudos em área e continua drenando as peças com energia por alguns segundos. As armas do Bullet Strike não usam bateria e são imunes."
	BSMissile_EmpName = "Mísseis Poraquê (PEM)"
	BSMissile_EmpDesc = "Drena baterias e escudos em área e continua drenando as peças com energia por alguns segundos. As armas do Bullet Strike não usam bateria e são imunes."
	BSMissile_Torpedo = "<b>Míssil: Boto (Torpedo com Iscas)</b>\n\nTorpedo lento e resistente: 1,5 s depois do lançamento a ogiva se separa no meio de iscas que gastam a defesa de ponto e a flak."
	BSMissile_TorpedoName = "Mísseis Boto (torpedo com iscas)"
	BSMissile_TorpedoDesc = "Torpedo lento e resistente: 1,5 s depois do lançamento a ogiva se separa no meio de iscas que gastam a defesa de ponto e a flak."
	BSMissile_Nuclear = "<b>Míssil: Iara (Torpedo Nuclear)</b>\n\nSó na bateria pesada. Conta no limite nuclear (2 por nave, junto com a Boiúna) e o overclock nunca acelera a recarga. Sozinho morre para flak de área: esconda-o com uma salva pesada logo depois."
	BSMissile_NuclearName = "Mísseis Iara (torpedo nuclear)"
	BSMissile_NuclearDesc = "Só na bateria pesada. Conta no limite nuclear (2 por nave, junto com a Boiúna) e o overclock nunca acelera a recarga. Sozinho morre para flak de área: esconda-o com uma salva pesada logo depois."
}
