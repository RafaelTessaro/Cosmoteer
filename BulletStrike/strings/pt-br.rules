// Textos do Bullet Strike. Nao coloque __Name / __DebugOnly em arquivos de mod.

BSModTag = "\n<s16><gray>Mod: Bullet Strike</gray></s16>"
EditorGroups
{
	BulletStrike = "Bullet Strike"
}
Parts
{
	BSLmg = "Metralhadora Leve de Convés"
	BSLmgIcon = "Marimbondo"
	BSLmgDesc = "Metralhadora barata em reparo de pino. Pequena o bastante para caber em qualquer canto do convés. \"Marimbondo\"\n\nInício de jogo - arma de convés. Alcance 220 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSHmg = "Metralhadora Pesada de Convés"
	BSHmgIcon = "Mangangá"
	BSHmgDesc = "Metralhadora pesada que mantém um fluxo constante de traçantes no alvo. \"Mangangá\"\n\nInício de jogo - arma de convés. Alcance 240 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSAutocannon20 = "Canhão Automático de Convés 20 mm"
	BSAutocannon20Icon = "Carcará"
	BSAutocannon20Desc = "Autocanhão duplo de 20 mm: os primeiros dentes de verdade de uma canhoneira. \"Carcará\"\n\nInício de jogo - arma de convés. Alcance 250 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSQuadHmg = "Metralhadora Pesada Quádrupla"
	BSQuadHmgIcon = "Saci"
	BSQuadHmgDesc = "Quatro metralhadoras pesadas num só reparo. Também derruba mísseis e minas que se aproximam. \"Saci\"\n\nMeio de jogo - arma de convés. Alcance 300 m. Não usa energia: 2 tripulantes e carregadores padrão. Aceita overclock.<string id='BSModTag'/>"
	BSQuadHmgOverclock = "Metralhadora Pesada Quádrupla (Overclocking)"
	BSQuadHmgOverclockDesc = "Redemoinho: o regulador da alimentação fica travado aberto; os quatro canos martelam a 19,6 disparos/s e o reparo gira como o redemoinho do Saci. Produz calor ao disparar."
	BSMinigun = "Minigun de Convés"
	BSMinigunIcon = "Cigarra"
	BSMinigunDesc = "Seis canos girando. Leva alguns segundos para acelerar e depois transforma o alvo em sucata. \"Cigarra\"\n\nMeio de jogo - arma de convés. Alcance 300 m. Não usa energia: 2 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / P.E.M.). Aceita overclock.<string id='BSModTag'/>"
	BSMinigunOverclock = "Minigun de Convés (Overclocking)"
	BSMinigunOverclockDesc = "Bafo de Dragão: sem o regulador de giro, os canos gritam até 36 disparos/s em 3,5 s, ficam em brasa e o fluxo de traçantes vira um chicote contínuo. Produz calor ao disparar."
	BSNaval76 = "Canhão Naval Automático 76 mm"
	BSNaval76Icon = "Tambor"
	BSNaval76Desc = "Um canhão naval automático: não é o mais rápido, mas cada 'tum' entrega uma granada pesada. \"Tambor\"\n\nMeio de jogo - arma de convés. Alcance 340 m. Não usa energia: 3 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / P.E.M.). Aceita overclock.<string id='BSModTag'/>"
	BSNaval76Overclock = "Canhão Naval Automático 76 mm (Overclocking)"
	BSNaval76OverclockDesc = "Salva Rápida: o autocarregador entra em cadência de emergência; o 'tum, tum, tum' vira 'TUMTUMTUM' e o convés treme. Produz calor ao disparar."
	BSPlasmaGatling = "Gatling de Plasma"
	BSPlasmaGatlingIcon = "Boitatá"
	BSPlasmaGatlingDesc = "Dispara rajadas de plasma superaquecido que rasgam escudos. \"Boitatá\"\n\nMeio de jogo - arma de convés. Alcance 320 m. Não usa energia: 2 tripulantes e células de plasma. Aceita overclock.<string id='BSModTag'/>"
	BSPlasmaGatlingOverclock = "Gatling de Plasma (Overclocking)"
	BSPlasmaGatlingOverclockDesc = "Sobrecarga: as células são descarregadas mais quentes; disparos mais gordos, mais rápidos e incandescentes (50% mais dano no casco, 352 m de alcance), com cadência um pouco menor. Produz calor ao disparar."
	BSRotary30 = "Canhão Rotativo Pesado 30 mm"
	BSRotary30Icon = "Furacão"
	BSRotary30Desc = "Canhão rotativo de 30 mm. Demora para acelerar, devastador quando acelera. \"Furacão\"\n\nFim de jogo - arma de convés. Alcance 500 m. Não usa energia: 4 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / P.E.M.). Aceita overclock.<string id='BSModTag'/>"
	BSRotary30Overclock = "Canhão Rotativo Pesado 30 mm (Overclocking)"
	BSRotary30OverclockDesc = "Vendaval: sem o regulador, os sete canos chegam a 16,8 disparos/s em 4 s e a arma uiva 'BRRRRT'. Produz calor ao disparar."
	BSNaval155 = "Canhão Naval Duplo 155 mm"
	BSNaval155Icon = "Trovão"
	BSNaval155Desc = "Torre naval dupla de 155 mm. Artilharia de longo alcance para naves capitais. \"Trovão\"\n\nFim de jogo - arma de convés. Alcance 520 m. Não usa energia: 5 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / P.E.M.). Aceita overclock.<string id='BSModTag'/>"
	BSNaval155Overclock = "Canhão Naval Duplo 155 mm (Overclocking)"
	BSNaval155OverclockDesc = "Supercarga: cargas de pólvora dobradas e o soquete no manual; os dois canos se alternam a cada 0,96 s e as granadas chegam a 598 m. Produz calor ao disparar."
	BSPlasmaHeavy = "Canhão de Plasma Pesado"
	BSPlasmaHeavyIcon = "Curupira"
	BSPlasmaHeavyDesc = "Um canhão de plasma pesado que lança disparos ofuscantes a distâncias extremas. Quebra escudos. \"Curupira\"\n\nFim de jogo - arma de convés. Alcance 550 m. Não usa energia: 4 tripulantes e células de plasma. Aceita overclock.<string id='BSModTag'/>"
	BSPlasmaHeavyOverclock = "Canhão de Plasma Pesado (Overclocking)"
	BSPlasmaHeavyOverclockDesc = "Erupção Solar: os disparos são comprimidos até estourar no impacto; 600 m de alcance e um respingo incandescente que atinge as peças em volta. Produz calor ao disparar."
	BSNukeHowitzer = "Obuseiro Nuclear de Convés"
	BSNukeHowitzerIcon = "Boiúna"
	BSNukeHowitzerDesc = "Obuseiro nuclear. Muito lento, muito barulhento, e nada sobrevive à explosão. Os projéteis podem ser abatidos. \"Boiúna\"\n\nFim de jogo - arma de convés. Alcance 600 m. Não usa energia: 6 tripulantes e projéteis nucleares. Aceita overclock.<string id='BSModTag'/>"
	BSNukeHowitzerOverclock = "Obuseiro Nuclear de Convés (Overclocking)"
	BSNukeHowitzerOverclockDesc = "Fat Boy: carga de rendimento reforçado; um cogumelo maior e mais brilhante e um projétil mais rápido. Produz calor ao disparar."
	BSNaval406 = "Torre Naval Tripla 406 mm"
	BSNaval406Icon = "Mapinguari"
	BSNaval406Desc = "A coroa da nave capitânia: uma torre tripla de 406 mm de encouraçado que dispara salvas completas. \"Mapinguari\"\n\nFim de jogo - arma de convés. Alcance 600 m. Não usa energia: 10 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / P.E.M.). Aceita overclock.<string id='BSModTag'/>"
	BSNaval406Overclock = "Torre Naval Tripla 406 mm (Overclocking)"
	BSNaval406OverclockDesc = "Bordada Total: os três canhões em ciclo de emergência; uma salva a cada 2,25 s e a nave capitânia inteira balança. Produz calor ao disparar."
	BSFlakLight = "Flak Leve de Convés"
	BSFlakLightIcon = "Tatu"
	BSFlakLightDesc = "Flak leve que explode perto dos projéteis que chegam, destruindo vários de uma vez. \"Tatu\"\n\nInício de jogo - arma de convés. Alcance 180 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Atacar + Defender.<string id='BSModTag'/>"
	BSCiws = "CIWS de Convés"
	BSCiwsIcon = "Tamanduá"
	BSCiwsDesc = "Sistema de defesa de curto alcance: um canhão rotativo guiado por radar que enche o céu de flak. \"Tamanduá\"\n\nMeio de jogo - arma de convés. Alcance 250 m. Não usa energia: 2 tripulantes e carregadores padrão. Aceita overclock.\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Atacar + Defender.<string id='BSModTag'/>"
	BSCiwsOverclock = "CIWS de Convés (Overclocking)"
	BSCiwsOverclockDesc = "Barragem: o canhão rotativo gira no máximo; um tapete de 6,5 explosões aéreas por segundo, ao custo de 1,3 carregador por segundo. Produz calor ao disparar."
	BSFlakHeavy = "Bateria Flak Pesada"
	BSFlakHeavyIcon = "Pororoca"
	BSFlakHeavyDesc = "Bateria dupla de flak pesada: uma muralha de fogo contra mísseis, torpedos, granadas e disparos. \"Pororoca\"\n\nFim de jogo - arma de convés. Alcance 320 m. Não usa energia: 4 tripulantes e carregadores padrão. Aceita overclock.\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Atacar + Defender.<string id='BSModTag'/>"
	BSFlakHeavyOverclock = "Bateria Flak Pesada (Overclocking)"
	BSFlakHeavyOverclockDesc = "Muralha de Flak: rajadas mais rápidas, e cada explosão deixa uma nuvem de estilhaços que fica no ar e destrói o que passar por ela: a pororoca na frente da nave capitânia. Produz calor ao disparar."
	BSFactoryMagStd = "Prensa de Carregadores"
	BSFactoryMagStdIcon = "Carregadores Padrão"
	BSFactoryMagStdDesc = "Transforma 5 <string id='Resource/BulletPlural'/> (não usa energia) em 1 <string id='Resource/BSMagStd'/> a cada 1,25 s. +25% de velocidade para cada fábrica vizinha. Aceita overclock.\n\nDica: 2 Fábricas de munição para canhão alimentam 1 Prensa de Carregadores.<string id='BSModTag'/>"
	BSFactoryMagStdOverclock = "Prensa de Carregadores (Overclocking)"
	BSFactoryMagStdOverclockDesc = "Produz 3 vezes mais rápido. Produz calor enquanto fabrica <string id='Resource/BSMagStdPlural'/>."
	BSFactoryMagAp = "Prensa de Carregadores Perfurantes"
	BSFactoryMagApIcon = "Carregadores Perfurantes"
	BSFactoryMagApDesc = "Transforma 2 <string id='Resource/BSMagStdPlural'/> + 0,1 <string id='Resource/Tristeel'/> e 0,2 de energia em 2 <string id='Resource/BSMagApPlural'/> a cada 4 s. +25% de velocidade para cada fábrica vizinha. Aceita overclock.<string id='BSModTag'/>"
	BSFactoryMagApOverclock = "Prensa de Carregadores Perfurantes (Overclocking)"
	BSFactoryMagApOverclockDesc = "Produz 3 vezes mais rápido, com 1,5 vez a energia por item. Produz calor enquanto fabrica <string id='Resource/BSMagApPlural'/>."
	BSFactoryMagEmp = "Energizador de Carregadores P.E.M."
	BSFactoryMagEmpIcon = "Carregadores P.E.M."
	BSFactoryMagEmpDesc = "Transforma 2 <string id='Resource/BSMagStdPlural'/> + 0,25 <string id='Resource/Copper'/> e 0,4 de energia em 2 <string id='Resource/BSMagEmpPlural'/> a cada 4 s. +25% de velocidade para cada fábrica vizinha. Aceita overclock.<string id='BSModTag'/>"
	BSFactoryMagEmpOverclock = "Energizador de Carregadores P.E.M. (Overclocking)"
	BSFactoryMagEmpOverclockDesc = "Produz 3 vezes mais rápido, com 1,5 vez a energia por item. Produz calor enquanto fabrica <string id='Resource/BSMagEmpPlural'/>."
	BSFactoryPlasma = "Fábrica de Células de Plasma"
	BSFactoryPlasmaIcon = "Células de Plasma"
	BSFactoryPlasmaDesc = "Transforma 0,5 <string id='Resource/Sulfur'/> + 0,25 <string id='Resource/Coil'/> e 0,4 de energia em 1 <string id='Resource/BSPlasmaCell'/> a cada 2 s. +25% de velocidade para cada fábrica vizinha. Aceita overclock.<string id='BSModTag'/>"
	BSFactoryPlasmaOverclock = "Fábrica de Células de Plasma (Overclocking)"
	BSFactoryPlasmaOverclockDesc = "Produz 3 vezes mais rápido, com 1,5 vez a energia por item. Produz calor enquanto fabrica <string id='Resource/BSPlasmaCellPlural'/>."
	BSFactoryShellNuke = "Fundição de Projéteis Nucleares"
	BSFactoryShellNukeIcon = "Projéteis Nucleares"
	BSFactoryShellNukeDesc = "Transforma 0,125 <string id='Resource/EnrichedUranium'/> + 2 <string id='Resource/BSMagStdPlural'/> e 0,8 de energia em 1 <string id='Resource/BSShellNuke'/> a cada 8 s. +25% de velocidade para cada fábrica vizinha. Aceita overclock.<string id='BSModTag'/>"
	BSFactoryShellNukeOverclock = "Fundição de Projéteis Nucleares (Overclocking)"
	BSFactoryShellNukeOverclockDesc = "Produz 3 vezes mais rápido, com 1,5 vez a energia por item. Produz calor enquanto fabrica <string id='Resource/BSShellNukePlural'/>."
	BSMslBox = "Caixa de Micromísseis de Convés"
	BSMslBoxIcon = "Tocandira"
	BSMslBoxDesc = "Uma caixa de micromísseis estilo RAM: o atirador gira a caixa e doze micromísseis saem chiando, de dois em dois. \"Tocandira\"\n\nInício de jogo - lança-mísseis de convés. Com todas as células carregadas, dispara 12 mísseis em sequência em 0,73 s; depois um autocarregador tripulado recarrega um cassete por vez (1,39 s cada; sem tripulação no posto a recarga para): uma salva a cada 9,1 s. Alcance 300 m. Mísseis: Muriçoca (alto-explosivo), Taturana-mirim (napalm).\n\nNão usa energia: 1 tripulante e <string id='Resource/MissilePartHEPlural'/> / <string id='Resource/MissilePartThermalPlural'/> do jogo base levadas até os paióis internos (12 peças cada). Trocar o tipo de míssil custa uma recarga completa; se o paiol ficar vazio por uma recarga inteira, as células já carregadas disparam mesmo assim. Os mísseis passam por cima do próprio convés e podem ser abatidos pelos pontos de defesa. Carregado, o lançador explode quando pega fogo ou é destruído.<string id='BSModTag'/>"
	BSMslBoxAmmo = "Peças de Míssil da Tocandira"
	BSMslBoxAmmoDesc = "Libera as <string id='Resource/MissilePartHEPlural'/> e as <string id='Resource/MissilePartThermalPlural'/> do jogo base que a Caixa de Micromísseis de Convés \"Tocandira\" dispara. No modo Construir e Batalhar o lançador já vem liberado, mas as peças de míssil não."
	BSMslTwin = "Lançador Duplo de Mísseis de Convés"
	BSMslTwinIcon = "Caipora"
	BSMslTwinDesc = "Dois casulos octogonais ladeiam uma cúpula blindada com olho sensor; com as células cheias, vem um rufar de dezesseis mísseis em dois segundos, o casulo direito primeiro. \"Caipora\"\n\nMeio de jogo - lança-mísseis de convés. Com todas as células carregadas, dispara 16 mísseis em sequência em 2 s; depois um autocarregador tripulado recarrega uma célula por vez (1,06 s cada; sem tripulação no posto a recarga para): uma salva a cada 19 s. Alcance 400 m. Mísseis: Jararaca (alto-explosivo), Piranha (submunições), Carrapato (grudento), Taturana (napalm), Poraquê (P.E.M.), Boto (torpedo com iscas). Mísseis por salva: Jararaca, Piranha, Carrapato, Taturana, Poraquê 16; Boto 2.\n\nNão usa energia: 2 tripulantes e <string id='Resource/MissilePartHEPlural'/> / <string id='Resource/MissilePartThermalPlural'/> / <string id='Resource/MissilePartEMPPlural'/> do jogo base levadas até os paióis internos (64 peças cada). Trocar o tipo de míssil custa uma recarga completa; se o paiol ficar vazio por uma recarga inteira, as células já carregadas disparam mesmo assim. Os mísseis passam por cima do próprio convés e podem ser abatidos pelos pontos de defesa. Carregado, o lançador explode quando pega fogo ou é destruído. Aceita overclock.<string id='BSModTag'/>"
	BSMslTwinOverclock = "Lançador Duplo de Mísseis de Convés (Overclocking)"
	BSMslTwinOverclockDesc = "\"Fúria da Caipora\": o autocarregador trabalha 1,5 vez mais rápido (Poraquê: 1,2 vez); a cadência da salva, o dano e o alcance não mudam. Custa 425 de calor por peça de míssil carregada mais 100 de calor/s (precisa de radiador). Cerca de 1 em cada 16 mísseis é descartado do paiol a cada salva (torpedos isentos). Se as células já estavam cheias na troca de míssil, a primeira salva espera a recarga normal (sem overclock). O paiol esvazia mais rápido. Desligar o overclock dá uma pausa de 3 s. Sem refrigeração suficiente, esquenta, pega fogo e explode junto com o estoque."
	BSMslQuad = "Bateria Pesada de Mísseis Quádrupla"
	BSMslQuadIcon = "Mula-sem-Cabeça"
	BSMslQuadDesc = "Um corpo blindado sem cabeça carrega quatro casulos longos em braços hidráulicos: um estouro de 48 mísseis pesados em três segundos. Carregada, é a peça mais perigosa da sua nave. \"Mula-sem-Cabeça\"\n\nFim de jogo - lança-mísseis de convés. Com todas as células carregadas, dispara 48 mísseis em sequência em 3,13 s; depois um autocarregador tripulado recarrega uma célula por vez (0,26 s cada; sem tripulação no posto a recarga para): uma salva a cada 15,8 s. Alcance 600 m. Mísseis: Jararaca (alto-explosivo), Piranha (submunições), Carrapato (grudento), Taturana (napalm), Poraquê (P.E.M.), Boto (torpedo com iscas), Iara (torpedo nuclear). Mísseis por salva: Jararaca 48; Piranha, Carrapato, Taturana, Poraquê 16; Boto 4; Iara 2.\n\nNão usa energia: 8 tripulantes e <string id='Resource/MissilePartHEPlural'/> / <string id='Resource/MissilePartThermalPlural'/> / <string id='Resource/MissilePartEMPPlural'/> / <string id='Resource/MissilePartNukePlural'/> do jogo base levadas até os paióis internos (A.E. 192, T. 192, P.E.M. 96, nuclear 32 peças). Trocar o tipo de míssil custa uma recarga completa; se o paiol ficar vazio por uma recarga inteira, as células já carregadas disparam mesmo assim. Os mísseis passam por cima do próprio convés e podem ser abatidos pelos pontos de defesa. Carregado, o lançador explode quando pega fogo ou é destruído. Aceita overclock.\n\nLimite: 2 por nave, junto com o obuseiro nuclear Boiúna (armas nucleares, em qualquer combinação).<string id='BSModTag'/>"
	BSMslQuadOverclock = "Bateria Pesada de Mísseis Quádrupla (Overclocking)"
	BSMslQuadOverclockDesc = "\"Estouro da Boiada\": o autocarregador trabalha 1,5 vez mais rápido (Poraquê: 1,2 vez); a cadência da salva, o dano e o alcance não mudam. Nunca acelera a recarga do torpedo nuclear Iara. Custa 400 de calor por peça de míssil carregada mais 150 de calor/s (precisa de radiador). Cerca de 1 em cada 16 mísseis é descartado do paiol a cada salva (torpedos isentos). Se as células já estavam cheias na troca de míssil, a primeira salva espera a recarga normal (sem overclock). O paiol esvazia mais rápido. Desligar o overclock dá uma pausa de 3 s. Sem refrigeração suficiente, esquenta, pega fogo e explode junto com o estoque."
}
PartToggles
{
	BSAmmo_Std = "<b>Munição: Padrão</b>\n\nMunição versátil. Os canhões disparam granadas explosivas que estouram no impacto. Usa <string id='Resource/BSMagStdPlural'/>."
	BSAmmo_AP = "<b>Munição: Perfurante</b>\n\nPenetradores endurecidos que atravessam blindagem (a blindagem resiste só 60% do normal) e destroem o que está atrás, com metade do dano em cada peça depois da primeira. Fracos contra escudos. Usa <string id='Resource/BSMagApPlural'/>."
	BSAmmo_APHE = "<b>Munição: Perfurante-Explosiva</b>\n\nAtravessa uma ou duas placas de blindagem e então detona DENTRO do casco inimigo. Usa <string id='Resource/BSMagApPlural'/>."
	BSAmmo_APHEName = "Munição Perfurante-Explosiva"
	BSAmmo_APHEDesc = "Atravessa uma ou duas placas de blindagem e então detona DENTRO do casco inimigo. Usa <string id='Resource/BSMagApPlural'/>."
	BSAmmo_EMP = "<b>Munição: P.E.M.</b>\n\nCada acerto drena a energia de escudos e peças energizadas. Menos dano ao casco, mas ótima contra naves que dependem de energia e escudos. Usa <string id='Resource/BSMagEmpPlural'/>."
	BSMissile_He = "<b>Míssil: Jararaca / Muriçoca (Alto-Explosivo)</b>\n\nOgiva alto-explosiva rápida e direta: o míssil de referência. Salvas grandes saturam os pontos de defesa."
	BSMissile_Cluster = "<b>Míssil: Piranha (Submunições)</b>\n\nAbre a 25 m do casco inimigo (ou no impacto, ou no fim do voo) e solta um cardume de minimísseis que se espalham por várias peças. Abatido antes de abrir, não solta nada."
	BSMissile_ClusterName = "Mísseis Piranha (submunições)"
	BSMissile_ClusterDesc = "Abre a 25 m do casco inimigo (ou no impacto, ou no fim do voo) e solta um cardume de minimísseis que se espalham por várias peças. Abatido antes de abrir, não solta nada."
	BSMissile_Limpet = "<b>Míssil: Carrapato (Grudento)</b>\n\nGruda no casco e explode 2,5 s depois, com alta chance de matar a tripulação que vier consertar. Abatido no voo, se perde; num escudo só estoura."
	BSMissile_LimpetName = "Mísseis Carrapato (grudento)"
	BSMissile_LimpetDesc = "Gruda no casco e explode 2,5 s depois, com alta chance de matar a tripulação que vier consertar. Abatido no voo, se perde; num escudo só estoura."
	BSMissile_Napalm = "<b>Míssil: Taturana / Taturana-mirim (Napalm)</b>\n\nExplosão pequena, fogo garantido na peça atingida e calor em volta que continua acendendo incêndios. Inútil contra blindagem; extintor e espuma são o contra."
	BSMissile_NapalmName = "Mísseis Taturana / Taturana-mirim (napalm)"
	BSMissile_NapalmDesc = "Explosão pequena, fogo garantido na peça atingida e calor em volta que continua acendendo incêndios. Inútil contra blindagem; extintor e espuma são o contra."
	BSMissile_Emp = "<b>Míssil: Poraquê (P.E.M.)</b>\n\nDrena baterias e escudos em área e continua drenando as peças com energia por alguns segundos. As armas do Bullet Strike não usam bateria e são imunes."
	BSMissile_EmpName = "Mísseis Poraquê (P.E.M.)"
	BSMissile_EmpDesc = "Drena baterias e escudos em área e continua drenando as peças com energia por alguns segundos. As armas do Bullet Strike não usam bateria e são imunes."
	BSMissile_Torpedo = "<b>Míssil: Boto (Torpedo com Iscas)</b>\n\nTorpedo lento e resistente: 1,5 s depois do lançamento a ogiva se separa no meio de iscas que gastam os pontos de defesa e a flak."
	BSMissile_TorpedoName = "Mísseis Boto (torpedo com iscas)"
	BSMissile_TorpedoDesc = "Torpedo lento e resistente: 1,5 s depois do lançamento a ogiva se separa no meio de iscas que gastam os pontos de defesa e a flak."
	BSMissile_Nuclear = "<b>Míssil: Iara (Torpedo Nuclear)</b>\n\nSó na bateria pesada. Conta no limite nuclear (2 por nave, junto com a Boiúna) e o overclock nunca acelera a recarga. Sozinho morre para flak de área: esconda-o com uma salva pesada logo depois."
