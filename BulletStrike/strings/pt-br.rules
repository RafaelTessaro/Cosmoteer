	BSAmmo_StdDesc = "Munição versátil. Os canhões disparam granadas explosivas que estouram no impacto."
	BSAmmo_AP = "<b>Munição: Perfurante</b>\n\nPenetradores endurecidos que atravessam blindagem (a blindagem conta pela metade) e destroem o que está atrás. Fracos contra escudos."
	BSAmmo_APName = "Carregadores: Perfurante"
	BSAmmo_APDesc = "Penetradores endurecidos que atravessam blindagem (a blindagem conta pela metade) e destroem o que está atrás. Fracos contra escudos."
	BSAmmo_APHE = "<b>Munição: Perfurante-Explosiva</b>\n\nAtravessa uma ou duas placas de blindagem e então detona DENTRO do casco inimigo."
	BSAmmo_APHEName = "Carregadores: Perfurante-Explosiva"
	BSAmmo_APHEDesc = "Atravessa uma ou duas placas de blindagem e então detona DENTRO do casco inimigo."
	BSAmmo_EMP = "<b>Munição: EMP</b>\n\nCada acerto drena bateria de escudos e partes energizadas. Menos dano ao casco, mas ótima contra naves que dependem de energia e escudos."
	BSAmmo_EMPName = "Carregadores: EMP"
	BSAmmo_EMPDesc = "Cada acerto drena bateria de escudos e partes energizadas. Menos dano ao casco, mas ótima contra naves que dependem de energia e escudos."
}
