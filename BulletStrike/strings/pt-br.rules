Resource
{
	BSMagStd = "Carregador Padrão"
	BSMagStdPlural = "Carregador Padrãos"
	BSMagStdDesc = "Um carregador lacrado que a tripulação leva até as armas do Bullet Strike. Cada arma o abre em vários disparos. Munição do Bullet Strike."
	BSMagAp = "Carregador Perfurante"
	BSMagApPlural = "Carregador Perfurantes"
	BSMagApDesc = "Um carregador lacrado que a tripulação leva até as armas do Bullet Strike. Cada arma o abre em vários disparos. Munição do Bullet Strike."
	BSMagEmp = "Carregador EMP"
	BSMagEmpPlural = "Carregador EMPs"
	BSMagEmpDesc = "Um carregador lacrado que a tripulação leva até as armas do Bullet Strike. Cada arma o abre em vários disparos. Munição do Bullet Strike."
	BSPlasmaCell = "Célula de Plasma"
	BSPlasmaCellPlural = "Célula de Plasmas"
	BSPlasmaCellDesc = "Uma célula de plasma selada magneticamente para armas de plasma. Munição do Bullet Strike."
