BSModTag = "\n<s16><gray>Mod: Bullet Strike</gray></s16>"
EditorGroups
{
	BulletStrike = "Bullet Strike"
}
Parts
{
	BSLmg = "Metralhadora Leve de Convés"
	BSLmgIcon = "Marimbondo"
	BSLmgDesc = "Metralhadora barata em reparo de pino. Pequena o bastante para caber em qualquer canto do convés. \"Marimbondo\"\n\nInício de jogo - arma de convés. Alcance 220 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSHmg = "Metralhadora Pesada de Convés"
	BSHmgIcon = "Mangangá"
	BSHmgDesc = "Metralhadora pesada que mantém um fluxo constante de traçantes no alvo. \"Mangangá\"\n\nInício de jogo - arma de convés. Alcance 240 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSAutocannon20 = "Canhão Automático de Convés 20 mm"
	BSAutocannon20Icon = "Carcará"
	BSAutocannon20Desc = "Autocanhão duplo de 20 mm: os primeiros dentes de verdade de uma canhoneira. \"Carcará\"\n\nInício de jogo - arma de convés. Alcance 250 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).<string id='BSModTag'/>"
	BSQuadHmg = "Metralhadora Pesada Quádrupla"
	BSQuadHmgIcon = "Saci"
	BSQuadHmgDesc = "Metralhadora pesada que mantém um fluxo constante de traçantes no alvo. \"Saci\"\n\nMeio de jogo - arma de convés. Alcance 300 m. Não usa energia: 2 tripulantes e carregadores. Aceita overclock.<string id='BSModTag'/>"
	BSQuadHmgOverclock = "Metralhadora Pesada Quádrupla (Overclocking)"
	BSQuadHmgOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSMinigun = "Minigun de Convés"
	BSMinigunIcon = "Cigarra"
	BSMinigunDesc = "Seis canos girando. Leva alguns segundos para acelerar e depois transforma o alvo em sucata. \"Cigarra\"\n\nMeio de jogo - arma de convés. Alcance 300 m. Não usa energia: 2 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSMinigunOverclock = "Minigun de Convés (Overclocking)"
	BSMinigunOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNaval76 = "Canhão Naval Automático 76 mm"
	BSNaval76Icon = "Tambor"
	BSNaval76Desc = "Um canhão naval automático: não é o mais rápido, mas cada 'tum' entrega uma granada pesada. \"Tambor\"\n\nMeio de jogo - arma de convés. Alcance 340 m. Não usa energia: 3 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSNaval76Overclock = "Canhão Naval Automático 76 mm (Overclocking)"
	BSNaval76OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSPlasmaGatling = "Gatling de Plasma"
	BSPlasmaGatlingIcon = "Boitatá"
	BSPlasmaGatlingDesc = "Dispara rajadas de plasma superaquecido que rasgam escudos. \"Boitatá\"\n\nMeio de jogo - arma de convés. Alcance 320 m. Não usa energia: 2 tripulantes e células de plasma. Aceita overclock.<string id='BSModTag'/>"
	BSPlasmaGatlingOverclock = "Gatling de Plasma (Overclocking)"
	BSPlasmaGatlingOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSRotary30 = "Canhão Rotativo Pesado 30 mm"
	BSRotary30Icon = "Furacão"
	BSRotary30Desc = "Canhão rotativo de 30 mm. Demora para acelerar, devastador quando acelera. \"Furacão\"\n\nFim de jogo - arma de convés. Alcance 500 m. Não usa energia: 4 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSRotary30Overclock = "Canhão Rotativo Pesado 30 mm (Overclocking)"
	BSRotary30OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNaval155 = "Canhão Naval Duplo 155 mm"
	BSNaval155Icon = "Trovão"
	BSNaval155Desc = "Torre naval dupla de 155 mm. Artilharia de longo alcance para naves capitais. \"Trovão\"\n\nFim de jogo - arma de convés. Alcance 520 m. Não usa energia: 5 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSNaval155Overclock = "Canhão Naval Duplo 155 mm (Overclocking)"
	BSNaval155OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSPlasmaHeavy = "Canhão de Plasma Pesado"
	BSPlasmaHeavyIcon = "Curupira"
	BSPlasmaHeavyDesc = "Um canhão de plasma pesado que lança disparos ofuscantes a distâncias extremas. Quebra escudos. \"Curupira\"\n\nFim de jogo - arma de convés. Alcance 550 m. Não usa energia: 4 tripulantes e células de plasma. Aceita overclock.<string id='BSModTag'/>"
	BSPlasmaHeavyOverclock = "Canhão de Plasma Pesado (Overclocking)"
	BSPlasmaHeavyOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNukeHowitzer = "Obuseiro Nuclear de Convés"
	BSNukeHowitzerIcon = "Boiúna"
	BSNukeHowitzerDesc = "Obuseiro nuclear. Muito lento, muito barulhento, e nada sobrevive à explosão. Os projéteis podem ser abatidos. \"Boiúna\"\n\nFim de jogo - arma de convés. Alcance 600 m. Não usa energia: 6 tripulantes e projéteis nucleares. Aceita overclock.<string id='BSModTag'/>"
	BSNukeHowitzerOverclock = "Obuseiro Nuclear de Convés (Overclocking)"
	BSNukeHowitzerOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSNaval406 = "Torre Naval Tripla 406 mm"
	BSNaval406Icon = "Mapinguari"
	BSNaval406Desc = "A coroa da nave capitânia: uma torre tripla de 406 mm de encouraçado que dispara salvas completas. \"Mapinguari\"\n\nFim de jogo - arma de convés. Alcance 600 m. Não usa energia: 10 tripulantes e carregadores (selecionáveis: Padrão / Perfurante / Perfurante-Explosiva / EMP). Aceita overclock.<string id='BSModTag'/>"
	BSNaval406Overclock = "Torre Naval Tripla 406 mm (Overclocking)"
	BSNaval406OverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSFlakLight = "Flak Leve de Convés"
	BSFlakLightIcon = "Tatu"
	BSFlakLightDesc = "Flak leve que explode perto dos projéteis que chegam, destruindo vários de uma vez. \"Tatu\"\n\nInício de jogo - arma de convés. Alcance 180 m. Não usa energia: 1 tripulante e munição avulsa (a munição de canhão do jogo).\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Ambos.<string id='BSModTag'/>"
	BSCiws = "CIWS de Convés"
	BSCiwsIcon = "Tamanduá"
	BSCiwsDesc = "Sistema de defesa de curto alcance: um canhão rotativo guiado por radar que enche o céu de flak. \"Tamanduá\"\n\nMeio de jogo - arma de convés. Alcance 250 m. Não usa energia: 2 tripulantes e carregadores padrão. Aceita overclock.\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Ambos.<string id='BSModTag'/>"
	BSCiwsOverclock = "CIWS de Convés (Overclocking)"
	BSCiwsOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSFlakHeavy = "Bateria Flak Pesada"
	BSFlakHeavyIcon = "Pororoca"
	BSFlakHeavyDesc = "Bateria quádrupla de flak pesada: uma muralha de fogo contra mísseis, torpedos, granadas e disparos. \"Pororoca\"\n\nFim de jogo - arma de convés. Alcance 320 m. Não usa energia: 4 tripulantes e carregadores padrão. Aceita overclock.\n\nDEFESA. Flak de explosão aérea que danifica TODOS os mísseis, minas, granadas, disparos laser e iônicos dentro da explosão. Pode ser ajustada para Defender, Atacar ou Ambos.<string id='BSModTag'/>"
	BSFlakHeavyOverclock = "Bateria Flak Pesada (Overclocking)"
	BSFlakHeavyOverclockDesc = "Atira mais rápido e mais forte, mas gera muito calor. Gera calor residual ao disparar."
	BSFactoryMagStd = "Prensa de Carregadores"
	BSFactoryMagStdIcon = "Prensa de Carregad"
	BSFactoryMagStdDesc = "Transforma 5 bullet (não usa energia) em 1 Carregador Padrão a cada 1.25 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryMagAp = "Prensa de Carregadores Perfurantes"
	BSFactoryMagApIcon = "Prensa de Carregad"
	BSFactoryMagApDesc = "Transforma 2 bs_mag_std + 0.1 tristeel e 0.2 de energia em 2 Carregador Perfurante a cada 4 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryMagEmp = "Carregadora de Carregadores EMP"
	BSFactoryMagEmpIcon = "Carregadora de Car"
	BSFactoryMagEmpDesc = "Transforma 2 bs_mag_std + 0.25 copper e 0.4 de energia em 2 Carregador EMP a cada 4 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryPlasma = "Fábrica de Células de Plasma"
	BSFactoryPlasmaIcon = "Fábrica de Células"
	BSFactoryPlasmaDesc = "Transforma 0.5 sulfur + 0.25 coil e 0.4 de energia em 1 Célula de Plasma a cada 2 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
	BSFactoryShellNuke = "Fundição de Projéteis Nucleares"
	BSFactoryShellNukeIcon = "Fundição de Projét"
	BSFactoryShellNukeDesc = "Transforma 0.125 enriched_uranium + 2 bs_mag_std e 0.8 de energia em 1 Projétil Nuclear a cada 8 s. +25% de velocidade para cada fábrica vizinha.<string id='BSModTag'/>"
}
PartToggles
