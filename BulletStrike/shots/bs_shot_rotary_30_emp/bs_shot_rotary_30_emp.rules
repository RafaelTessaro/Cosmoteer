						"./Data/shots/disruptor_bolt/sounds/disruptor_impact_01.wav"
						"./Data/shots/disruptor_bolt/sounds/disruptor_impact_02.wav"
						"./Data/shots/disruptor_bolt/sounds/disruptor_impact_03.wav"
						"./Data/shots/disruptor_bolt/sounds/disruptor_impact_04.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 30
				}
			]
			MediaEffectsScale = 1
		}
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 250
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
				{
					Type = ResourceDrain
					ResourceType = battery
