// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: 30mm Heavy Rotary Cannon - emp

STAT_DAMAGE = 250
STAT_PENETRATION = 1
ID = "rafaeltessaro.bs_shot_rotary_30_emp"
Range = 500
IdealRange = [150, &~/Range]
IdealRadius = [5, 50]
Speed = 300
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.1
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 250
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		Penetration = 1
		PenetrationSpeed = 25
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational
		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
