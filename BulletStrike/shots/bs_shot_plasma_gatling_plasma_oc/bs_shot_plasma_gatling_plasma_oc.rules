// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Plasma Gatling - plasma (overclock)

STAT_DAMAGE = 240
STAT_PENETRATION = 0
ID = "rafaeltessaro.bs_shot_plasma_gatling_plasma_oc"
Range = 352
IdealRange = [106, &~/Range]
IdealRadius = [5, 50]
Speed = 312
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.1
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 200
		TargetCategory = "laser"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		FriendlyShipLowCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational
		HitShield
		{
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 555
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 240
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.heat
					StatusValue = 15
					ApplyToAllHitPartTiles = true
					DivideValueByPartArea = true
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance
					{
						BaseValue = 0.08
						EffectScaleExponent = 1
					}
					ValueType = Interpolated
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_railgun/particles/bullet_hit_railgun.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_railgun_sparks.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_flash_railgun.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/bullet_railgun/sounds/railgun_impact_01.wav"
						"./Data/shots/bullet_railgun/sounds/railgun_impact_02.wav"
						"./Data/shots/bullet_railgun/sounds/railgun_impact_03.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 30
				}
			]
		}
		HitStructural
		{
			Offset = [0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 60
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 2.5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_railgun/particles/bullet_hit_struct_railgun.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_hit_struct_railgun_sparks.rules>
			]
		}
		PenetratingOperational
		{
		}
		PenetratingStructural : &HitStructural
		{
			StructuralDamageRetentionPerHit = 50%
			MinStructuralDamageScale = 3%
		}
		FinishedPenetratingOperational
		{
		}
		FinishedPenetratingStructural
		{
		}
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [0.72, 0.288]
			VertexColor = [120, 255, 255]
			TargetBlendMode = Add
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-0.375, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3, 1.5]
			VertexColor = [0, 255, 220]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
