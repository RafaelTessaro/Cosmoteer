// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Heavy Plasma Cannon - plasma (overclock)

STAT_DAMAGE = 6480
STAT_PENETRATION = 0
ID = "rafaeltessaro.bs_shot_plasma_heavy_plasma_oc"
Range = 600
IdealRange = [180, &~/Range]
IdealRadius = [5, 50]
Speed = 227
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.45
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 3000
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = [&<./Data/shots/flak_large/particles/flak_large_flash.rules>]
		}
	}
	Hit
	{
		Type = SimpleHit
		FriendlyShipLowCollisions = false
		HitOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 4320
						EffectScaleExponent = 1
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 2160
						EffectScaleExponent = 1
					}
					Radius = 2
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 30
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_railgun/particles/bullet_hit_railgun.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_railgun_sparks.rules>
				&<./Data/shots/bullet_railgun/particles/bullet_flash_railgun.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/bullet_railgun/sounds/railgun_impact_01.wav"
						"./Data/shots/bullet_railgun/sounds/railgun_impact_02.wav"
						"./Data/shots/bullet_railgun/sounds/railgun_impact_03.wav"
					]
					Volume = 1
					SpeedVariation = 0.2
					MaxConcurrent = 8
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.08
					Duration = 0.5
				}
			]
		}
		HitStructural = &HitOperational
		HitCrew = &HitOperational
		CrewCollisions = {Enemies=true; Junk=true}
		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 9720
						EffectScaleExponent = 1
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 4860
						EffectScaleExponent = 1
					}
					Radius = 2
					Filter
					{
						Ships = true
						Shields = true
					}
				}
			]
			MediaEffects = &../HitOperational/MediaEffects
		}
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [4.2, 1.68]
			VertexColor = [120, 255, 255]
			TargetBlendMode = Add
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-2, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [16, 8]
			VertexColor = [0, 255, 220]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}
	Trail
	{
		Type = MediaEffects
		MediaEffects = [&<./Data/shots/bullet_railgun/particles/bullet_trail_railgun.rules>]
	}
}
