// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Deck Minigun - ap

STAT_DAMAGE = 68
STAT_PENETRATION = 10
ID = "rafaeltessaro.bs_shot_minigun_ap"
Range = 300
IdealRange = [90, &~/Range]
IdealRadius = [5, 50]
Speed = 320
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.1
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 80
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		Penetration = 10
		PenetrationSpeed = 25
		FriendlyShipLowCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational
		PartCategoryPenetrationFactors
		{
			armor = 50%
		}
		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 51
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 68
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/particles/chaingun_sparks.rules>
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_01.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_02.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_03.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_04.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_05.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 30
				}
			]
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 17
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 2.5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects = [&<./Data/shots/chaingun_shot/particles/chaingun_sparks.rules>]
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 68
						EffectScaleExponent = 1
					}
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance
					{
						BaseValue = 0.0075
						EffectScaleExponent = 1
					}
					ValueType = Interpolated
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects = &../HitOperational/MediaEffects
		}
		PenetratingStructural : &HitStructural
		{
			StructuralDamageRetentionPerHit = 50%
			MinStructuralDamageScale = 3%
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "./Data/shots/bullet_med/bullet_med.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [0.18, 0.18]
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-0.375, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3, 1.5]
			VertexColor = [200, 225, 255]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}
}
