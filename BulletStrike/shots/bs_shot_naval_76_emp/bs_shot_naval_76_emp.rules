// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: 76mm Naval Automatic Cannon - emp

STAT_DAMAGE = 1125
STAT_PENETRATION = 1
ID = "rafaeltessaro.bs_shot_naval_76_emp"
Range = 340
IdealRange = [102, &~/Range]
