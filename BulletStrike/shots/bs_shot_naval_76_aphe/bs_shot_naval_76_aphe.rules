					[
						"./Data/shots/bullet_large/sounds/large_cannon_impact_01.wav"
						"./Data/shots/bullet_large/sounds/large_cannon_impact_02.wav"
						"./Data/shots/bullet_large/sounds/large_cannon_impact_03.wav"
					]
					Volume = 0.8
					SpeedVariation = 0.2
					MaxConcurrent = 12
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.05
					Duration = 0.5
				}
			]
			MediaEffectsScale = 0.9
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 281
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 2.5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_large/particles/bullet_hit_large.rules>
				&<./Data/shots/bullet_large/particles/bullet_hit_large_sparks.rules>
				&<./Data/shots/bullet_large/particles/bullet_smoke_large.rules>
				&<./Data/shots/bullet_large/particles/bullet_flash_large.rules>
			]
			MediaEffectsScale = 0.9
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 1125
						EffectScaleExponent = 1
					}
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance
					{
						BaseValue = 0.375
						EffectScaleExponent = 1
					}
					ValueType = Interpolated
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_large/particles/bullet_hit_large.rules>
				&<./Data/shots/bullet_large/particles/bullet_hit_large_sparks.rules>
				&<./Data/shots/bullet_large/particles/bullet_smoke_large.rules>
				&<./Data/shots/bullet_large/particles/bullet_flash_large.rules>
				: /BASE_SOUNDS/AudioExterior
