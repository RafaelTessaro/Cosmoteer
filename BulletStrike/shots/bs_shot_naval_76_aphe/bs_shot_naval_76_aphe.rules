		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 1800
						EffectScaleExponent = 1
					}
					Radius = 1.5
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 40%
