// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: 76mm Naval Automatic Cannon - aphe

STAT_DAMAGE = 1125
STAT_PENETRATION = 10
ID = "rafaeltessaro.bs_shot_naval_76_aphe"
Range = 340
IdealRange = [102, &~/Range]
IdealRadius = [5, 50]
Speed = 170
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.3
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 1000
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		Penetration = 10
		PenetrationSpeed = 25
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational
		PartCategoryPenetrationFactors
		{
			armor = 75%
		}
		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 2400
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_large/particles/bullet_flash_large.rules>
				&<./Data/shots/bullet_large/particles/bullet_hit_large_sparks.rules>
				&<./Data/shots/missile_nuke/particles/missile_nuke_shockwave.rules>
				&<./Data/shots/missile_he/particles/missile_he_hit.rules>
				&<./Data/shots/missile_he/particles/missile_he_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/bullet_large/sounds/large_cannon_impact_01.wav"
						"./Data/shots/bullet_large/sounds/large_cannon_impact_02.wav"
						"./Data/shots/bullet_large/sounds/large_cannon_impact_03.wav"
					]
					Volume = 0.8
					SpeedVariation = 0.2
					MaxConcurrent = 12
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.05
					Duration = 0.5
				}
			]
			MediaEffectsScale = 0.5
		}
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 1125
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
