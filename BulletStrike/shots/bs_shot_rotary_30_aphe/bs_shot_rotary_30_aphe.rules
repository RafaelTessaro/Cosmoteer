// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: 30mm Heavy Rotary Cannon - aphe

STAT_DAMAGE = 250
STAT_PENETRATION = 8
ID = "rafaeltessaro.bs_shot_rotary_30_aphe"
Range = 500
IdealRange = [150, &~/Range]
IdealRadius = [5, 50]
Speed = 300
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.15
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 250
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		Penetration = 8
		PenetrationSpeed = 25
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational
		PartCategoryPenetrationFactors
		{
			armor = 75%
		}
		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 480
						EffectScaleExponent = 1
					}
				}
				{
