					{
						BaseValue = 0.0625
						EffectScaleExponent = 1
					}
					ValueType = Interpolated
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/particles/chaingun_hit.rules>
				&<./Data/shots/chaingun_shot/particles/chaingun_sparks.rules>
