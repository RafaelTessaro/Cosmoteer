// Projetil: 406mm Triple Naval Turret - ap

STAT_DAMAGE = 12800
STAT_PENETRATION = 28
ID = "rafaeltessaro.bs_shot_naval_406_ap"
Range = 600
IdealRange = [180, &~/Range]
