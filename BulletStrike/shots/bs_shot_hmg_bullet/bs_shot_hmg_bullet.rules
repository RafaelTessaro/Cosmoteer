// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Heavy Deck Machine Gun - bullet

STAT_DAMAGE = 90
STAT_PENETRATION = 3
ID = "rafaeltessaro.bs_shot_hmg_bullet"
Range = 240
IdealRange = [72, &~/Range]
IdealRadius = [5, 50]
Speed = 280
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.1
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 100
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		Penetration = 3
		PenetrationSpeed = 25
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational
		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
