						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 2.5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/particles/chaingun_sparks.rules>
				&<./Data/shots/chaingun_shot/particles/chaingun_hit_flash.rules>
			]
			MediaEffectsScale = 0.75
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true
			HitEffects
			[
				{
					Type = Damage
