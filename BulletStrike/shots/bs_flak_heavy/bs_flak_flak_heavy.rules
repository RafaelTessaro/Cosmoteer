// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: bs_flak_flak_heavy

STAT_DAMAGE = 4000
STAT_RADIUS = 7
STAT_LASER_DAMAGE = 8000
STAT_LASER_RADIUS = 9
Range = 320
IdealRange = 288
ClipRangeToTarget = true
RandomOffsetRadius = [1, 4]
FriendlyShipLowCollisions = false
FriendlyShipHighCollisions = false
HitNothing
{
	HitEffects
	[
		{
			Type = ExplosiveDamage
			TotalDamage
			{
				BaseValue = 4000
				EffectScaleExponent = 1
			}
			Radius = 7
			Slices = 1
			Filter
			{
				Ships = false
				Shields = false
				Bullets = true
				OnlyBulletCategories = [missile, mine, bullet]
				Crew = true
			}
		}
		{
			Type = ExplosiveDamage
			TotalDamage
			{
				BaseValue = 8000
				EffectScaleExponent = 1
			}
			Radius = 9
			Slices = 1
			Filter
			{
				Ships = false
				Shields = false
				Bullets = true
				OnlyBulletCategories = [laser, ion_shot]
				Crew = false
			}
		}
	]
	MediaEffects
	[
		&<./Data/shots/flak_large/particles/flak_large_flash.rules>
		&<./Data/shots/flak_large/particles/flak_large_smoke.rules>
		&<../bs_cal_fx/bs_cal_shr_h_100.rules>
		: /BASE_SOUNDS/AudioExterior
		{
			RandomSounds
			[
				"./Data/shots/flak_large/sounds/flak_cannon_impact_01.wav"
				"./Data/shots/flak_large/sounds/flak_cannon_impact_02.wav"
				"./Data/shots/flak_large/sounds/flak_cannon_impact_03.wav"
				"./Data/shots/flak_large/sounds/flak_cannon_impact_04.wav"
			]
			Volume = 0.4
			SpeedVariation = 0.25
			MaxConcurrent = 12
		}
		: /BASE_SHAKE
		{
			ShakeAmount = 0.03
			Duration = 0.3
		}
	]
	MediaEffectsScale = 1.3
}
HitShield = &HitNothing
HitOperational = &HitNothing
HitStructural = &HitNothing
