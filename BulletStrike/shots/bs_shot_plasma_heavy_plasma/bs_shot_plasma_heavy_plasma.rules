	}
	Crackle
	{
		Type = MediaEffects
		Offset = [-0.62, 0]
		MediaEffects = [&<../bs_plasma_fx/bs_pfx_heavy_crackle.rules>]
	}
	Trail
	{
		Type = MediaEffects
		MediaEffects = [&<../bs_plasma_fx/bs_pfx_heavy_trail.rules>]
