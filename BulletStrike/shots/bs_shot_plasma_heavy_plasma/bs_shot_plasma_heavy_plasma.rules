// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Heavy Plasma Cannon - plasma

STAT_DAMAGE = 3600
STAT_PENETRATION = 0
ID = "rafaeltessaro.bs_shot_plasma_heavy_plasma"
Range = 550
IdealRange = [165, &~/Range]
IdealRadius = [5, 50]
Speed = 200
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.3
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 2500
		TargetCategory = "laser"
		OnDeath
		{
			MediaEffects
			[
				&<../bs_plasma_fx/bs_pfx_heavy_hit_shield.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_01.wav"
						"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_02.wav"
						"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_03.wav"
						"./Data/shots/laser_bolt_small/sounds/laser_blaster_impact_04.wav"
					]
					Volume = 0.36
					SpeedVariation = 0.2
					MaxConcurrent = 8
				}
			]
		}
	}
	Hit
	{
		Type = PenetratingHit
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational
		HitShield
		{
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 9600
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<../bs_plasma_fx/bs_pfx_heavy_hit_shield.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/laser_bolt_large/laser_bolt_large_hit.wav"]
					Volume = 0.8
					SpeedVariation = 0.2
					MaxConcurrent = 12
				}
			]
		}
		HitOperational
		{
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 3600
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.heat
					StatusValue = 300
					ApplyToAllHitPartTiles = true
					DivideValueByPartArea = true
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance
					{
						BaseValue = 0.25
						EffectScaleExponent = 1
					}
					ValueType = Interpolated
				}
			]
			MediaEffects
			[
				&<../bs_plasma_fx/bs_pfx_heavy_hit_splash.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_sparks.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_flash.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_scorch.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/laser_bolt_large/laser_bolt_large_hit.wav"]
					Volume = 0.8
					SpeedVariation = 0.2
					MaxConcurrent = 12
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.04
					Duration = 0.5
				}
			]
		}
		HitStructural
		{
			Offset = [0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 900
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 2.5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<../bs_plasma_fx/bs_pfx_heavy_hit_struct.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_sparks.rules>
				&<../bs_plasma_fx/bs_pfx_heavy_hit_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/laser_bolt_large/laser_bolt_large_hit.wav"]
