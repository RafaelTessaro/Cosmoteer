// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Cluster Missile (Transformer) (Piranha) - Caipora

STAT_DAMAGE = 6300
STAT_RADIUS = 1.75
STAT_CHILDREN = 4
STAT_CHILD_DAMAGE = 1575
STAT_CHILD_HP = 300
STAT_BURST_RANGE = 25
ID = "rafaeltessaro.bs_msl_twin_cluster"
Range = 400
IdealRange = 400
Speed = 45
CHILD = &<bs_msl_twin_cluster_child.rules>
BURST
{
	HitEffects
	[
		{
			Type = SpawnBullets
			Bullet = &~/CHILD
			Count = 4
			Distance = [0, 0.8]
			Arc = [-25d, 50d]
			Spread = [-5d, 5d]
			InheritVelocity = false
			HealthFactor
			{
				BaseValue = 1
				EffectScaleExponent = 1
			}
		}
	]
	MediaEffectsScale = 0.7
	MediaEffects
	[
		&<./Data/shots/missile_he/particles/missile_he_flash.rules>
		&<./Data/shots/missile_he/particles/missile_he_smoke.rules>
		&<../bs_missile_fx/burst_cluster.rules>
		&<./Data/shots/missile_thermal/particles/missile_thermal_shrapnel.rules>
		: /BASE_SOUNDS/AudioExterior
		{
			RandomSounds
			[
				"./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
				"./Data/shots/missile_he/sounds/launcher_rocket_impact_02.wav"
				"./Data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"
			]
			Volume = 0.77
			SpeedVariation = 0.15
			MaxConcurrent = 16
		}
	]
}
Components
{
	Physics
	{
		Type = BoxPhysics
		Size = [1.2, 0.4]
		Density = 0.1
	}
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 230d
		Delay = 0.15
		VelocityCompensation = 60%
	}
	Retarget
	{
		Type = SameShipRetarget
	}
	Acceleration
	{
		Type = Acceleration
		Acceleration = 65
	}
	NegativeAcceleration
	{
		Type = Acceleration
		Acceleration = [-90, 0]
		AccelerationOverTime = [0, 0.75]
		Direction = FrameOfReferenceVelocity
	}
	ProximityFuse
	{
		Type = DeathByEnemyProximity
		Interval = 0.05
		Range = 25
		StartDelay = 0.4
		DetectsShips = true
		DetectsBullets = false
		FactorEffectsWith = Targetable
		OnDeath = &~/BURST
	}
	TimedFuse
	{
		Type = DeathByLifetime
		Lifetime = 11
		FactorEffectsWith = Targetable
		OnDeath = &~/BURST
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		IsLit = true
		Sprite
		{
			Texture
			{
				File = "../bs_missile_art/msl_cluster_m.png"
				MipLevels = max
			}
			Size = [1.75, 0.75]
		}
		NormalsTexture
		{
			File = "../bs_missile_art/msl_cluster_m_normals.png"
			MipLevels = max
		}
	}
	LightsSprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper4
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "../bs_missile_art/msl_cluster_m_lights.png"
					MipLevels = max
					SampleMode = Linear
				}
				Size = [1.75, 0.75]
				TargetBlendMode = Add
			}
			FrameCount = 3
			FrameSize = [112, 48]
			FramesPerRow = 3
			FramesPerSecond = 8
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-0.86, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3.6, 1.76]
			VertexColor = [255, 228, 92]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}
	MediaEffects
	{
		Type = MediaEffects
		Offset = [-0.86, 0]
		Rotation = 180d
		MediaEffects
		[
			&<../bs_missile_fx/smoke_grey_25_s80.rules>
			&<../bs_missile_fx/plume_cluster_m.rules>
			&<../bs_missile_fx/plume_light_cluster.rules>
		]
	}
	Targetable
	{
		Type = Targetable
		Health = 1050
		TargetCategory = "missile"
		OnDeath = &../Hit/HitFriendly
	}
	Hit
	{
		Type = SimpleHit
		SourcePartCollisionDelay = 1.5 / (&/Simulation/PhysicsUpdatesPerSecond)
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		FactorEffectsWith = Targetable
		HitShield = &~/BURST
		HitOperational = &~/BURST
		HitStructural = &~/BURST
		HitFriendly
		{
			MediaEffectsScale = 0.7
			MediaEffects
			[
				&<./Data/shots/missile_he/particles/missile_he_flash.rules>
				&<./Data/shots/missile_he/particles/missile_he_smoke.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_02.wav"
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"
					]
					Volume = 0.77
					SpeedVariation = 0.15
					MaxConcurrent = 16
				}
			]
		}
	}
}
