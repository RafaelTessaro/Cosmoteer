					MaxConcurrent = 30
				}
			]
			MediaEffectsScale = 0.75
		}
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
