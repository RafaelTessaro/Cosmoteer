// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Cluster Missile (Transformer) (Piranha) - Mula-sem-Cabeça

STAT_DAMAGE = 13500
STAT_RADIUS = 2
STAT_CHILDREN = 6
STAT_CHILD_DAMAGE = 2250
STAT_CHILD_HP = 400
STAT_BURST_RANGE = 25
ID = "rafaeltessaro.bs_msl_quad_cluster"
Range = 600
IdealRange = 600
Speed = 45
CHILD = &<bs_msl_quad_cluster_child.rules>
BURST
{
	HitEffects
	[
		{
			Type = SpawnBullets
			Bullet = &~/CHILD
			Count = 6
			Distance = [0, 0.8]
			Arc = [-25d, 50d]
			Spread = [-5d, 5d]
			InheritVelocity = false
			HealthFactor
			{
				BaseValue = 1
				EffectScaleExponent = 1
			}
		}
	]
	MediaEffects
	[
		&<./Data/shots/missile_he/particles/missile_he_flash.rules>
		&<./Data/shots/missile_he/particles/missile_he_smoke.rules>
		: /BASE_SOUNDS/AudioExterior
		{
			RandomSounds
			[
				"./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
				"./Data/shots/missile_he/sounds/launcher_rocket_impact_02.wav"
				"./Data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"
			]
			Volume = 0.85
			SpeedVariation = 0.15
			MaxConcurrent = 16
		}
	]
}
Components
{
	Physics
	{
		Type = BoxPhysics
		Size = [1.5, 0.5]
		Density = 0.1
	}
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 200d
		Delay = 0.15
		VelocityCompensation = 60%
	}
	Retarget
	{
		Type = SameShipRetarget
	}
	Acceleration
	{
		Type = Acceleration
		Acceleration = 60
	}
	NegativeAcceleration
	{
		Type = Acceleration
		Acceleration = [-90, 0]
		AccelerationOverTime = [0, 0.75]
		Direction = FrameOfReferenceVelocity
	}
	ProximityFuse
	{
		Type = DeathByEnemyProximity
		Interval = 0.05
		Range = 25
		StartDelay = 0.4
		DetectsShips = true
		DetectsBullets = false
		FactorEffectsWith = Targetable
		OnDeath = &~/BURST
	}
	TimedFuse
	{
		Type = DeathByLifetime
		Lifetime = 15
		OnDeath = &~/BURST
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		IsLit = true
		Sprite
		{
			Texture
			{
				File = "./Data/shots/missile_he/missile_he.png"
				MipLevels = max
			}
			Size = [2, 1]
		}
		NormalsTexture
		{
			File = "./Data/shots/missile_he/missile_he_normals.png"
			MipLevels = max
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-0.9, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [4.5, 2.2]
			VertexColor = [255, 228, 92]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}
	MediaEffects
	{
		Type = MediaEffects
		Offset = [-0.9, 0]
		Rotation = 180d
		MediaEffects = [&<./Data/shots/missile_he/particles/missile_he_thruster_plume_light.rules>]
	}
	Targetable
	{
		Type = Targetable
		Health = 2200
		TargetCategory = "missile"
		OnDeath = &../Hit/HitFriendly
	}
	Hit
	{
		Type = SimpleHit
		SourcePartCollisionDelay = 1.5 / (&/Simulation/PhysicsUpdatesPerSecond)
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		HitShield = &~/BURST
		HitOperational = &~/BURST
		HitStructural = &~/BURST
		HitFriendly
		{
			MediaEffects
			[
				&<./Data/shots/missile_he/particles/missile_he_flash.rules>
				&<./Data/shots/missile_he/particles/missile_he_smoke.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_02.wav"
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"
					]
					Volume = 0.85
					SpeedVariation = 0.15
					MaxConcurrent = 16
				}
			]
		}
	}
}
