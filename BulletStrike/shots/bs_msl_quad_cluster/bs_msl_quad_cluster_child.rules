		AccelerateTowardsEnemies = false
	}
	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = 2.5
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		IsLit = true
		Sprite
		{
			Texture
			{
				File = "./Data/shots/missile_he/missile_he.png"
