STAT_DAMAGE = 2250
STAT_RADIUS = 2
ID = "rafaeltessaro.bs_msl_quad_cluster_child"
Range = 100
IdealRange = 100
Speed = 40
Components
{
	Physics
	{
		Type = BoxPhysics
