// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: Napalm Missile (Taturana) - Mula-sem-Cabeça

STAT_DAMAGE = 6000
STAT_RADIUS = 3.5
STAT_HEAT_POOL = 4800
STAT_FIRE_CHANCE = 1
ID = "rafaeltessaro.bs_msl_quad_napalm"
Range = 600
IdealRange = 600
Speed = 45
Components
{
	Physics
	{
		Type = BoxPhysics
		Size = [1.5, 0.5]
		Density = 0.1
	}
	Homing
	{
		Type = TargetHoming
		TurnVelocity = 200d
		Delay = 0.15
		VelocityCompensation = 60%
	}
	Retarget
	{
		Type = SameShipRetarget
	}
	Acceleration
	{
		Type = Acceleration
		Acceleration = 60
	}
	NegativeAcceleration
	{
		Type = Acceleration
		Acceleration = [-90, 0]
		AccelerationOverTime = [0, 0.75]
		Direction = FrameOfReferenceVelocity
	}
	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = 15
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		IsLit = true
		Sprite
		{
			Texture
			{
				File = "../bs_missile_art/msl_napalm_l.png"
				MipLevels = max
			}
			Size = [2.5, 1]
		}
		NormalsTexture
		{
			File = "../bs_missile_art/msl_napalm_l_normals.png"
			MipLevels = max
		}
	}
	LightsSprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper4
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "../bs_missile_art/msl_napalm_l_lights.png"
					MipLevels = max
					SampleMode = Linear
				}
				Size = [2.5, 1]
				TargetBlendMode = Add
			}
			FrameCount = 2
			FrameSize = [160, 64]
			FramesPerRow = 2
			FramesPerSecond = 3
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-1.18, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [4.5, 2.2]
			VertexColor = [255, 106, 26]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}
	MediaEffects
	{
		Type = MediaEffects
		Offset = [-1.18, 0]
		Rotation = 180d
		MediaEffects
		[
			&<../bs_missile_fx/fire_napalm_100.rules>
			&<../bs_missile_fx/smoke_oily_30.rules>
			&<../bs_missile_fx/plume_napalm_l.rules>
			&<../bs_missile_fx/plume_light_napalm.rules>
		]
	}
	Targetable
	{
		Type = Targetable
		Health = 2200
		TargetCategory = "missile"
		OnDeath = &../Hit/HitFriendly
	}
	Hit
	{
		Type = SimpleHit
		SourcePartCollisionDelay = 1.5 / (&/Simulation/PhysicsUpdatesPerSecond)
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		HitShield
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 6000
						EffectScaleExponent = 1
					}
					Radius = 3.5
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.heat
					StatusValue = 480
					ApplyToAllHitPartTiles = true
					DivideValueByPartArea = true
				}
			]
			MediaEffectsScale = 1.1
			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 6000
						EffectScaleExponent = 1
					}
					Radius = 3.5
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance
					{
						BaseValue = 1
						EffectScaleExponent = 1
					}
					StatusValue = 70%
					ValueType = Interpolated
				}
				{
					Type = GridStatusApplication
					StatusType = cosmoteer.heat
					StatusValue = 0
					StatusValuePool = 4800
					ValueFalloff = 1
					MaxCost = 4
					FalloffPadding = 0.5
					EmptyTileCost = 1000
					AllowDiagonals = true
					Filter
					{
						Friendlies = false
						TargetedFriendlies = true
					}
				}
			]
			MediaEffectsScale = 1.1
			MediaEffects
			[
				&<./Data/shots/missile_thermal/particles/missile_thermal_hit_cone.rules>
				&<./Data/shots/missile_thermal/particles/missile_thermal_shockwave.rules>
				&<./Data/shots/missile_thermal/particles/missile_thermal_flash.rules>
				&<./Data/shots/missile_thermal/particles/missile_thermal_shrapnel.rules>
				&<../bs_missile_fx/droplets_napalm.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/missile_thermal/missile_thermal_hit.wav"]
					Volume = 0.85
					SpeedVariation = 0.15
					MaxConcurrent = 16
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.14
					Duration = 0.5
				}
			]
		}
		HitStructural = &HitOperational
		HitFriendly
		{
			MediaEffects
			[
				&<./Data/shots/missile_thermal/particles/missile_thermal_hit_cone.rules>
				&<./Data/shots/missile_thermal/particles/missile_thermal_shockwave.rules>
				&<./Data/shots/missile_thermal/particles/missile_thermal_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["./Data/shots/missile_thermal/missile_thermal_hit.wav"]
					Volume = 0.85
					SpeedVariation = 0.15
					MaxConcurrent = 16
				}
			]
		}
	}
}
