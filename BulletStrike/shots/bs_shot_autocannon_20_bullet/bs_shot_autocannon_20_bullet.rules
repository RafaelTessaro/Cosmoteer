// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Projetil: 20mm Deck Autocannon - bullet

STAT_DAMAGE = 360
STAT_PENETRATION = 3
ID = "rafaeltessaro.bs_shot_autocannon_20_bullet"
Range = 250
IdealRange = [75, &~/Range]
IdealRadius = [5, 50]
Speed = 250
Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.1
		Density = 0.0001
	}
	Death
	{
		Type = DeathByLifetime
	}
	Targetable
	{
		Type = Targetable
		Health = 150
		TargetCategory = "bullet"
		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}
	Hit
	{
		Type = PenetratingHit
		Penetration = 3
		PenetrationSpeed = 25
		FriendlyShipLowCollisions = false
		FriendlyShipHighCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &HitOperational
		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 440
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>
				&<./Data/shots/chaingun_shot/particles/chaingun_sparks.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_01.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_02.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_03.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_04.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_05.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 30
				}
			]
			MediaEffectsScale = 0.8
		}
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 360
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/particles/chaingun_hit.rules>
				&<./Data/shots/bullet_med/particles/bullet_hit_med_sparks.rules>
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_01.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_02.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_03.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_04.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_05.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 30
				}
			]
			MediaEffectsScale = 0.8
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.15, 0]
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 90
						EffectScaleExponent = 1
					}
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 2.5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/particles/chaingun_hit.rules>
				&<./Data/shots/bullet_med/particles/bullet_hit_med_sparks.rules>
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>
			]
			MediaEffectsScale = 0.8
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true
			HitEffects
			[
				{
					Type = Damage
					Damage
					{
						BaseValue = 360
						EffectScaleExponent = 1
					}
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance
					{
						BaseValue = 0.05
						EffectScaleExponent = 1
					}
					ValueType = Interpolated
				}
				{
					Type = Impulse
					Impulse
					{
						BaseValue = 5
						EffectScaleExponent = 1
					}
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/particles/chaingun_hit.rules>
				&<./Data/shots/bullet_med/particles/bullet_hit_med_sparks.rules>
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_01.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_02.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_03.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_04.wav"
						"./Data/shots/chaingun_shot/sounds/chain_gun_impact_05.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 30
				}
			]
			MediaEffectsScale = 0.55
		}
		PenetratingStructural : &HitStructural
		{
			StructuralDamageRetentionPerHit = 50%
			MinStructuralDamageScale = 3%
		}
		FinishedPenetratingOperational
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 80
						EffectScaleExponent = 1
					}
					Radius = 1
				}
			]
			MediaEffects
			[
				&<./Data/shots/chaingun_shot/overclock/particles/chaingun_shot_overclock_hit.rules>
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_01.wav"
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_02.wav"
						"./Data/shots/missile_he/sounds/launcher_rocket_impact_03.wav"
					]
					Volume = 0.5
					SpeedVariation = 0.2
					MaxConcurrent = 20
				}
			]
			MediaEffectsScale = 0.6
		}
		FinishedPenetratingStructural = &PenetratingStructural
	}
	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Offset = [-1.575, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3.6, 0.3]
			VertexColor = [255, 170, 60]
			TargetBlendMode = Add
		}
		LerpScaleFrom = [0.25, 1]
		LerpTime = 0.05
	}
	CoreSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Offset = [-0.455, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [1.3, 0.14]
			VertexColor = [255, 235, 190]
			TargetBlendMode = Add
		}
	}
	HeadSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Offset = [0, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [0.512, 0.512]
			VertexColor = [255, 250, 235]
			TargetBlendMode = Add
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Offset = [-1.44, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [7, 2.6]
			VertexColor = [255, 140, 40]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.2
		}
	}
	Trail
	{
		Type = MediaEffects
		MediaEffects = [&<../bs_trails/bs_trail_med_amber.rules>]
	}
}
