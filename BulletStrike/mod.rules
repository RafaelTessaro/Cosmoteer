// Bullet Strike - armas de convés movidas a munição para Cosmoteer
// Gerado por tools/build_mod.py - edite os dados em tools/bs_data.py e rode o gerador de novo.
// Alvo: Cosmoteer 0.30.4 (estavel) e 0.30.5 (RC). Compativel com Star Wars: A Cosmos Divided.
// ATENCAO: este deve ser o UNICO arquivo chamado mod.rules / mod_*.rules no mod.

ID = rafaeltessaro.bullet_strike
Name = "Bullet Strike"
Version = 1.0.0
CompatibleGameVersions = ["0.30.4", "0.30.4a", "0.30.4b", "0.30.4c", "0.30.5"]
UseThisFileIfNoVersionMatch = true
ModifiesGameplay = true
Author = "Rafael Tessaro"
Logo = "logo.png"
Description = "Armas de convés operadas pela tripulação que usam MUNIÇÃO em vez de energia.\n\n- 15 armas e 3 lança-mísseis de convés com 7 tipos de míssil, do início ao fim de jogo.\n- Início de jogo: metralhadoras, autocanhão de 20 mm, flak leve e a caixa de micromísseis Tocandira.\n- Meio de jogo: metralhadora quádrupla, minigun, canhão naval de 76 mm, gatling de plasma, CIWS e o lançador de mísseis Caipora, todos com overclock.\n- Fim de jogo: canhão rotativo de 30 mm, canhão naval duplo de 155 mm, plasma pesado, flak pesada, obuseiro nuclear, torre tripla de 406 mm e a bateria de mísseis Mula-sem-Cabeça, todos com overclock.\n- Flak e CIWS que destroem vários mísseis, minas, granadas e disparos de uma vez, mas gastam muita munição.\n- Logística de carregadores: 5 fábricas novas, todas com overclock; a tripulação leva os carregadores até as armas. Os lança-mísseis usam as peças de míssil do jogo base.\n- Seletor de munição: Padrão, Perfurante, Perfurante-Explosiva e P.E.M., além de células de plasma e projéteis nucleares.\n- Limites por nave: 2 armas nucleares (Boiúna e Mula-sem-Cabeça) e 2 torres de encouraçado.\n\nCompatível com Star Wars: A Cosmos Divided.\n\n---\n\nDeck-mounted, crew-operated weapons that run on AMMUNITION instead of power.\n\n- 15 weapons and 3 deck missile launchers with 7 missile types, from early to late game.\n- Early game: machine guns, 20 mm autocannon, light flak and the Tocandira micro-missile box.\n- Mid game: quad machine gun, minigun, 76 mm naval cannon, plasma gatling, CIWS and the Caipora missile launcher, all with overclock.\n- Late game: 30 mm rotary cannon, twin 155 mm naval gun, heavy plasma, heavy flak, nuclear howitzer, triple 406 mm turret and the Mula-sem-Cabeça missile battery, all with overclock.\n- Flak and CIWS that shred many missiles, mines, shells and bolts at once, but eat ammo.\n- Magazine logistics: 5 new factories, all with overclock; crew carry the magazines to the guns. The missile launchers use the vanilla missile parts.\n- Ammo selector: Standard, Armor-Piercing, AP-Explosive and EMP, plus plasma cells and nuclear shells.\n- Per-ship limits: 2 nuclear weapons (Boiúna and Mula-sem-Cabeça) and 2 battleship turrets.\n\nCompatible with Star Wars: A Cosmos Divided."
StringsFolder = "strings"
Actions
[
	{
		Action = Overrides
		OverrideIn = "<gui/game/designer/editor_groups.rules>"
		Overrides
		{
			BulletStrike
			{
				NameKey = "EditorGroups/BulletStrike"
				Icon
				{
					Texture
					{
						File = "gui/group_bullet_strike.png"
						MipLevels = 2
						SampleMode = Linear
					}
				}
				SortOrder = 250
			}
		}
	}
	{
		Action = AddMany
		AddTo = "<resources/resources.rules>/Resources"
		ManyToAdd
		[
			&<resources/bs_mag_std/bs_mag_std.rules>
			&<resources/bs_mag_ap/bs_mag_ap.rules>
			&<resources/bs_mag_emp/bs_mag_emp.rules>
			&<resources/bs_plasma_cell/bs_plasma_cell.rules>
			&<resources/bs_shell_nuke/bs_shell_nuke.rules>
		]
	}
	{
		Action = AddMany
		AddTo = "<ships/terran/terran.rules>/Terran/Parts"
		ManyToAdd
		[
			&<parts/bs_lmg/bs_lmg.rules>/Part
			&<parts/bs_hmg/bs_hmg.rules>/Part
			&<parts/bs_autocannon_20/bs_autocannon_20.rules>/Part
			&<parts/bs_quad_hmg/bs_quad_hmg.rules>/Part
			&<parts/bs_minigun/bs_minigun.rules>/Part
			&<parts/bs_naval_76/bs_naval_76.rules>/Part
			&<parts/bs_plasma_gatling/bs_plasma_gatling.rules>/Part
			&<parts/bs_rotary_30/bs_rotary_30.rules>/Part
			&<parts/bs_naval_155/bs_naval_155.rules>/Part
			&<parts/bs_plasma_heavy/bs_plasma_heavy.rules>/Part
			&<parts/bs_nuke_howitzer/bs_nuke_howitzer.rules>/Part
			&<parts/bs_naval_406/bs_naval_406.rules>/Part
			&<parts/bs_flak_light/bs_flak_light.rules>/Part
			&<parts/bs_ciws/bs_ciws.rules>/Part
			&<parts/bs_flak_heavy/bs_flak_heavy.rules>/Part
			&<parts/bs_factory_mag_std/bs_factory_mag_std.rules>/Part
			&<parts/bs_factory_mag_ap/bs_factory_mag_ap.rules>/Part
			&<parts/bs_factory_mag_emp/bs_factory_mag_emp.rules>/Part
			&<parts/bs_factory_plasma/bs_factory_plasma.rules>/Part
			&<parts/bs_factory_shell_nuke/bs_factory_shell_nuke.rules>/Part
			&<parts/bs_msl_box/bs_msl_box.rules>/Part
			&<parts/bs_msl_twin/bs_msl_twin.rules>/Part
			&<parts/bs_msl_quad/bs_msl_quad.rules>/Part
		]
	}
	{
		Action = AddMany
		AddTo = "<gui/game/parts/part_stats.rules>/PartStats"
		ManyToAdd = &<gui/bs_part_stats.rules>/PartStats
	}
	{
		Action = AddMany
		AddTo = "<gui/game/parts/part_toggles.rules>/PartToggles"
		ManyToAdd = &<gui/bs_part_toggles.rules>/PartToggles
	}
	{
		Action = AddMany
		AddTo = "<modes/career/techs.rules>/Techs"
		ManyToAdd = &<techs/bs_techs_career.rules>/Techs
	}
	{
		Action = AddMany
		AddTo = "<modes/pvp/pvp_buildbattle/techs_buildbattle.rules>/Techs"
		ManyToAdd = &<techs/bs_techs_buildbattle.rules>/Techs
	}
	{
		Action = AddMany
		AddTo = "<modes/pvp/pvp_buildbattle/techs_buildbattle.rules>/PartsWhitelist"
		ManyToAdd = &<techs/bs_techs_buildbattle.rules>/PartsWhitelist
	}
	{
		Action = Add
		AddTo = "<ships/terran/terran.rules>/Terran"
		Name = CategoryLimits
		OnlyIfNotExisting = true
		ToAdd = []
	}
	{
		Action = AddMany
		AddTo = "<ships/terran/terran.rules>/Terran/CategoryLimits"
		ManyToAdd
		[
			{
				Category = "bs_limit_nuke"
				Max = 2
			}
			{
				Category = "bs_limit_flagship"
				Max = 2
			}
		]
	}
	{
		Action = AddMany
		AddTo = "<ships/terran/terran.rules>/Terran/CategoryNouns"
		ManyToAdd
		[
			{
				Category = bs_limit_nuke
				SingularKey = "CategoryNouns/BSLimitNukeSingular"
				PluralKey = "CategoryNouns/BSLimitNukePlural"
			}
			{
				Category = bs_limit_flagship
				SingularKey = "CategoryNouns/BSLimitFlagshipSingular"
				PluralKey = "CategoryNouns/BSLimitFlagshipPlural"
			}
		]
	}
]
