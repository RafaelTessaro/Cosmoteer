			Trigger = StunTrigger
			HitEffects
			[
				{
					Type = AreaCrewStun
					Duration
					{
						BaseValue = 0.25
						BuffType = Overclock
						BuffMode = Lerp
						MinValue = &BaseValue
						MaxValue = &~/OVERCLOCK/CREW_STUN_DURATION
					}
					Falloff = 1
					Radius
					{
						BaseValue = 3
						BuffType = Overclock
						BuffMode = Lerp
						MinValue = &BaseValue
						MaxValue = &~/OVERCLOCK/CREW_STUN_RADIUS
					}
					Filter
					{
						Friendlies = true
						IgnoreInvulnerability = true
					}
					Cumulative = true
					HitShipOnly = true
