// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Arma: 76mm Naval Automatic Cannon / Canhão Naval Automático 76 mm

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 0.6667
	HALF_SPREAD = 1.5d
	RECOIL_FACTOR = 160%
	HEAT_PER_SHOT = 500
	HEAT_PER_SECOND = 80
	CREW_STUN_DURATION = 0.375
	CREW_STUN_RADIUS = 3.9
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 0.6
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSNaval76"
	IconNameKey = "Parts/BSNaval76Icon"
	DescriptionKey = "Parts/BSNaval76Desc"
	ID = rafaeltessaro.bs_naval_76
	EditorGroups = ["BulletStrike", "WeaponsProjectile"]
	Resources = [[steel, 120], [coil2, 20], [tristeel, 20]]
	Size = [3, 4]
	SelectionPriority = 1
	MaxHealth = 18000
	TypeCategories = [weapon, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-2, -2, 7, 2]]
		[tall, [-2, 0, 2, 4]]
		[tall, [3, 0, 2, 4]]
	]
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[-1, 3]
		[3, 0]
		[3, 1]
		[3, 2]
		[3, 3]
		[0, 4]
		[1, 4]
		[2, 4]
		[0, -1]
		[1, -1]
		[2, -1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [46, 92]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 5
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, { Toggle=IsOverclocked; Invert=true }]
			Mode = All
		}
		// ---- municao (carregadores abertos em N tiros) ----
		AmmoTypeToggle
		{
			Type = UIToggle
			ToggleID = "bs_ammo_type"
			Default = 0
			AlwaysAllowInBuildMode = true
		}
		ModeToggle_0
		{
			Type = ModeToggle
			Mode = AmmoTypeToggle
			OnMode = 0
		}
		ConsumeToggle_0
		{
			Type = MultiToggle
			Toggles = [CommandConsumptionToggle, ModeToggle_0]
			Mode = All
		}
		MagStorage_0
		{
			Type = ResourceStorage
			ResourceType = rafaeltessaro.bs_mag_std
			MaxResources = 18
			UITileRect = [0 + 7/64, 3 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
