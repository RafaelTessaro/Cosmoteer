// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Fabrica: Plasma Cell Factory / Fábrica de Células de Plasma

OVERCLOCK
{
	HEAT_PER_CONVERSION = 733
	SPEED_FACTOR = 300%
	POWER_USE_FACTOR = 150%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
Part : <./Data/ships/terran/base_med_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSFactoryPlasma"
	IconNameKey = "Parts/BSFactoryPlasmaIcon"
	DescriptionKey = "Parts/BSFactoryPlasmaDesc"
	ID = rafaeltessaro.bs_factory_plasma
	EditorGroups = ["BulletStrike", "Production"]
	Resources = [[steel, 80], [coil2, 40], [processor, 2]]
	Size = [3, 3]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 9000
	TypeCategories = [provides_ammo, uses_sulfur, uses_coils, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	BlockedTravelCells = [[0, 0], [1, 0], [2, 0], [1, 1]]
	ForceManhattanPathInPart = true
	AllowedDoorLocations = [[-1, 1], [-1, 2], [0, 3], [1, 3], [2, 3], [3, 2], [3, 1]]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles
			[
				PowerToggle
				NonJunkToggle
				ScorchedToggle
				Input0Splitter
				Input1Splitter
				BatteryStorage
				&~/Part/^/0/OVERCLOCK_OPERATIONAL
			]
			Mode = All
		}
		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
			IncludeWhenUnderConstruction = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}
		Input0
		{
			Type = TypedResourceGrid
			ResourceType = sulfur
			GridRect = [0, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			AllowExternalPickupAndDelivery = true
		}
		Input0Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = sulfur
			Storage = Input0
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		Input0Splitter
		{
			Type = InlineResourceConverter
			ResourceType = sulfur
			FromStorage = Input0
			FromQuantity = 1
			ToQuantity = 2
		}
		Input1
		{
			Type = TypedResourceGrid
			ResourceType = coil
			GridRect = [2, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			AllowExternalPickupAndDelivery = true
		}
		Input1Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = coil
			Storage = Input1
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		Input1Splitter
		{
			Type = InlineResourceConverter
			ResourceType = coil
			FromStorage = Input1
			FromQuantity = 1
			ToQuantity = 4
		}
		Output
		{
			Type = TypedResourceGrid
			ResourceType = rafaeltessaro.bs_plasma_cell
			GridRect = [0, 2, 3, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -0.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 4000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = CommandConsumptionToggle
		}
		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
				{
					Storage = Input0Splitter
					Quantity = 1
				}
				{
					Storage = Input1Splitter
					Quantity = 1
				}
				{
					Storage = BatteryStorage
					Quantity
					{
						BaseValue = 400
						Modifiers
						[
							: ~/MODIFIERS/OVERCLOCK_LERP
							{
								MinValue = &../../BaseValue
								MaxValue = (&MinValue) * (&~/OVERCLOCK/POWER_USE_FACTOR)
							}
						]
					}
					MinQuantityForConversion = 1
				}
			]
			ToStorage = Output
			ToQuantity = 1
			Interval
			{
				BaseValue = 2
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Divide
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}
		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [1.5, 1.5]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInteriorDetail
				{
					RandomSounds
					[
						"./Data/ships/terran/factory_he/sounds/missile_factory_putdown_01.wav"
						"./Data/ships/terran/factory_he/sounds/missile_factory_putdown_02.wav"
						"./Data/ships/terran/factory_he/sounds/missile_factory_putdown_03.wav"
						"./Data/ships/terran/factory_he/sounds/missile_factory_putdown_04.wav"
						"./Data/ships/terran/factory_he/sounds/missile_factory_putdown_05.wav"
					]
					Volume = 1
					Db = -2
					Speed = 1
					SpeedVariation = 0.05
				}
			]
		}
		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}
		// ---- overclock (factory_he.rules l.261-318 e l.1332-1354) ----
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [1.5, 1.5]
		}
		Port_Thermal_L1 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_L2 : Port_Thermal_L1
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_R1 : Port_Thermal_L1
		{
			Location = [2, 1]
			Direction = Right
		}
		Port_Thermal_R2 : Port_Thermal_L1
		{
			Location = [2, 2]
			Direction = Right
		}
		Port_Thermal_D0 : Port_Thermal_L1
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_D1 : Port_Thermal_L1
		{
			Location = [1, 2]
			Direction = Down
		}
		Port_Thermal_D2 : Port_Thermal_L1
		{
			Location = [2, 2]
			Direction = Down
		}
		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}
		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}
		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion
		{
			Type = StaticValue
			Value = &~/OVERCLOCK/HEAT_PER_CONVERSION
		}
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}
		// ---- graficos (factory_he.rules l.849-959) ----
		BeltSpeedFactor
		{
			Type = BuffableValue
			Value
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
					}
				]
			}
		}
		Graphics
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = IsOperational
			AnimationToggle = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [3, 3]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, 0]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"machine_on1.png"
							"machine_on2.png"
							"machine_on3.png"
							"machine_on4.png"
							"machine_on5.png"
							"machine_on6.png"
							"machine_on7.png"
							"machine_on8.png"
							"machine_on9.png"
							"machine_on10.png"
							"machine_on11.png"
							"machine_on12.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.12
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, 0]
				DamageLevels
				[
					{
						File = "machine_off.png"
						Size = [3, 3]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 3]
					}
					{
						File = "walls_33.png"
						Size = [3, 3]
					}
					{
						File = "walls_66.png"
						Size = [3, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [3, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [3, 3]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, -29/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4, 4]
						Z = 0.5
						VertexColor = [255*1.5, 0, 0]
					}
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 3]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3, 4, 5]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3, 4, 5]
				}
				{
					Toggle = Input0Splitter
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}
				{
					Toggle = Input1Splitter
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOnLarge
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOffLarge
		}
		OperationSoundLoop
		{
			Type = ContinuousEffects
			Location = [1.5, 1.5]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./Data/ships/terran/factory_he/sounds/he_missile_factory_idle.wav"
					Volume = 1
					MaxConcurrentVolume = 1
					Speed = 1
					MaxConcurrent = 1
				}
			]
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &~/Part/Components/DestroyedEffects/Location
			MediaEffects = &~/Part/Components/DestroyedEffects_UnderConstruction/MediaEffects
			HitEffects = &~/Part/Components/DestroyedEffects/HitEffects
			FactorHitEffectsWith = Output
			IncludeWhenUnderConstruction = false
		}
		DestroyedEffects
		{
			Type = DeathEffects
			OperationalToggle = ScorchedToggle
			FactorHitEffectsWith = Output
			Location = [1.5, 1.5]
			IncludeWhenUnderConstruction = false
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 64500
						EffectScaleExponent = 1
					}
					Radius = 5
					Delay = 0.05
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 100%
					StatusValue = 1
					StatusValueType = Interpolated
					NDamage = 1000
					CrewKillChance = 50%
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 20000
						EffectScaleExponent = 1
					}
					Radius = 4
					Delay = 0.05
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
						Crew = false
					}
				}
			]
		}
		DestroyedEffects_UnderConstruction
		{
			Type = DeathEffects
			Location = &~/Part/Components/DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
		}
	}
	Stats
	{
		BSFactoryOutput = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		AmmoCapacity = (&~/Part/Components/Output/GridRect/2) * (&~/Part/Components/Output/GridRect/3) * (&<../../resources/bs_plasma_cell/bs_plasma_cell.rules>/MaxStackSize)
		Input0PerAmmo = (&~/Part/Components/Input0Splitter/FromQuantity) / (&~/Part/Components/Input0Splitter/ToQuantity) / (&~/Part/Components/ResourceConverter/ToQuantity)
		Input0PerSecond = (&~/Part/Components/Input0Splitter/FromQuantity) / (&~/Part/Components/Input0Splitter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		AmmoSulfurUsage = [&../Input0PerAmmo, &../Input0PerSecond]
		Input1PerAmmo = (&~/Part/Components/Input1Splitter/FromQuantity) / (&~/Part/Components/Input1Splitter/ToQuantity) / (&~/Part/Components/ResourceConverter/ToQuantity)
		Input1PerSecond = (&~/Part/Components/Input1Splitter/FromQuantity) / (&~/Part/Components/Input1Splitter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		BSAmmoCoilUsage = [&../Input1PerAmmo, &../Input1PerSecond]
		PowerPerAmmo = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/ToQuantity) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / 1000
		AmmoPowerUsage = [&../PowerPerAmmo, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100
		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/BSFactoryPlasmaOverclockDesc"
		Stats
		{
			BSFactoryOutput = (&~/Part/Stats/BSFactoryOutput) * (&~/OVERCLOCK/SPEED_FACTOR)
			AmmoSulfurUsage
			[
				(&~/Part/Stats/AmmoSulfurUsage/0)
				(&~/Part/Stats/AmmoSulfurUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)
			]
			BSAmmoCoilUsage
			[
				(&~/Part/Stats/BSAmmoCoilUsage/0)
				(&~/Part/Stats/BSAmmoCoilUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)
			]
			POWER_PER_AMMO = (&~/Part/Stats/AmmoPowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			POWER_PER_SECOND = (&~/Part/Stats/AmmoPowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
			AmmoPowerUsage = [&../POWER_PER_AMMO, &../POWER_PER_SECOND]
			AMMO_PER_CONVERSION = (&~/Part/Components/ResourceConverter/ToQuantity)
			HEAT_PER_AMMO = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&AMMO_PER_CONVERSION)
			HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR)
			AmmoHeatGeneration = [&../HEAT_PER_AMMO, &../HEAT_PER_SECOND]
		}
	}
}
MODIFIERS
{
	OVERCLOCK_LERP
	{
		Type = Buff
		BuffType = Overclock
		ModificationMode = Lerp
	}
}
