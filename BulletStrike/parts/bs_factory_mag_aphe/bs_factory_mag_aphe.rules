// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Fabrica: APHE Magazine Line / Linha de Carregadores Perfurante-Explosivos

Part : <./Data/ships/terran/base_large_part_terran.rules>/Part
{
	NameKey = "Parts/BSFactoryMagAphe"
	IconNameKey = "Parts/BSFactoryMagApheIcon"
	DescriptionKey = "Parts/BSFactoryMagApheDesc"
	ID = rafaeltessaro.bs_factory_mag_aphe
	EditorGroups = ["BulletStrike", "Production"]
	Resources = [[steel, 80], [coil2, 24], [tristeel, 6]]
	Size = [4, 2]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 9000
	TypeCategories = [provides_ammo, uses_sulfur, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	BlockedTravelCells = [[0, 0], [1, 0], [2, 0], [3, 0]]
	ForceManhattanPathInPart = true
	AllowedDoorLocations = [[-1, 1], [4, 1], [0, 2], [1, 2], [2, 2], [3, 2]]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 32]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, NonJunkToggle, ScorchedToggle, Input0, Input1, Input2, BatteryStorage]
			Mode = All
		}
		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}
		Input0
		{
			Type = TypedResourceGrid
			ResourceType = bullet
			GridRect = [0, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			ToggleOnResources = 12
			ToggleOffResources = 11
			AllowExternalPickupAndDelivery = true
		}
		Input0Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = bullet
			Storage = Input0
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		Input1
		{
			Type = TypedResourceGrid
			ResourceType = iron
			GridRect = [1, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			ToggleOnResources = 1
			ToggleOffResources = 0
			AllowExternalPickupAndDelivery = true
		}
		Input1Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = iron
			Storage = Input1
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		Input2
		{
			Type = TypedResourceGrid
			ResourceType = sulfur
			GridRect = [2, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			ToggleOnResources = 1
			ToggleOffResources = 0
			AllowExternalPickupAndDelivery = true
		}
		Input2Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = sulfur
			Storage = Input2
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		Output
		{
			Type = TypedResourceGrid
			ResourceType = rafaeltessaro.bs_mag_aphe
			GridRect = [3, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -0.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = CommandConsumptionToggle
		}
		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
				{
					Storage = Input0
					Quantity = 12
				}
				{
					Storage = Input1
					Quantity = 1
				}
				{
					Storage = Input2
					Quantity = 1
				}
				{
					Storage = BatteryStorage
					Quantity = 200
					MinQuantityForConversion = 1
				}
			]
			ToStorage = Output
			ToQuantity = 2
			Interval
			{
				BaseValue = 2
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}
		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [2, 1]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInteriorDetail
				{
					RandomSounds
					[
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_01.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_02.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_03.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_04.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_05.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_06.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_07.wav"
					]
					Volume = 1
					Db = -2
					Speed = 1
					SpeedVariation = 0.05
				}
			]
		}
		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}
		Graphics
		{
			Type = Graphics
			Location = [2, 1]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4, 2]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						AnimationFiles = ["machine_on1.png", "machine_on2.png", "machine_on3.png", "machine_on4.png"]
						Size = [4, 1]
						AnimationInterval = 0.12
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						File = "machine_off.png"
						Size = [4, 1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 2]
					}
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 2]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 1]
			Indicators
			[
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [1, 2, 3, 4]
				}
				{
					Toggle = Input0
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}
				{
					Toggle = Input1
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}
				{
					Toggle = Input2
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOnLarge
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOffLarge
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [2, 1]
		}
	}
	Stats
	{
		BSFactoryOutput = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/3/Quantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / 1000
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
	}
}
