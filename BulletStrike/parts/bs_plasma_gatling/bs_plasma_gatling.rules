// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Arma: Plasma Gatling / Gatling de Plasma

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 0.8696
	HALF_SPREAD = 1.875d
	RECOIL_FACTOR = 160%
	HEAT_PER_SHOT = 70
	HEAT_PER_SECOND = 50
	MAX_SPIN = 2
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 0.2
SPIN
{
	MAX = 2
	UP_TIME = 2
	DOWN_TIME = 1
}
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSPlasmaGatling"
	IconNameKey = "Parts/BSPlasmaGatlingIcon"
	DescriptionKey = "Parts/BSPlasmaGatlingDesc"
	ID = rafaeltessaro.bs_plasma_gatling
	EditorGroups = ["BulletStrike", "WeaponsProjectile"]
	Resources = [[steel, 100], [coil2, 24], [tristeel, 10], [processor, 1]]
	Size = [3, 3]
	SelectionPriority = 1
	MaxHealth = 13500
	TypeCategories = [weapon, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs [RateOfFire]
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-1, -1, 5, 1]]
		[tall, [-1, 0, 1, 3]]
		[tall, [3, 0, 1, 3]]
	]
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[3, 0]
		[3, 1]
		[3, 2]
		[0, 3]
		[1, 3]
		[2, 3]
		[0, -1]
		[1, -1]
		[2, -1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [55.2, 92]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 5
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, { Toggle=IsOverclocked; Invert=true }]
			Mode = All
		}
		// ---- municao (carregadores abertos em N tiros) ----
		MagStorage_0
		{
			Type = ResourceStorage
			ResourceType = rafaeltessaro.bs_plasma_cell
			MaxResources = 8
			UITileRect = [0 + 7/64, 2 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
		Splitter_0
		{
			Type = InlineResourceConverter
			ResourceType = rafaeltessaro.bs_plasma_cell
			FromStorage = MagStorage_0
			FromQuantity = 1
			ToQuantity = 20
		}
		MagConsumer_0
		{
			Type = ResourceConsumer
			ResourceType = rafaeltessaro.bs_plasma_cell
			Storage = MagStorage_0
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		AmmoPrereq
		{
			Type = MultiToggle
			Toggles = [Splitter_0]
			Mode = Any
		}
		// ---- spin-up (chaingun.rules l.191-287) ----
		IsFiringTimer
		{
			Type = Timer
			Duration = 1
			StartTrigger = Turret
			ResetTrigger = Turret
			StartExpired = true
			InvertToggle = true
		}
		IsSpinning
		{
			Type = MultiToggle
			Toggles = [IsFiringTimer, AmmoPrereq]
			Mode = All
		}
		SpinUp
		{
			Type = ValueAccumulator
			AccumulatingToggle = IsSpinning
			MinValue = 1
			BaseValue = &MinValue
			MaxValue
			{
				BaseValue = &~/SPIN/MAX
				Modifiers
				[
					{
						Type = Buff
						BuffType = Overclock
						ModificationMode = Replace
						MinValue = &~/OVERCLOCK/MAX_SPIN
						MaxValue = &MinValue
					}
				]
			}
			AccumulationRate = ((&~/SPIN/MAX) - 1) / (&~/SPIN/UP_TIME)
			DissipationRate = ((&~/SPIN/MAX) - 1) / (&~/SPIN/DOWN_TIME)
		}
		RateOfFireBuff
		{
			Type = SelfBuffProvider
			BuffType = RateOfFire
			BuffAmount = 1
			BuffMultiplier = SpinUp
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [1.5, 1.15]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FireModeToggle
			FireInterval
			{
				BaseValue = &~/FIRE_INTERVAL
				Modifiers
				[
					{
						Type = Buff
						BuffType = RateOfFire
						ModificationMode = Divide
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR)]
					}
				]
			}
			FiringArc = 300d
			RotateSpeed = 75d
			FireThresholdAngle = 2d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = TargetEmitterProxy
			IgnoreFriendlyShipLowLOSChecks = true
			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.15
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
		// ---- emissores: um bloco por tipo de municao (e por estado de overclock) ----
		Fire_0_N
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				TargetEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger
					GetTargetFrom = Turret
					Location = [2.703, 0]
					OperationalToggle = IsOperational
					Bullet = &<../../shots/bs_shot_plasma_gatling_plasma/bs_shot_plasma_gatling_plasma.rules>
					Spread = [-1.5d, 1.5d]
					ResourceStorage = Splitter_0
					ResourcesUsed = 1
					Recoil = 6
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : TargetEmitter
				{
					Location = [2.703, 0]
					FireTrigger = Turret
				}
			}
		}
		Fire_0_OC
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			IncludeInBlueprints = false
			Components
			{
				TargetEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger
					GetTargetFrom = Turret
					Location = [2.703, 0]
					OperationalToggle = IsOperational
					Bullet = &<../../shots/bs_shot_plasma_gatling_plasma_oc/bs_shot_plasma_gatling_plasma_oc.rules>
					Spread = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					ResourceStorage = Splitter_0
					ResourcesUsed = 1
					Recoil = 6 * (&~/OVERCLOCK/RECOIL_FACTOR)
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : TargetEmitter
				{
					Location = [2.703, 0]
					FireTrigger = Turret
				}
			}
		}
		TargetEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = TargetEmitter
			ChainedTo = Turret
		}
		Emitter1Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter1
			ChainedTo = Turret
			Location = [2.703, 0]
		}
		Emitter1Proxy_OC : Emitter1Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter1Proxy_N : Emitter1Proxy_OC
		{
			InvertProxyToggle = true
		}
		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Emitter1Proxy_N
			Trigger = Emitter1Proxy_N
			Location = [-0.2, 0]
			MediaEffects
			[
				&<./Data/ships/terran/chaingun/particles/chaingun_shoot_flash.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck_flare.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/ships/terran/laser_blaster_small/sounds/laser_overclocked_shot_01.wav"
						"./Data/ships/terran/laser_blaster_small/sounds/laser_overclocked_shot_02.wav"
						"./Data/ships/terran/laser_blaster_small/sounds/laser_overclocked_shot_03.wav"
					]
					Volume = 0.7
					SpeedVariation = 0.15
					MaxConcurrent = 30
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.01
					Duration = 0.5
				}
			]
		}
		Overclock_FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Emitter1Proxy_OC
			Trigger = Emitter1Proxy_OC
			Location = [-0.2, 0]
			MediaEffects
			[
				&<./Data/ships/terran/chaingun/particles/chaingun_shoot_flash.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck_flare.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/ships/terran/laser_blaster_small/sounds/laser_overclocked_shot_01.wav"
						"./Data/ships/terran/laser_blaster_small/sounds/laser_overclocked_shot_02.wav"
						"./Data/ships/terran/laser_blaster_small/sounds/laser_overclocked_shot_03.wav"
					]
					Volume = 0.7
					SpeedVariation = 0.15
					MaxConcurrent = 30
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.01
					Duration = 0.5
				}
			]
		}
		// ---- tripulacao ----
		CrewLocation1
		{
			Type = CrewLocation
			Location = [0.75, 2.55]
			Rotation = 0d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [2.25, 2.55]
			Rotation = 0d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [AmmoPrereq]
			CrewDestinations = [&../../CrewLocation1/Location, &../../CrewLocation2/Location]
			CrewLocations = [CrewLocation1, CrewLocation2]
		}
		// ---- overclock (base_part_overclock.rules + cannon_deck.rules l.323-413) ----
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [1.5, 1.5]
		}
		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [Emitter1Proxy]
		}
		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
		Port_Thermal_L0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_L1 : Port_Thermal_L0
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_L2 : Port_Thermal_L0
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_R0 : Port_Thermal_L0
		{
			Location = [2, 0]
			Direction = Right
		}
		Port_Thermal_R1 : Port_Thermal_L0
		{
			Location = [2, 1]
			Direction = Right
		}
		Port_Thermal_R2 : Port_Thermal_L0
		{
			Location = [2, 2]
			Direction = Right
		}
		Port_Thermal_D0 : Port_Thermal_L0
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_D1 : Port_Thermal_L0
		{
			Location = [1, 2]
			Direction = Down
		}
		Port_Thermal_D2 : Port_Thermal_L0
		{
			Location = [2, 2]
			Direction = Down
		}
		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ShotsPerSecond)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
		// ---- graficos ----
		Graphics
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [3, 3]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [3, 3]
					}
				]
			}
		}
		TurretGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "turret_shadow.png"
						Size = [2.3, 2.3]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "turret.png"
						NormalsFile = "turret_normals.png"
						Size = [2.3, 2.3]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "turret_off.png"
						NormalsFile = "turret_normals.png"
						Size = [2.3, 2.3]
					}
				]
			}
		}
		Barrel1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [1.8055, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			ResetAnimationTrigger = Emitter1Proxy
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						AnimationFiles = ["barrel_spin1.png", "barrel_spin2.png", "barrel_spin3.png", "barrel1.png"]
						NormalsAnimationFiles = ["barrel_normals1.png", "barrel_normals1.png", "barrel_normals1.png", "barrel_normals1.png"]
						Size = [0.56, 1.955]
						AnimationInterval = 0.05
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "barrel1.png"
						NormalsFile = "barrel_normals1.png"
						Size = [0.56, 1.955]
					}
				]
			}
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOnLarge
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOffLarge
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1.5]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3, 4]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3, 4]
				}
				{
					Toggle = AmmoPrereq
					Delay = &~/FIRE_INTERVAL
					AtlasSprite
					{
						File = &/INDICATORS/NoAmmo
						Size = [1, 1]
					}
				}
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 3]
		}
	}
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = &~/Part/Components/MagStorage_0/MaxResources
		BSShotsPerMag = &~/Part/Components/Splitter_0/ToQuantity
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/BSAmmo_plasma"
			Stats
			{
				DamagePerShot = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/STAT_DAMAGE
				ShotsPerSecond = 1 * 2.0 / (&~/Part/Components/Turret/FireInterval/BaseValue)
				DamagePerSecond = (&DamagePerShot) * (&ShotsPerSecond)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				Penetration = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/STAT_PENETRATION
				ROF = [1 / (&~/Part/Components/Turret/FireInterval/BaseValue), &../ShotsPerSecond]
				Range = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				Spread = deg(&~/Part/Components/Fire_0_N/Components/TargetEmitter/Spread/1)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Components/Targetable/Health
				AmmoPerShot = (&~/Part/Components/Fire_0_N/Components/TargetEmitter/ResourcesUsed) / (&~/Part/Components/Splitter_0/ToQuantity)
				AmmoPerSecond = (&AmmoPerShot) * (&ShotsPerSecond)
				ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/BSPlasmaGatlingOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/BSAmmo_plasma"
				Stats
				{
					DamagePerShot = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/STAT_DAMAGE
					ShotsPerSecond = 1 * 2.0 / ((&~/Part/Components/Turret/FireInterval/BaseValue) * (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR))
					DamagePerSecond = (&DamagePerShot) * (&ShotsPerSecond)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ROF = &ShotsPerSecond
					Range = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/Range
					Spread = deg(&~/OVERCLOCK/HALF_SPREAD)
					ShotSpeed = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/Speed
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					HeatGeneration = (&~/OVERCLOCK/HEAT_PER_SECOND)
					Penetration = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/STAT_PENETRATION
				}
			}
		]
	}
}
