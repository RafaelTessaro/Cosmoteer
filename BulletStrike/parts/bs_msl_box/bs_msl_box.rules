			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [HasMissiles]
			CrewDestinations = [&../../CrewLocation1/Location]
			CrewLocations = [CrewLocation1]
		}
		// ---- graficos: casulo em roof_doodads, celulas (ResourceSprites) por cima em roof_turrets ----
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [2, 2]
					}
				]
			}
		}
		TurretGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "turret_shadow.png"
						Size = [2.15, 2.15]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"turret1.png"
							"turret2.png"
							"turret3.png"
							"turret4.png"
							"turret5.png"
							"turret6.png"
							"turret7.png"
							"turret8.png"
						]
						NormalsAnimationFiles
						[
							"turret1_normals.png"
							"turret2_normals.png"
							"turret3_normals.png"
							"turret4_normals.png"
							"turret5_normals.png"
							"turret6_normals.png"
							"turret7_normals.png"
							"turret8_normals.png"
						]
						Size = [1.9, 1.9]
						AnimationInterval = 0.12
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						File = "turret_off.png"
						NormalsFile = "turret1_normals.png"
						Size = [1.9, 1.9]
					}
				]
			}
		}
		Light1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [-0.8, 0]
			OperationalToggle = IsOperational
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [1, 1]
						Z = 0.6
						VertexColor = [255, 120, 30]
					}
				]
			}
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3]
				}
				{
					Toggle = HasMissiles
					Delay = &~/MODE_he/RELOAD
					AtlasSprite
					{
						File = &/INDICATORS/NoMissiles
						Size = [1, 1]
					}
				}
				{
