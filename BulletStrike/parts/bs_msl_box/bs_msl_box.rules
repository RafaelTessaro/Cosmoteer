// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Lancador de misseis: Deck Micro-Missile Box / Caixa de Micromísseis de Convés ("Tocandira")

RIPPLE = 4/30
BURST_DELAY = 2/30
MODE_he
{
	CELLS = 6
	PARTS = 1
	MISSILES_PER_UNIT = 2
	RELOAD = 1.39
	VENT = 0
	DRY_DELAY = (&CELLS) * (&RELOAD)
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE) + ((&MISSILES_PER_UNIT) - 1) * (&~/BURST_DELAY)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
}
MODE_napalm
{
	CELLS = 6
	PARTS = 1
	MISSILES_PER_UNIT = 2
	RELOAD = 1.39
	VENT = 0
	DRY_DELAY = (&CELLS) * (&RELOAD)
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE) + ((&MISSILES_PER_UNIT) - 1) * (&~/BURST_DELAY)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
}
