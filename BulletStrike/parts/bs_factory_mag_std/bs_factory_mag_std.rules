// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Fabrica: Magazine Press / Prensa de Carregadores

OVERCLOCK
{
	HEAT_PER_CONVERSION = 250
	SPEED_FACTOR = 300%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
Part : <./Data/ships/terran/base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSFactoryMagStd"
	IconNameKey = "Parts/BSFactoryMagStdIcon"
	DescriptionKey = "Parts/BSFactoryMagStdDesc"
	ID = rafaeltessaro.bs_factory_mag_std
	EditorGroups = ["BulletStrike", "Production"]
	Resources = [[steel, 32], [coil, 24], [tristeel, 4]]
	Size = [2, 2]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 4000
	TypeCategories = [provides_ammo, uses_ammo]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	BlockedTravelCells = [[0, 0], [1, 0]]
	ForceManhattanPathInPart = true
	AllowedDoorLocations = [[-1, 1], [2, 1], [0, 2], [1, 2]]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, NonJunkToggle, ScorchedToggle, Input0, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
			IncludeWhenUnderConstruction = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}
		Input0
		{
			Type = TypedResourceGrid
			ResourceType = bullet
			GridRect = [0, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			AllowExternalPickupAndDelivery = true
			ToggleOnResources = 5
			ToggleOffResources = 4
		}
		Input0Consumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = bullet
			Storage = Input0
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		Output
		{
			Type = TypedResourceGrid
			ResourceType = rafaeltessaro.bs_mag_std
			GridRect = [1, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -0.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}
		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
				{
					Storage = Input0
					Quantity = 5
				}
			]
			ToStorage = Output
			ToQuantity = 1
			Interval
			{
				BaseValue = 1.25
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Divide
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}
		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [1, 1]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInteriorDetail
				{
					RandomSounds
					[
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_01.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_02.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_03.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_04.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_05.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_06.wav"
						"./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_putdown_07.wav"
					]
					Volume = 1
					Db = -2
					Speed = 1
					SpeedVariation = 0.05
				}
			]
		}
		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = CommandConsumptionToggle
		}
		// ---- overclock (factory_he.rules l.261-318 e l.1332-1354) ----
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [1, 1]
		}
		Port_Thermal_L1 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_R1 : Port_Thermal_L1
		{
			Location = [1, 1]
			Direction = Right
		}
		Port_Thermal_D0 : Port_Thermal_L1
		{
			Location = [0, 1]
			Direction = Down
		}
		Port_Thermal_D1 : Port_Thermal_L1
		{
			Location = [1, 1]
			Direction = Down
		}
		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}
		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}
		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion
		{
			Type = StaticValue
			Value = &~/OVERCLOCK/HEAT_PER_CONVERSION
		}
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}
		// ---- graficos (factory_he.rules l.849-959) ----
		BeltSpeedFactor
		{
			Type = BuffableValue
			Value
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
					}
				]
			}
		}
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			AnimationToggle = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, 0]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"machine_on1.png"
							"machine_on2.png"
							"machine_on3.png"
							"machine_on4.png"
							"machine_on5.png"
							"machine_on6.png"
							"machine_on7.png"
							"machine_on8.png"
							"machine_on9.png"
							"machine_on10.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.125
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, 0]
				DamageLevels
				[
					{
						File = "machine_off.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
					{
						File = "walls_33.png"
						Size = [2, 2]
					}
					{
						File = "walls_66.png"
						Size = [2, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [2, 2]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, -17/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [3, 3]
						Z = 0.5
						VertexColor = [255*1.5, 0, 0]
					}
				]
			}
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 2]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3]
				}
				{
					Toggle = Input0
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}
		OperationSoundLoop
		{
			Type = ContinuousEffects
			Location = [1, 1]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./Data/ships/terran/factory_ammo/sounds/cannon_ammo_factory_idle.wav"
					Volume = 1
					MaxConcurrentVolume = 1
					Speed = 1
					MaxConcurrent = 1
				}
			]
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &~/Part/Components/DestroyedEffects/Location
			MediaEffects = &~/Part/Components/DestroyedEffects_UnderConstruction/MediaEffects
			HitEffects = &~/Part/Components/DestroyedEffects/HitEffects
			FactorHitEffectsWith = Output
			IncludeWhenUnderConstruction = false
		}
		DestroyedEffects
		{
			Type = DeathEffects
			OperationalToggle = ScorchedToggle
			FactorHitEffectsWith = Output
			Location = [1, 1]
			IncludeWhenUnderConstruction = false
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 40000
						EffectScaleExponent = 1
					}
					Radius = 4
					Delay = 0.05
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 100%
					StatusValue = 1
					StatusValueType = Interpolated
					NDamage = 1000
					CrewKillChance = 50%
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage
					{
						BaseValue = 11250
						EffectScaleExponent = 1
					}
					Radius = 3
					Delay = 0.05
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
						Crew = false
					}
				}
			]
		}
		DestroyedEffects_UnderConstruction
		{
			Type = DeathEffects
			Location = &~/Part/Components/DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
		}
	}
	Stats
	{
		BSFactoryOutput = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		AmmoCapacity = (&~/Part/Components/Output/GridRect/2) * (&~/Part/Components/Output/GridRect/3) * (&<../../resources/bs_mag_std/bs_mag_std.rules>/MaxStackSize)
		Input0PerAmmo = (&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity)
		Input0PerSecond = (&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		BSAmmoBulletUsage = [&../Input0PerAmmo, &../Input0PerSecond]
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100
	}
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/BSFactoryMagStdOverclockDesc"
		Stats
		{
			BSFactoryOutput = (&~/Part/Stats/BSFactoryOutput) * (&~/OVERCLOCK/SPEED_FACTOR)
			BSAmmoBulletUsage
			[
				(&~/Part/Stats/BSAmmoBulletUsage/0)
				(&~/Part/Stats/BSAmmoBulletUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)
			]
			AMMO_PER_CONVERSION = (&~/Part/Components/ResourceConverter/ToQuantity)
			HEAT_PER_AMMO = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&AMMO_PER_CONVERSION)
			HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR)
			AmmoHeatGeneration = [&../HEAT_PER_AMMO, &../HEAT_PER_SECOND]
		}
	}
}
