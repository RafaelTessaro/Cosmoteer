// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Defesa: Light Deck Flak / Flak Leve de Convés

FIRE_INTERVAL = 0.3333
Part : <./Data/ships/terran/base_med_part_terran.rules>/Part
{
	NameKey = "Parts/BSFlakLight"
	IconNameKey = "Parts/BSFlakLightIcon"
	DescriptionKey = "Parts/BSFlakLightDesc"
	ID = rafaeltessaro.bs_flak_light
	EditorGroups = ["BulletStrike", "Defenses", "WeaponsProjectile"]
	Resources = [[steel, 48], [coil, 16]]
	Size = [2, 2]
	SelectionPriority = 1
	MaxHealth = 8000
	TypeCategories = [defense, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-1, -1, 4, 1]]
		[tall, [-1, 0, 1, 2]]
		[tall, [2, 0, 1, 2]]
	]
	AllowedDoorLocations = [[-1, 0], [-1, 1], [2, 0], [2, 1], [0, 2], [1, 2], [0, -1], [1, -1]]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [42.67, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 2
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		FirePrefToggle
		{
			Type = UIToggle
			ToggleID = "fire_pref"
			Default = 2
		}
		FirePrefAttack
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [0, 2]
		}
		FirePrefDefend
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [1, 2]
		}
		AttackToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefAttack]
			Mode = All
		}
		DefendToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefDefend]
			Mode = All
		}
		// ---- municao ----
		MagStorage
		{
			Type = ResourceStorage
			ResourceType = bullet
			MaxResources = 20
			UITileRect = [0 + 7/64, 1 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
		Splitter
		{
			Type = InlineResourceConverter
			ResourceType = bullet
			FromStorage = MagStorage
			FromQuantity = 1
			ToQuantity = 2
		}
		MagConsumer
		{
			Type = ResourceConsumer
			ResourceType = bullet
			Storage = MagStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		AmmoPrereq
		{
			Type = MultiToggle
			Toggles = [Splitter]
			Mode = Any
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [1, 0.92]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = &~/FIRE_INTERVAL
			FiringArc = 360d
			RotateSpeed = 240d
			FireThresholdAngle = 10d
			TargetSearchesPerSecond = 8
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = BaseFlakEmitter
			IgnoreFriendlyShipLowLOSChecks = true
			AllowShipWideExplicitTargetsToggle = FirePrefAttack
			EstimateFirepowerToggle = AttackToggle
			AlwaysShowCoverage = true
			AllowDirectControlToggle = FirePrefAttack
			FirePermissionToggle = FireModeToggle
			AutoTargetCrewSafetyDist = 8
			AutoTargets
			[
				{
					TargetType = Bullets
					BulletTargetCategories = [missile, mine, bullet, laser, ion_shot]
					Toggle = DefendToggle
				}
				{
					TargetType = ShipParts
					Toggle = AttackToggle
					Overridable = true
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 255, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 0.86
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
		ShootCycle
		{
			Type = ModeCycle
			ModeRange = [0, 1]
			IncrementTrigger = Turret
			StartingMode = 1
		}
		ShootTrigger1
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [0]
		}
		ShootTrigger2
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [1]
		}
		// ---- emissores (feixe + explosao em area) ----
		BaseFlakEmitter : <../../shots/bs_flak_light/bs_flak_flak_light.rules>
		{
			Type = BeamEmitter
			ChainedTo = Turret
			GetTargetFrom = Turret
			ResourceStorage = Splitter
			FireTrigger
			Location = [1.29, 0]
			OperationalToggle = IsOperational
			ResourcesUsed = 1
			Recoil = 4
			Burst = 1
		}
		FlakEmitter1 : BaseFlakEmitter
		{
			Location = [1.29, -0.2]
			FireTrigger = ShootTrigger1
		}
		FlakEmitter2 : BaseFlakEmitter
		{
			Location = [1.29, 0.2]
			FireTrigger = ShootTrigger2
		}
		Emitter1Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter1]
		}
		Emitter2Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter2]
		}
		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Emitter1Trigger
			Location = [1.29, -0.2]
			MediaEffects
			[
				&<./Data/ships/terran/flak_cannon_large/particles/flak_cannon_shoot_flash_large.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_01.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_02.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_03.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_04.wav"
					]
					Volume = 0.35
					SpeedVariation = 0.08
					MaxConcurrent = 30
				}
			]
		}
		FireEffect2
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Emitter2Trigger
			Location = [1.29, 0.2]
			MediaEffects
			[
				&<./Data/ships/terran/flak_cannon_large/particles/flak_cannon_shoot_flash_large.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_01.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_02.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_03.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_04.wav"
					]
					Volume = 0.35
					SpeedVariation = 0.08
					MaxConcurrent = 30
				}
			]
		}
		// ---- tripulacao ----
		CrewLocation1
		{
			Type = CrewLocation
			Location = [1, 1.55]
			Rotation = 0d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 1
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [AmmoPrereq]
			CrewDestinations = [&../../CrewLocation1/Location]
			CrewLocations = [CrewLocation1]
		}
		// ---- graficos ----
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [2, 2]
					}
				]
			}
		}
		TurretGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "turret_shadow.png"
						Size = [2.25, 2.25]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"turret1.png"
							"turret2.png"
							"turret3.png"
							"turret4.png"
							"turret5.png"
							"turret6.png"
							"turret7.png"
							"turret8.png"
						]
						NormalsAnimationFiles
						[
							"turret1_normals.png"
							"turret2_normals.png"
							"turret3_normals.png"
							"turret4_normals.png"
							"turret5_normals.png"
							"turret6_normals.png"
							"turret7_normals.png"
							"turret8_normals.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.18
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "turret_off.png"
						NormalsFile = "turret1_normals.png"
						Size = [2, 2]
					}
				]
			}
		}
		Barrel1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0.84, -0.2]
			Rotation = 90d
			OperationalToggle = IsOperational
			ResetAnimationTrigger = Emitter1Trigger
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						Size = [0.27, 1.12]
						AnimationFiles = ["barrel2.png", "barrel3.png", "barrel4.png", "barrel5.png", "barrel1.png"]
						NormalsAnimationFiles
						[
							"barrel_normals2.png"
							"barrel_normals3.png"
							"barrel_normals4.png"
							"barrel_normals5.png"
							"barrel_normals1.png"
						]
						AnimationInterval = 0.05
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "barrel1.png"
						NormalsFile = "barrel_normals1.png"
						Size = [0.27, 1.12]
					}
				]
			}
		}
		Barrel2Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0.84, 0.2]
			Rotation = 90d
			OperationalToggle = IsOperational
			ResetAnimationTrigger = Emitter2Trigger
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						Size = [0.27, 1.12]
						AnimationFiles = ["barrel2.png", "barrel3.png", "barrel4.png", "barrel5.png", "barrel1.png"]
						NormalsAnimationFiles
						[
							"barrel_normals2.png"
							"barrel_normals3.png"
							"barrel_normals4.png"
							"barrel_normals5.png"
							"barrel_normals1.png"
						]
						AnimationInterval = 0.05
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "barrel1.png"
						NormalsFile = "barrel_normals1.png"
						Size = [0.27, 1.12]
					}
				]
			}
		}
		Light1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [-0.78, 0]
			OperationalToggle = IsOperational
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [0.9, 0.9]
						Z = 0.8
						VertexColor = [255, 120, 30]
					}
				]
			}
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartScorched
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1, 1]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3]
				}
				{
					Toggle = AmmoPrereq
					Delay = &~/FIRE_INTERVAL
					AtlasSprite
					{
						File = &/INDICATORS/NoAmmo
						Size = [1, 1]
					}
				}
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 2]
		}
	}
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = &~/Part/Components/MagStorage/MaxResources
		BSShotsPerMag = &~/Part/Components/Splitter/ToQuantity
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/BSFlak"
			Stats
			{
				DamagePerShotVsShots = &~/Part/Components/BaseFlakEmitter/STAT_DAMAGE
				DamagePerShot = &~/Part/Components/BaseFlakEmitter/STAT_SHIP_DAMAGE
				ROF = 1 / (&~/Part/Components/Turret/FireInterval)
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				DamagePerSecondVsShots = (&DamagePerShotVsShots) * (&ROF)
				MaxDamage = [&../DamagePerShot, &../DamagePerSecond]
				ShotDamage = [&../DamagePerShotVsShots, &../DamagePerSecondVsShots]
				DamageArea = &~/Part/Components/BaseFlakEmitter/STAT_RADIUS
				Range = &~/Part/Components/BaseFlakEmitter/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = Infinity
				AmmoPerShot = (&~/Part/Components/BaseFlakEmitter/ResourcesUsed) / (&~/Part/Components/Splitter/ToQuantity)
				AmmoPerSecond = (&AmmoPerShot) * (&ROF)
				ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
			}
		}
	]
}
