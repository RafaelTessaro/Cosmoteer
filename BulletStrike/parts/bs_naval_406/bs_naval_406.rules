	StatsByCategory
	[
		{
			NameKey = "StatCategories/BSAmmo_std"
			Stats
			{
				DamagePerShot = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/STAT_DAMAGE
				ShotsPerSecond = 3 * 1 / (&~/Part/Components/Turret/FireInterval/BaseValue)
				DamagePerSecond = (&DamagePerShot) * (&ShotsPerSecond)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				Penetration = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/STAT_PENETRATION
				ROF = &ShotsPerSecond
				Range = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				Spread = deg(&~/Part/Components/Fire_0_N/Components/TargetEmitter/Spread/1)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Components/Targetable/Health
				AmmoPerShot = (&~/Part/Components/Fire_0_N/Components/TargetEmitter/ResourcesUsed) / (&~/Part/Components/Splitter_0/ToQuantity)
				AmmoPerSecond = (&AmmoPerShot) * (&ShotsPerSecond)
				ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
			}
		}
