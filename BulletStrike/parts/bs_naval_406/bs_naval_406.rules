// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Arma: 406mm Triple Naval Turret / Torre Naval Tripla 406 mm

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 0.7519
	HALF_SPREAD = 0.625d
	RECOIL_FACTOR = 160%
	HEAT_PER_SHOT = 2800
	HEAT_PER_SECOND = 150
	CREW_STUN_DURATION = 1.2
	CREW_STUN_RADIUS = 11.7
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 2.3001
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSNaval406"
	IconNameKey = "Parts/BSNaval406Icon"
	DescriptionKey = "Parts/BSNaval406Desc"
	ID = rafaeltessaro.bs_naval_406
	EditorGroups = ["BulletStrike", "WeaponsProjectile"]
	Resources = [[steel, 600], [coil2, 100], [tristeel, 120], [processor, 4]]
	Size = [6, 7]
	SelectionPriority = 1
	MaxHealth = 54000
	TypeCategories = [weapon, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
