// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Defesa: Heavy Flak Battery / Bateria Flak Pesada

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 1
	HEAT_PER_SHOT = 300
	HEAT_PER_SECOND = 60
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 0.3333
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSFlakHeavy"
	IconNameKey = "Parts/BSFlakHeavyIcon"
	DescriptionKey = "Parts/BSFlakHeavyDesc"
	ID = rafaeltessaro.bs_flak_heavy
	EditorGroups = ["BulletStrike", "Defenses", "WeaponsProjectile"]
	Resources = [[steel, 200], [coil2, 36], [tristeel, 30]]
	Size = [4, 4]
	SelectionPriority = 1
	MaxHealth = 21000
	TypeCategories = [defense, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-2, -2, 8, 2]]
		[tall, [-2, 0, 2, 4]]
		[tall, [4, 0, 2, 4]]
	]
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[-1, 3]
		[4, 0]
		[4, 1]
		[4, 2]
		[4, 3]
		[0, 4]
		[1, 4]
		[2, 4]
		[3, 4]
		[0, -1]
		[1, -1]
		[2, -1]
		[3, -1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [61.33, 92]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 6
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		FirePrefToggle
		{
			Type = UIToggle
			ToggleID = "fire_pref"
			Default = 1
		}
		FirePrefAttack
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [0, 2]
		}
		FirePrefDefend
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [1, 2]
		}
		AttackToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefAttack]
			Mode = All
		}
		DefendToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefDefend]
			Mode = All
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, { Toggle=IsOverclocked; Invert=true }]
			Mode = All
		}
		// ---- municao ----
		MagStorage
		{
			Type = ResourceStorage
			ResourceType = rafaeltessaro.bs_mag_std
			MaxResources = 16
			UITileRect = [0 + 7/64, 3 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
		Splitter
		{
			Type = InlineResourceConverter
			ResourceType = rafaeltessaro.bs_mag_std
			FromStorage = MagStorage
			FromQuantity = 1
			ToQuantity = 3
		}
		MagConsumer
		{
			Type = ResourceConsumer
			ResourceType = rafaeltessaro.bs_mag_std
			Storage = MagStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		AmmoPrereq
		{
			Type = MultiToggle
			Toggles = [Splitter]
			Mode = Any
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [2, 1.65]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = &~/FIRE_INTERVAL
			FiringArc = 360d
			RotateSpeed = 120d
			FireThresholdAngle = 10d
			TargetSearchesPerSecond = 8
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = BaseFlakEmitter
			IgnoreFriendlyShipLowLOSChecks = true
			AllowShipWideExplicitTargetsToggle = FirePrefAttack
			EstimateFirepowerToggle = AttackToggle
			AlwaysShowCoverage = true
			AllowDirectControlToggle = FirePrefAttack
			FirePermissionToggle = FireModeToggle
			AutoTargetCrewSafetyDist = 8
			AutoTargets
			[
				{
					TargetType = Bullets
					BulletTargetCategories = [missile, mine, bullet, laser, ion_shot]
					Toggle = DefendToggle
				}
				{
					TargetType = ShipParts
					Toggle = AttackToggle
					Overridable = true
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 255, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.61
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
		ShootCycle
		{
			Type = ModeCycle
			ModeRange = [0, 3]
			IncrementTrigger = Turret
			StartingMode = 3
		}
		ShootTrigger1
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [0]
		}
		ShootTrigger2
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [1]
		}
		ShootTrigger3
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [2]
		}
		ShootTrigger4
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [3]
		}
		// ---- emissores (feixe + explosao em area) ----
		BaseFlakEmitter : <../../shots/bs_flak_heavy/bs_flak_flak_heavy.rules>
		{
			Type = BeamEmitter
			ChainedTo = Turret
			GetTargetFrom = Turret
			ResourceStorage = Splitter
			FireTrigger
			Location = [2.979, 0]
			OperationalToggle = IsOperationalNonOverclocked
			ResourcesUsed = 1
			Recoil = 4
			Burst = 1
		}
		FlakEmitter1 : BaseFlakEmitter
		{
			Location = [2.979, -0.75]
			FireTrigger = ShootTrigger1
		}
		FlakEmitter2 : BaseFlakEmitter
		{
			Location = [2.979, -0.25]
			FireTrigger = ShootTrigger2
		}
		FlakEmitter3 : BaseFlakEmitter
		{
			Location = [2.979, 0.25]
			FireTrigger = ShootTrigger3
		}
		FlakEmitter4 : BaseFlakEmitter
		{
			Location = [2.979, 0.75]
			FireTrigger = ShootTrigger4
		}
		Overclock_BaseFlakEmitter : <../../shots/bs_flak_heavy/bs_flak_flak_heavy_oc.rules>/Beam, BaseFlakEmitter
		{
			OperationalToggle = IsOperationalOverclocked
		}
		Overclock_FlakEmitter1 : Overclock_BaseFlakEmitter, FlakEmitter1
		{
			Location = &^/1/Location
			FireTrigger = &^/1/FireTrigger
			ResourceStorage = &^/1/ResourceStorage
		}
		Overclock_FlakEmitter2 : Overclock_BaseFlakEmitter, FlakEmitter2
		{
			Location = &^/1/Location
			FireTrigger = &^/1/FireTrigger
			ResourceStorage = &^/1/ResourceStorage
		}
		Overclock_FlakEmitter3 : Overclock_BaseFlakEmitter, FlakEmitter3
		{
			Location = &^/1/Location
			FireTrigger = &^/1/FireTrigger
			ResourceStorage = &^/1/ResourceStorage
		}
		Overclock_FlakEmitter4 : Overclock_BaseFlakEmitter, FlakEmitter4
		{
			Location = &^/1/Location
			FireTrigger = &^/1/FireTrigger
			ResourceStorage = &^/1/ResourceStorage
		}
		Emitter1Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter1, Overclock_FlakEmitter1]
		}
		Emitter2Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter2, Overclock_FlakEmitter2]
		}
		Emitter3Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter3, Overclock_FlakEmitter3]
		}
		Emitter4Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter4, Overclock_FlakEmitter4]
		}
		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Emitter1Trigger
			Location = [2.979, -0.75]
			MediaEffects
			[
