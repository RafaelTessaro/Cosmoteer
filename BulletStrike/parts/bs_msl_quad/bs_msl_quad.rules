	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/BSMslQuad_he"
			Stats
			{
				DamagePerShot = &~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/STAT_DAMAGE
				MissilesPerSalvo = (&~/MODE_he/CELLS) * (&~/MODE_he/MISSILES_PER_UNIT)
				SalvoCycle = &~/MODE_he/CYCLE
				ROF = (&MissilesPerSalvo) / (&SalvoCycle)
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				MaxDamage = [&../DamagePerShot, &../DamagePerSecond]
				DamageArea = &~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/STAT_RADIUS
				Salvo = [&../MissilesPerSalvo, &../SalvoCycle]
				Range = &~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotLaunchSpeed = &~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/Speed
				Acceleration = &~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/Components/Acceleration/Acceleration
				ShotGuidance = deg(&~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/Components/Homing/TurnVelocity)
				ShotHP = &~/Part/Components/Fire_he/Components/TargetEmitter/Bullet/Components/Targetable/Health
				MissileParts = (&~/MODE_he/PARTS) / (&~/MODE_he/MISSILES_PER_UNIT)
				MissilePartCapacity
				[
					&~/Part/Components/MagStorage_HE/MaxResources
					(&~/Part/Components/MagStorage_HE/MaxResources) * (&~/MODE_he/MISSILES_PER_UNIT) / (&~/MODE_he/PARTS)
				]
			}
		}
