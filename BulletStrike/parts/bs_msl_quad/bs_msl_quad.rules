		// ---- modo torpedo (Boto): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_torpedo
		{
			Type = ResourceStorage
			ResourceType = missile_part_he
			MaxResources = &~/MODE_torpedo/CELLS
			ToggleOnResources = &~/MODE_torpedo/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_HE]
			DropResourcesWhenDestroyed = false
		}
		RackAny_torpedo
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [ReadyRack_torpedo]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_torpedo
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [MagStorage_HE]
			ToggleOnResources = &~/MODE_torpedo/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_torpedo
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_torpedo, { Toggle=ReadyRack_torpedo; Invert=true }]
			Mode = All
		}
		Autoloader_torpedo
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_torpedo
			CheckResourceLimits = true
			FromStorage = MagStorage_HE
			FromQuantity = &~/MODE_torpedo/PARTS
			ToStorage = ReadyRack_torpedo
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_torpedo/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_torpedo/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_torpedo
		{
			Type = TriggeredEffects
			Trigger = Autoloader_torpedo
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_torpedo
		{
			Type = ToggleEffects
			Toggle = ReadyRack_torpedo
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_torpedo
		{
			Type = ToggleTrigger
			Toggle = RackAny_torpedo
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_torpedo
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_torpedo
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_torpedo
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_torpedo
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_torpedo
		{
			Type = Timer
			StartTrigger = ModeOn_torpedo
			StartExpired = true
			Duration
			{
				BaseValue = (&~/MODE_torpedo/CELLS) * (&~/MODE_torpedo/RELOAD)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_torpedo/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		PrefilledSwitch_torpedo
		{
			Type = TriggerProxy
			ComponentID = ModeOn_torpedo
			ProxyToggle = ReadyRack_torpedo
		}
		PrefilledDelay_torpedo
		{
			Type = Timer
			StartTrigger = PrefilledSwitch_torpedo
			StartExpired = true
			Duration = (&~/MODE_torpedo/CELLS) * (&~/MODE_torpedo/RELOAD)
		}
		DryPending_torpedo
		{
			Type = MultiToggle
			Toggles = [RackAny_torpedo, { Toggle=MagCanLoad_torpedo; Invert=true }]
			Mode = All
		}
		DryWait_torpedo
		{
			Type = ValueTween
			IsOnToggle = DryPending_torpedo
			OnTweenDuration = &~/MODE_torpedo/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_torpedo
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_torpedo
			MinAmount = 100%
		}
		CanFire_torpedo
		{
			Type = MultiToggle
			Toggles = [ReadyRack_torpedo, DryFlush_torpedo]
			Mode = Any
		}
		RackReady_torpedo
		{
			Type = MultiToggle
			Toggles = [ModeToggle_torpedo, ModeSwitchDelay_torpedo, PrefilledDelay_torpedo, CanFire_torpedo]
			Mode = All
		}
		MagOrRack_torpedo
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_torpedo, RackAny_torpedo]
			Mode = Any
		}
		HasMissiles_torpedo
		{
			Type = MultiToggle
			Toggles = [ModeToggle_torpedo, MagOrRack_torpedo]
			Mode = All
		}
		Overclock_LoadHeat_torpedo
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = Autoloader_torpedo
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Amount = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_torpedo/PARTS) * (&~/HEAT_TO_RESOURCE)
		}
		MidReload_torpedo
		{
			Type = MultiToggle
			Toggles = [LoaderOn_torpedo, MagCanLoad_torpedo, RackAny_torpedo]
			Mode = All
		}
		SalvoOn_torpedo
		{
			Type = MultiToggle
			Toggles = [ModeToggle_torpedo, { Toggle=MidReload_torpedo; Invert=true }]
			Mode = All
		}
		ReloadOn_torpedo
		{
			Type = MultiToggle
			Toggles = [ModeToggle_torpedo, MidReload_torpedo]
			Mode = All
		}
