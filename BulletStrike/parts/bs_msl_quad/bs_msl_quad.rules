	Resources = [[steel, 400], [coil2, 110], [tristeel, 100], [processor, 4], [enriched_uranium, 2]]
	Size = [5, 6]
	SelectionPriority = 1
	MaxHealth = 42000
	TypeCategories = [weapon, is_crewed, uses_missiles, uses_launcher_parts, uses_emps, uses_nukes, bs_limit_nuke]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
