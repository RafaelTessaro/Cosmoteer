		// ---- modo cluster (Piranha): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_cluster
		{
			Type = ResourceStorage
			ResourceType = missile_part_he
			MaxResources = &~/MODE_cluster/CELLS
			ToggleOnResources = &~/MODE_cluster/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_HE]
			DropResourcesWhenDestroyed = false
		}
		RackAny_cluster
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [ReadyRack_cluster]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_cluster
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [MagStorage_HE]
			ToggleOnResources = &~/MODE_cluster/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_cluster
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_cluster, { Toggle=ReadyRack_cluster; Invert=true }]
			Mode = All
		}
		Autoloader_cluster
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_cluster
			CheckResourceLimits = true
			FromStorage = MagStorage_HE
			FromQuantity = &~/MODE_cluster/PARTS
			ToStorage = ReadyRack_cluster
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_cluster/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_cluster/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_cluster
		{
			Type = TriggeredEffects
			Trigger = Autoloader_cluster
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_cluster
		{
			Type = ToggleEffects
			Toggle = ReadyRack_cluster
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_cluster
		{
			Type = ToggleTrigger
			Toggle = RackAny_cluster
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_cluster
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_cluster
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_cluster
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_cluster
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_cluster
		{
			Type = Timer
			StartTrigger = ModeOn_cluster
			StartExpired = true
			Duration
			{
				BaseValue = (&~/MODE_cluster/CELLS) * (&~/MODE_cluster/RELOAD)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_cluster/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		PrefilledSwitch_cluster
		{
			Type = TriggerProxy
			ComponentID = ModeOn_cluster
			ProxyToggle = ReadyRack_cluster
		}
		PrefilledDelay_cluster
		{
			Type = Timer
			StartTrigger = PrefilledSwitch_cluster
			StartExpired = true
			Duration = (&~/MODE_cluster/CELLS) * (&~/MODE_cluster/RELOAD)
		}
		DryPending_cluster
		{
			Type = MultiToggle
			Toggles = [RackAny_cluster, { Toggle=MagCanLoad_cluster; Invert=true }]
			Mode = All
		}
		DryWait_cluster
		{
			Type = ValueTween
			IsOnToggle = DryPending_cluster
			OnTweenDuration = &~/MODE_cluster/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_cluster
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_cluster
			MinAmount = 100%
		}
		CanFire_cluster
		{
			Type = MultiToggle
			Toggles = [ReadyRack_cluster, DryFlush_cluster]
			Mode = Any
		}
		RackReady_cluster
		{
			Type = MultiToggle
			Toggles = [ModeToggle_cluster, ModeSwitchDelay_cluster, PrefilledDelay_cluster, CanFire_cluster]
			Mode = All
		}
		MagOrRack_cluster
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_cluster, RackAny_cluster]
			Mode = Any
		}
		HasMissiles_cluster
		{
			Type = MultiToggle
			Toggles = [ModeToggle_cluster, MagOrRack_cluster]
			Mode = All
		}
		Overclock_LoadHeat_cluster
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = Autoloader_cluster
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Amount = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_cluster/PARTS) * (&~/HEAT_TO_RESOURCE)
		}
		RackFullTrigger_cluster
		{
			Type = ToggleTrigger
			Toggle = ReadyRack_cluster
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		Overclock_Vent_cluster
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = RackFullTrigger_cluster
			ResourceStorage = MagStorage_HE
			Amount = -(&~/MODE_cluster/VENT)
		}
		MidReload_cluster
		{
			Type = MultiToggle
			Toggles = [LoaderOn_cluster, MagCanLoad_cluster, RackAny_cluster]
			Mode = All
		}
		SalvoOn_cluster
		{
			Type = MultiToggle
			Toggles = [ModeToggle_cluster, { Toggle=MidReload_cluster; Invert=true }]
			Mode = All
		}
		ReloadOn_cluster
		{
			Type = MultiToggle
			Toggles = [ModeToggle_cluster, MidReload_cluster]
			Mode = All
		}
