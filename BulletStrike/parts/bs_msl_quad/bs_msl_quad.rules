		// ---- modo limpet (Carrapato): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_limpet
		{
			Type = ResourceStorage
			ResourceType = missile_part_he
			MaxResources = &~/MODE_limpet/CELLS
			ToggleOnResources = &~/MODE_limpet/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_HE]
			DropResourcesWhenDestroyed = false
		}
		RackAny_limpet
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [ReadyRack_limpet]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_limpet
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [MagStorage_HE]
			ToggleOnResources = &~/MODE_limpet/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_limpet
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_limpet, { Toggle=ReadyRack_limpet; Invert=true }]
			Mode = All
		}
		Autoloader_limpet
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_limpet
			CheckResourceLimits = true
			FromStorage = MagStorage_HE
			FromQuantity = &~/MODE_limpet/PARTS
			ToStorage = ReadyRack_limpet
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_limpet/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_limpet/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_limpet
		{
			Type = TriggeredEffects
			Trigger = Autoloader_limpet
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_limpet
		{
			Type = ToggleEffects
			Toggle = ReadyRack_limpet
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_limpet
		{
			Type = ToggleTrigger
			Toggle = RackAny_limpet
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_limpet
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_limpet
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_limpet
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_limpet
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_limpet
		{
			Type = Timer
			StartTrigger = ModeOn_limpet
			StartExpired = true
			Duration
			{
				BaseValue = (&~/MODE_limpet/CELLS) * (&~/MODE_limpet/RELOAD)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_limpet/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		PrefilledSwitch_limpet
		{
			Type = TriggerProxy
			ComponentID = ModeOn_limpet
			ProxyToggle = ReadyRack_limpet
		}
		PrefilledDelay_limpet
		{
			Type = Timer
			StartTrigger = PrefilledSwitch_limpet
			StartExpired = true
			Duration = (&~/MODE_limpet/CELLS) * (&~/MODE_limpet/RELOAD)
		}
		DryPending_limpet
		{
			Type = MultiToggle
			Toggles = [RackAny_limpet, { Toggle=MagCanLoad_limpet; Invert=true }]
			Mode = All
		}
		DryWait_limpet
		{
			Type = ValueTween
			IsOnToggle = DryPending_limpet
			OnTweenDuration = &~/MODE_limpet/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_limpet
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_limpet
			MinAmount = 100%
		}
		CanFire_limpet
		{
			Type = MultiToggle
			Toggles = [ReadyRack_limpet, DryFlush_limpet]
			Mode = Any
		}
		RackReady_limpet
		{
			Type = MultiToggle
			Toggles = [ModeToggle_limpet, ModeSwitchDelay_limpet, PrefilledDelay_limpet, CanFire_limpet]
			Mode = All
		}
		MagOrRack_limpet
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_limpet, RackAny_limpet]
			Mode = Any
		}
		HasMissiles_limpet
		{
			Type = MultiToggle
			Toggles = [ModeToggle_limpet, MagOrRack_limpet]
			Mode = All
		}
		Overclock_LoadHeat_limpet
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = Autoloader_limpet
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Amount = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_limpet/PARTS) * (&~/HEAT_TO_RESOURCE)
		}
		RackFullTrigger_limpet
		{
			Type = ToggleTrigger
			Toggle = ReadyRack_limpet
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		Overclock_Vent_limpet
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = RackFullTrigger_limpet
			ResourceStorage = MagStorage_HE
			Amount = -(&~/MODE_limpet/VENT)
		}
		MidReload_limpet
		{
			Type = MultiToggle
			Toggles = [LoaderOn_limpet, MagCanLoad_limpet, RackAny_limpet]
			Mode = All
		}
		SalvoOn_limpet
		{
			Type = MultiToggle
			Toggles = [ModeToggle_limpet, { Toggle=MidReload_limpet; Invert=true }]
			Mode = All
		}
		ReloadOn_limpet
		{
			Type = MultiToggle
			Toggles = [ModeToggle_limpet, MidReload_limpet]
			Mode = All
		}
		Salvo_limpet
