		// ---- modo napalm (Taturana): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_napalm
		{
			Type = ResourceStorage
			ResourceType = missile_part_thermal
			MaxResources = &~/MODE_napalm/CELLS
			ToggleOnResources = &~/MODE_napalm/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_Thermal]
			DropResourcesWhenDestroyed = false
		}
		RackAny_napalm
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_thermal
			ResourceStorages = [ReadyRack_napalm]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_napalm
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_thermal
			ResourceStorages = [MagStorage_Thermal]
			ToggleOnResources = &~/MODE_napalm/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_napalm
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_napalm, { Toggle=ReadyRack_napalm; Invert=true }]
			Mode = All
		}
		Autoloader_napalm
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_napalm
			CheckResourceLimits = true
			FromStorage = MagStorage_Thermal
			FromQuantity = &~/MODE_napalm/PARTS
			ToStorage = ReadyRack_napalm
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_napalm/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_napalm/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_napalm
		{
			Type = TriggeredEffects
			Trigger = Autoloader_napalm
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_napalm
		{
			Type = ToggleEffects
			Toggle = ReadyRack_napalm
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_napalm
		{
			Type = ToggleTrigger
			Toggle = RackAny_napalm
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_napalm
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_napalm
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_napalm
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_napalm
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_napalm
		{
			Type = Timer
			StartTrigger = ModeOn_napalm
			StartExpired = true
			Duration
			{
				BaseValue = (&~/MODE_napalm/CELLS) * (&~/MODE_napalm/RELOAD)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_napalm/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		PrefilledSwitch_napalm
		{
			Type = TriggerProxy
			ComponentID = ModeOn_napalm
			ProxyToggle = ReadyRack_napalm
		}
		PrefilledDelay_napalm
		{
			Type = Timer
			StartTrigger = PrefilledSwitch_napalm
			StartExpired = true
			Duration = (&~/MODE_napalm/CELLS) * (&~/MODE_napalm/RELOAD)
		}
		DryPending_napalm
		{
			Type = MultiToggle
			Toggles = [RackAny_napalm, { Toggle=MagCanLoad_napalm; Invert=true }]
			Mode = All
		}
		DryWait_napalm
		{
			Type = ValueTween
			IsOnToggle = DryPending_napalm
			OnTweenDuration = &~/MODE_napalm/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_napalm
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_napalm
			MinAmount = 100%
		}
		CanFire_napalm
		{
			Type = MultiToggle
			Toggles = [ReadyRack_napalm, DryFlush_napalm]
			Mode = Any
		}
		RackReady_napalm
		{
			Type = MultiToggle
			Toggles = [ModeToggle_napalm, ModeSwitchDelay_napalm, PrefilledDelay_napalm, CanFire_napalm]
			Mode = All
		}
		MagOrRack_napalm
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_napalm, RackAny_napalm]
			Mode = Any
		}
		HasMissiles_napalm
		{
			Type = MultiToggle
			Toggles = [ModeToggle_napalm, MagOrRack_napalm]
			Mode = All
		}
		Overclock_LoadHeat_napalm
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = Autoloader_napalm
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Amount = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_napalm/PARTS) * (&~/HEAT_TO_RESOURCE)
		}
		RackFullTrigger_napalm
		{
			Type = ToggleTrigger
			Toggle = ReadyRack_napalm
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		Overclock_Vent_napalm
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = RackFullTrigger_napalm
			ResourceStorage = MagStorage_Thermal
			Amount = -(&~/MODE_napalm/VENT)
		}
		MidReload_napalm
		{
			Type = MultiToggle
			Toggles = [LoaderOn_napalm, MagCanLoad_napalm, RackAny_napalm]
			Mode = All
		}
		SalvoOn_napalm
		{
			Type = MultiToggle
			Toggles = [ModeToggle_napalm, { Toggle=MidReload_napalm; Invert=true }]
			Mode = All
		}
		ReloadOn_napalm
		{
			Type = MultiToggle
			Toggles = [ModeToggle_napalm, MidReload_napalm]
			Mode = All
		}
