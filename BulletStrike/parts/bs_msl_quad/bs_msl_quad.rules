					OperationalToggle = UsesNuke
					AllowNonOperationalMinPriorityDelivery = false
					ConsumptionToggleButtonOffset = [0, -0.4]
				}
			}
		}
		// ---- modo he (Jararaca): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_he
		{
			Type = ResourceStorage
			ResourceType = missile_part_he
			MaxResources = &~/MODE_he/CELLS
			ToggleOnResources = &~/MODE_he/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_HE]
			DropResourcesWhenDestroyed = false
		}
		RackAny_he
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [ReadyRack_he]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_he
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_he
			ResourceStorages = [MagStorage_HE]
			ToggleOnResources = &~/MODE_he/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_he
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_he, { Toggle=ReadyRack_he; Invert=true }]
			Mode = All
		}
		Autoloader_he
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_he
			CheckResourceLimits = true
			FromStorage = MagStorage_HE
			FromQuantity = &~/MODE_he/PARTS
			ToStorage = ReadyRack_he
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_he/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_he/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_he
		{
			Type = TriggeredEffects
			Trigger = Autoloader_he
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_he
		{
			Type = ToggleEffects
			Toggle = ReadyRack_he
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_he
		{
			Type = ToggleTrigger
			Toggle = RackAny_he
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_he
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_he
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_he
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_he
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_he
		{
			Type = Timer
			StartTrigger = ModeOn_he
			StartExpired = true
			Duration
			{
				BaseValue = (&~/MODE_he/CELLS) * (&~/MODE_he/RELOAD)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_he/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		PrefilledSwitch_he
		{
			Type = TriggerProxy
			ComponentID = ModeOn_he
			ProxyToggle = ReadyRack_he
		}
		PrefilledDelay_he
		{
			Type = Timer
			StartTrigger = PrefilledSwitch_he
			StartExpired = true
			Duration = (&~/MODE_he/CELLS) * (&~/MODE_he/RELOAD)
		}
		DryPending_he
		{
			Type = MultiToggle
			Toggles = [RackAny_he, { Toggle=MagCanLoad_he; Invert=true }]
			Mode = All
		}
		DryWait_he
		{
			Type = ValueTween
			IsOnToggle = DryPending_he
			OnTweenDuration = &~/MODE_he/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_he
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_he
			MinAmount = 100%
		}
		CanFire_he
		{
			Type = MultiToggle
			Toggles = [ReadyRack_he, DryFlush_he]
			Mode = Any
		}
		RackReady_he
		{
			Type = MultiToggle
			Toggles = [ModeToggle_he, ModeSwitchDelay_he, PrefilledDelay_he, CanFire_he]
			Mode = All
		}
		MagOrRack_he
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_he, RackAny_he]
			Mode = Any
		}
		HasMissiles_he
		{
			Type = MultiToggle
			Toggles = [ModeToggle_he, MagOrRack_he]
			Mode = All
		}
		Overclock_LoadHeat_he
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = Autoloader_he
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Amount = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_he/PARTS) * (&~/HEAT_TO_RESOURCE)
		}
		RackFullTrigger_he
		{
			Type = ToggleTrigger
			Toggle = ReadyRack_he
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		Overclock_Vent_he
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = RackFullTrigger_he
			ResourceStorage = MagStorage_HE
			Amount = -(&~/MODE_he/VENT)
		}
		MidReload_he
