			Type = ModeToggle
			Mode = MissileTypeToggle
			OnMode = 4
		}
		ModeToggle_torpedo
		{
			Type = ModeToggle
			Mode = MissileTypeToggle
			OnMode = 5
		}
		ModeToggle_nuclear
		{
			Type = ModeToggle
			Mode = MissileTypeToggle
			OnMode = 6
		}
		// ---- (1) carregador interno por familia de recurso (a tripulacao enche) ----
		UsesHE
		{
			Type = MultiToggle
			Toggles = [ModeToggle_he, ModeToggle_cluster, ModeToggle_limpet, ModeToggle_torpedo]
			Mode = Any
		}
		MagStorage_HE
		{
			Type = ResourceStorage
			ResourceType = missile_part_he
			MaxResources = 192
			DelayBeforeReadyToUse = 0.5
			UITileRect = [0 + 7/64, 5 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
			DropResourcesWhenRemoved = true
		}
		AmmoConsumersOnHE
		{
			Type = ToggledComponents
			Toggle = UsesHE
			Components
			{
				MagConsumer_HE
				{
					Type = ResourceConsumer
					ResourceType = missile_part_he
					Storage = MagStorage_HE
					DefaultPriority = &/PRIORITIES/Weapon_Supply
