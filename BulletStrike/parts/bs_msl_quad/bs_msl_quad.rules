// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Lancador de misseis: Quad-Pod Heavy Missile Battery / Bateria Pesada de Mísseis Quádrupla ("Mula-sem-Cabeça")

OVERCLOCK
{
	RELOAD_FACTOR = 1.5
	HEAT_PER_PART = 400
	HEAT_PER_SECOND = 150
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
RIPPLE = 2/30
MODE_he
{
	CELLS = 48
	PARTS = 2
	MISSILES_PER_UNIT = 1
	RELOAD = 0.264
	VENT = 6
	DRY_DELAY = (&CELLS) * (&RELOAD)
	OC_FACTOR = 1.5
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
MODE_cluster
{
	CELLS = 16
	PARTS = 4
	MISSILES_PER_UNIT = 1
	RELOAD = 0.6
	VENT = 4
	DRY_DELAY = (&CELLS) * (&RELOAD)
	OC_FACTOR = 1.5
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
MODE_limpet
{
	CELLS = 16
	PARTS = 4
	MISSILES_PER_UNIT = 1
	RELOAD = 0.6
	VENT = 4
	DRY_DELAY = (&CELLS) * (&RELOAD)
	OC_FACTOR = 1.5
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
MODE_napalm
{
	CELLS = 16
	PARTS = 4
	MISSILES_PER_UNIT = 1
	RELOAD = 0.6
	VENT = 4
	DRY_DELAY = (&CELLS) * (&RELOAD)
	OC_FACTOR = 1.5
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
MODE_emp
{
	CELLS = 16
	PARTS = 3
	MISSILES_PER_UNIT = 1
	RELOAD = 0.6
	VENT = 3
	DRY_DELAY = (&CELLS) * (&RELOAD)
	OC_FACTOR = 1.2
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
MODE_torpedo
{
	CELLS = 4
	PARTS = 12
	MISSILES_PER_UNIT = 1
	RELOAD = 2.37
	VENT = 0
	DRY_DELAY = (&CELLS) * (&RELOAD)
	OC_FACTOR = 1.5
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
MODE_nuclear
{
	CELLS = 2
	PARTS = 8
	MISSILES_PER_UNIT = 1
	RELOAD = 9.97
	VENT = 0
	DRY_DELAY = (&CELLS) * (&RELOAD)
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = &CYCLE
}
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSMslQuad"
	IconNameKey = "Parts/BSMslQuadIcon"
	DescriptionKey = "Parts/BSMslQuadDesc"
