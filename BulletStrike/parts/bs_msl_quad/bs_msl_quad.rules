		// ---- modo emp (Poraquê): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_emp
		{
			Type = ResourceStorage
			ResourceType = missile_part_emp
			MaxResources = &~/MODE_emp/CELLS
			ToggleOnResources = &~/MODE_emp/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_EMP]
			DropResourcesWhenDestroyed = false
		}
		RackAny_emp
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_emp
			ResourceStorages = [ReadyRack_emp]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_emp
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_emp
			ResourceStorages = [MagStorage_EMP]
			ToggleOnResources = &~/MODE_emp/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_emp
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_emp, { Toggle=ReadyRack_emp; Invert=true }]
			Mode = All
		}
		Autoloader_emp
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_emp
			CheckResourceLimits = true
			FromStorage = MagStorage_EMP
			FromQuantity = &~/MODE_emp/PARTS
			ToStorage = ReadyRack_emp
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_emp/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_emp/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_emp
		{
			Type = TriggeredEffects
			Trigger = Autoloader_emp
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_emp
		{
			Type = ToggleEffects
			Toggle = ReadyRack_emp
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_emp
		{
			Type = ToggleTrigger
			Toggle = RackAny_emp
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_emp
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_emp
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_emp
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_emp
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_emp
		{
			Type = Timer
			StartTrigger = ModeOn_emp
			StartExpired = true
			Duration
			{
				BaseValue = (&~/MODE_emp/CELLS) * (&~/MODE_emp/RELOAD)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_emp/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		PrefilledSwitch_emp
		{
			Type = TriggerProxy
			ComponentID = ModeOn_emp
			ProxyToggle = ReadyRack_emp
		}
		PrefilledDelay_emp
		{
			Type = Timer
			StartTrigger = PrefilledSwitch_emp
			StartExpired = true
			Duration = (&~/MODE_emp/CELLS) * (&~/MODE_emp/RELOAD)
		}
		DryPending_emp
		{
			Type = MultiToggle
			Toggles = [RackAny_emp, { Toggle=MagCanLoad_emp; Invert=true }]
			Mode = All
		}
		DryWait_emp
		{
			Type = ValueTween
			IsOnToggle = DryPending_emp
			OnTweenDuration = &~/MODE_emp/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_emp
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_emp
			MinAmount = 100%
		}
		CanFire_emp
		{
			Type = MultiToggle
			Toggles = [ReadyRack_emp, DryFlush_emp]
			Mode = Any
		}
		RackReady_emp
		{
			Type = MultiToggle
			Toggles = [ModeToggle_emp, ModeSwitchDelay_emp, PrefilledDelay_emp, CanFire_emp]
			Mode = All
		}
		MagOrRack_emp
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_emp, RackAny_emp]
			Mode = Any
		}
		HasMissiles_emp
		{
			Type = MultiToggle
			Toggles = [ModeToggle_emp, MagOrRack_emp]
			Mode = All
		}
		Overclock_LoadHeat_emp
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = Autoloader_emp
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Amount = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_emp/PARTS) * (&~/HEAT_TO_RESOURCE)
		}
		RackFullTrigger_emp
		{
			Type = ToggleTrigger
			Toggle = ReadyRack_emp
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		Overclock_Vent_emp
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			Trigger = RackFullTrigger_emp
			ResourceStorage = MagStorage_EMP
			Amount = -(&~/MODE_emp/VENT)
		}
		MidReload_emp
		{
			Type = MultiToggle
			Toggles = [LoaderOn_emp, MagCanLoad_emp, RackAny_emp]
			Mode = All
		}
		SalvoOn_emp
		{
			Type = MultiToggle
			Toggles = [ModeToggle_emp, { Toggle=MidReload_emp; Invert=true }]
			Mode = All
		}
		ReloadOn_emp
		{
			Type = MultiToggle
			Toggles = [ModeToggle_emp, MidReload_emp]
			Mode = All
		}
