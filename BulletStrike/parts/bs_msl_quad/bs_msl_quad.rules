					TriggerInModes = [47]
				}
			}
		}
		// ---- modo nuclear (Iara): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_nuclear
		{
			Type = ResourceStorage
			ResourceType = missile_part_nuke
			MaxResources = &~/MODE_nuclear/CELLS
			ToggleOnResources = &~/MODE_nuclear/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_Nuke]
			DropResourcesWhenDestroyed = false
		}
		RackAny_nuclear
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_nuke
			ResourceStorages = [ReadyRack_nuclear]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_nuclear
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_nuke
			ResourceStorages = [MagStorage_Nuke]
			ToggleOnResources = &~/MODE_nuclear/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_nuclear
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_nuclear, { Toggle=ReadyRack_nuclear; Invert=true }]
			Mode = All
		}
		Autoloader_nuclear
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_nuclear
			CheckResourceLimits = true
			FromStorage = MagStorage_Nuke
			FromQuantity = &~/MODE_nuclear/PARTS
			ToStorage = ReadyRack_nuclear
			ToQuantity = 1
			Interval = &~/MODE_nuclear/RELOAD
		}
		ReloadEffect_nuclear
		{
			Type = TriggeredEffects
			Trigger = Autoloader_nuclear
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_reload_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.6
				}
			]
		}
		RackFullEffect_nuclear
		{
			Type = ToggleEffects
			Toggle = ReadyRack_nuclear
			ToggledOnMediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					RandomSounds
					[
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_01.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_02.wav"
						"./Data/ships/terran/missile_launcher/sounds/launcher_ready_03.wav"
					]
					SpeedVariation = 0.1
					Volume = 0.7
				}
			]
		}
		RackEmptied_nuclear
		{
			Type = ToggleTrigger
			Toggle = RackAny_nuclear
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		SalvoEndEffect_nuclear
		{
			Type = TriggeredEffects
			Trigger = RackEmptied_nuclear
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SHAKE
				{
					ShakeAmount = 0.15
					Duration = 0.6
				}
			]
		}
		ModeOn_nuclear
		{
			Type = ToggleTrigger
			Toggle = ModeToggle_nuclear
			TriggerWhenOn = true
			TriggerWhenOff = false
		}
		ModeSwitchDelay_nuclear
		{
			Type = Timer
			StartTrigger = ModeOn_nuclear
			StartExpired = true
			Duration = (&~/MODE_nuclear/CELLS) * (&~/MODE_nuclear/RELOAD)
		}
		DryPending_nuclear
		{
			Type = MultiToggle
			Toggles = [RackAny_nuclear, { Toggle=MagCanLoad_nuclear; Invert=true }]
			Mode = All
		}
		DryWait_nuclear
		{
			Type = ValueTween
			IsOnToggle = DryPending_nuclear
			OnTweenDuration = &~/MODE_nuclear/DRY_DELAY
			OffTweenDuration = 0.1
		}
		DryFlush_nuclear
		{
			Type = ThresholdToggle
			ValueFrom = DryWait_nuclear
			MinAmount = 100%
		}
		CanFire_nuclear
		{
			Type = MultiToggle
			Toggles = [ReadyRack_nuclear, DryFlush_nuclear]
			Mode = Any
		}
		RackReady_nuclear
		{
			Type = MultiToggle
			Toggles = [ModeToggle_nuclear, ModeSwitchDelay_nuclear, CanFire_nuclear]
			Mode = All
		}
		MagOrRack_nuclear
		{
			Type = MultiToggle
			Toggles = [MagCanLoad_nuclear, RackAny_nuclear]
			Mode = Any
		}
		HasMissiles_nuclear
		{
			Type = MultiToggle
			Toggles = [ModeToggle_nuclear, MagOrRack_nuclear]
			Mode = All
		}
		MidReload_nuclear
		{
			Type = MultiToggle
			Toggles = [LoaderOn_nuclear, MagCanLoad_nuclear, RackAny_nuclear]
			Mode = All
		}
		SalvoOn_nuclear
		{
			Type = MultiToggle
			Toggles = [ModeToggle_nuclear, { Toggle=MidReload_nuclear; Invert=true }]
			Mode = All
		}
		ReloadOn_nuclear
		{
			Type = MultiToggle
			Toggles = [ModeToggle_nuclear, MidReload_nuclear]
			Mode = All
		}
