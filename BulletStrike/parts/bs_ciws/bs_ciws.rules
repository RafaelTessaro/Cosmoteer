// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Defesa: Deck CIWS / CIWS de Convés

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 0.7692
	HEAT_PER_SHOT = 100
	HEAT_PER_SECOND = 60
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 0.6
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSCiws"
	IconNameKey = "Parts/BSCiwsIcon"
	DescriptionKey = "Parts/BSCiwsDesc"
	ID = rafaeltessaro.bs_ciws
	EditorGroups = ["BulletStrike", "Defenses", "WeaponsProjectile"]
	Resources = [[steel, 110], [coil2, 25], [tristeel, 6]]
	Size = [3, 3]
	SelectionPriority = 1
	MaxHealth = 12000
	TypeCategories = [defense, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-1, -1, 5, 1]]
		[tall, [-1, 0, 1, 3]]
		[tall, [3, 0, 1, 3]]
	]
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[3, 0]
		[3, 1]
		[3, 2]
		[0, 3]
		[1, 3]
		[2, 3]
		[0, -1]
		[1, -1]
		[2, -1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [55.2, 92]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 4
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		FirePrefToggle
		{
			Type = UIToggle
			ToggleID = "fire_pref"
			Default = 1
		}
		FirePrefAttack
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [0, 2]
		}
		FirePrefDefend
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [1, 2]
		}
		AttackToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefAttack]
			Mode = All
		}
		DefendToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefDefend]
			Mode = All
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, { Toggle=IsOverclocked; Invert=true }]
			Mode = All
		}
		// ---- municao ----
		MagStorage
		{
			Type = ResourceStorage
			ResourceType = rafaeltessaro.bs_mag_std
			MaxResources = 12
			UITileRect = [0 + 7/64, 2 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
		Splitter
		{
			Type = InlineResourceConverter
			ResourceType = rafaeltessaro.bs_mag_std
			FromStorage = MagStorage
			FromQuantity = 1
			ToQuantity = 5
		}
		MagConsumer
		{
			Type = ResourceConsumer
			ResourceType = rafaeltessaro.bs_mag_std
			Storage = MagStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		AmmoPrereq
		{
			Type = MultiToggle
			Toggles = [Splitter]
			Mode = Any
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [1.5, 1.28]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval
			{
				BaseValue = &~/FIRE_INTERVAL
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR)]
					}
				]
			}
			FiringArc = 360d
			RotateSpeed = 240d
			FireThresholdAngle = 10d
			TargetSearchesPerSecond = 8
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = BaseFlakEmitter
			IgnoreFriendlyShipLowLOSChecks = true
			AllowShipWideExplicitTargetsToggle = FirePrefAttack
			EstimateFirepowerToggle = AttackToggle
			AlwaysShowCoverage = true
			AllowDirectControlToggle = FirePrefAttack
			FirePermissionToggle = FireModeToggle
			AutoTargetCrewSafetyDist = 8
			AutoTargets
			[
				{
					TargetType = Bullets
					BulletTargetCategories = [missile, mine, bullet, laser, ion_shot]
					Toggle = DefendToggle
				}
				{
					TargetType = ShipParts
					Toggle = AttackToggle
					Overridable = true
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 255, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.15
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
		// ---- emissores (feixe + explosao em area) ----
		BaseFlakEmitter : <../../shots/bs_ciws/bs_flak_ciws.rules>
		{
			Type = BeamEmitter
			ChainedTo = Turret
			GetTargetFrom = Turret
			ResourceStorage = Splitter
			FireTrigger
			Location = [2.42, 0]
			OperationalToggle = IsOperationalNonOverclocked
			ResourcesUsed = 1
			Recoil = 4
			Burst = 3
			BurstDelay = 0.03
			UseResourcePerShotInBurst = true
		}
		FlakEmitter1 : BaseFlakEmitter
		{
			Location = [2.42, 0]
			FireTrigger = Turret
		}
		Overclock_BaseFlakEmitter : <../../shots/bs_ciws/bs_flak_ciws_oc.rules>/Beam, BaseFlakEmitter
		{
			OperationalToggle = IsOperationalOverclocked
		}
		Overclock_FlakEmitter1 : Overclock_BaseFlakEmitter, FlakEmitter1
		{
			Location = &^/1/Location
			FireTrigger = &^/1/FireTrigger
			ResourceStorage = &^/1/ResourceStorage
		}
		Emitter1Trigger
		{
			Type = MultiTrigger
			Triggers = [FlakEmitter1, Overclock_FlakEmitter1]
		}
		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Emitter1Trigger
			Location = [2.42, 0]
			MediaEffects
			[
				&<./Data/ships/terran/flak_cannon_large/particles/flak_cannon_shoot_flash_large.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_01.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_02.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_03.wav"
						"./Data/ships/terran/flak_cannon_large/sounds/flak_cannon_shot_04.wav"
					]
					Volume = 0.35
					SpeedVariation = 0.08
					MaxConcurrent = 30
				}
			]
		}
		// ---- tripulacao ----
		CrewLocation1
		{
			Type = CrewLocation
			Location = [0.75, 2.55]
			Rotation = 0d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [2.25, 2.55]
			Rotation = 0d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [AmmoPrereq]
			CrewDestinations = [&../../CrewLocation1/Location, &../../CrewLocation2/Location]
			CrewLocations = [CrewLocation1, CrewLocation2]
		}
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [1.5, 1.5]
		}
		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [Emitter1Trigger]
		}
		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
		Port_Thermal_L0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_L1 : Port_Thermal_L0
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_L2 : Port_Thermal_L0
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_R0 : Port_Thermal_L0
		{
			Location = [2, 0]
			Direction = Right
		}
		Port_Thermal_R1 : Port_Thermal_L0
		{
			Location = [2, 1]
			Direction = Right
		}
		Port_Thermal_R2 : Port_Thermal_L0
		{
			Location = [2, 2]
			Direction = Right
		}
		Port_Thermal_D0 : Port_Thermal_L0
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_D1 : Port_Thermal_L0
		{
			Location = [1, 2]
			Direction = Down
		}
		Port_Thermal_D2 : Port_Thermal_L0
		{
			Location = [2, 2]
			Direction = Down
		}
		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
		// ---- graficos ----
		Graphics
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [3, 3]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [3, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [3, 3]
					}
				]
			}
		}
		TurretGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "turret_shadow.png"
						Size = [2.87, 2.87]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"turret1.png"
							"turret2.png"
							"turret3.png"
							"turret4.png"
							"turret5.png"
							"turret6.png"
							"turret7.png"
							"turret8.png"
						]
						NormalsAnimationFiles
						[
							"turret1_normals.png"
							"turret2_normals.png"
							"turret3_normals.png"
							"turret4_normals.png"
							"turret5_normals.png"
							"turret6_normals.png"
							"turret7_normals.png"
							"turret8_normals.png"
						]
						Size = [2.62, 2.62]
						AnimationInterval = 0.1
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "turret_off.png"
						NormalsFile = "turret1_normals.png"
						Size = [2.62, 2.62]
					}
				]
			}
		}
		Barrel1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [1.525, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			ResetAnimationTrigger = Emitter1Trigger
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						Size = [0.42, 2.01]
						AnimationFiles = ["barrel_spin1.png", "barrel_spin2.png", "barrel_spin3.png", "barrel_spin4.png", "barrel1.png"]
						NormalsAnimationFiles
						[
							"barrel_spin_normals1.png"
							"barrel_spin_normals2.png"
							"barrel_spin_normals3.png"
							"barrel_spin_normals4.png"
							"barrel_normals1.png"
						]
						AnimationInterval = 0.05
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
						File = "barrel1.png"
						NormalsFile = "barrel_normals1.png"
						Size = [0.42, 2.01]
					}
				]
			}
		}
		Light1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [-0.95, 0]
			OperationalToggle = IsOperational
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [1.2, 1.2]
						Z = 0.8
						VertexColor = [255, 120, 30]
					}
				]
			}
		}
		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOnLarge
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOffLarge
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1.5]
		}
		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1, 2, 3, 4]
				}
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2, 3, 4]
				}
				{
					Toggle = AmmoPrereq
					Delay = &~/FIRE_INTERVAL
					AtlasSprite
					{
						File = &/INDICATORS/NoAmmo
						Size = [1, 1]
					}
				}
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 3]
		}
	}
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = &~/Part/Components/MagStorage/MaxResources
		BSShotsPerMag = &~/Part/Components/Splitter/ToQuantity
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/BSFlak"
			Stats
			{
				DamagePerShotVsShots = &~/Part/Components/BaseFlakEmitter/STAT_DAMAGE
				DamagePerShot = &~/Part/Components/BaseFlakEmitter/STAT_SHIP_DAMAGE
				ROF = 3 / (&~/Part/Components/Turret/FireInterval/BaseValue)
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				DamagePerSecondVsShots = (&DamagePerShotVsShots) * (&ROF)
				MaxDamage = [&../DamagePerShot, &../DamagePerSecond]
				ShotDamage = [&../DamagePerShotVsShots, &../DamagePerSecondVsShots]
				DamageArea = &~/Part/Components/BaseFlakEmitter/STAT_RADIUS
				Range = &~/Part/Components/BaseFlakEmitter/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = Infinity
				AmmoPerShot = (&~/Part/Components/BaseFlakEmitter/ResourcesUsed) / (&~/Part/Components/Splitter/ToQuantity)
				AmmoPerSecond = (&AmmoPerShot) * (&ROF)
				ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/BSCiwsOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/BSFlak"
				Stats
				{
					ROF = 3 / ((&~/Part/Components/Turret/FireInterval/BaseValue) * (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR))
					ShrapnelFieldRadius = &~/Part/Components/Overclock_BaseFlakEmitter/STAT_CLOUD_RADIUS
					ShrapnelFieldDamagePool = &~/Part/Components/Overclock_BaseFlakEmitter/STAT_CLOUD_POOL
					ShrapnelFieldLifetime = &~/Part/Components/Overclock_BaseFlakEmitter/STAT_CLOUD_LIFETIME
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					HeatGeneration = (&~/OVERCLOCK/HEAT_PER_SECOND)
				}
			}
		]
	}
}
