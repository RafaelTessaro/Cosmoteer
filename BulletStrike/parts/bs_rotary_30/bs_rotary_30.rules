// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Arma: 30mm Heavy Rotary Cannon / Canhão Rotativo Pesado 30 mm

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 0.7143
	HALF_SPREAD = 2.2d
	RECOIL_FACTOR = 160%
	HEAT_PER_SHOT = 120
	HEAT_PER_SECOND = 100
	MAX_SPIN = 6
	SPIN_UP_TIME = 4
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 0.5
SPIN
{
	MAX = 6
	UP_TIME = 6
	DOWN_TIME = 3
}
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
