		// ---- spin-up (chaingun.rules l.191-287) ----
		IsFiringTimer
		{
			Type = Timer
			Duration = 1
			StartTrigger = Turret
			ResetTrigger = Turret
			StartExpired = true
			InvertToggle = true
		}
		IsSpinning
		{
			Type = MultiToggle
			Toggles = [IsFiringTimer, AmmoPrereq]
			Mode = All
		}
		SpinUp
		{
			Type = ValueAccumulator
			AccumulatingToggle = IsSpinning
			MinValue = 1
			BaseValue = &MinValue
			MaxValue
			{
				BaseValue = &~/SPIN/MAX
				Modifiers
				[
					{
						Type = Buff
						BuffType = Overclock
						ModificationMode = Replace
						MinValue = &~/OVERCLOCK/MAX_SPIN
						MaxValue = &MinValue
					}
				]
			}
			AccumulationRate
			{
				BaseValue = ((&~/SPIN/MAX) - 1) / (&~/SPIN/UP_TIME)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Replace
						RemapFrom = [0, 1]
						RemapTo = [&../../../BaseValue, ((&~/OVERCLOCK/MAX_SPIN) - 1) / (&~/OVERCLOCK/SPIN_UP_TIME)]
					}
				]
			}
			DissipationRate = ((&~/SPIN/MAX) - 1) / (&~/SPIN/DOWN_TIME)
		}
		RateOfFireBuff
		{
			Type = SelfBuffProvider
			BuffType = RateOfFire
			BuffAmount = 1
			BuffMultiplier = SpinUp
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [2, 1.55]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FireModeToggle
			FireInterval
			{
				BaseValue = &~/FIRE_INTERVAL
				Modifiers
				[
					{
						Type = Buff
						BuffType = RateOfFire
						ModificationMode = Divide
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR)]
					}
				]
			}
			FiringArc = 300d
			RotateSpeed = 40d
			FireThresholdAngle = 2d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = TargetEmitterProxy
			IgnoreFriendlyShipLowLOSChecks = true
			IgnoreFriendlyShipHighLOSChecks = true
			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.45
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
