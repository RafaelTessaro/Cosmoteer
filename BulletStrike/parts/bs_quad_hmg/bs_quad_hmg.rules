	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = &~/Part/Components/MagStorage_0/MaxResources
		BSShotsPerMag = &~/Part/Components/Splitter_0/ToQuantity
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/BSAmmo_std"
			Stats
			{
				DamagePerShot = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/STAT_DAMAGE
				ShotsPerSecond = 2 * 1 / (&~/Part/Components/Turret/FireInterval/BaseValue)
				DamagePerSecond = (&DamagePerShot) * (&ShotsPerSecond)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				Penetration = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/STAT_PENETRATION
				ROF = &ShotsPerSecond
				Range = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				Spread = deg(&~/Part/Components/Fire_0_N/Components/TargetEmitter/Spread/1)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/Fire_0_N/Components/TargetEmitter/Bullet/Components/Targetable/Health
				AmmoPerShot = (&~/Part/Components/Fire_0_N/Components/TargetEmitter/ResourcesUsed) / (&~/Part/Components/Splitter_0/ToQuantity)
				AmmoPerSecond = (&AmmoPerShot) * (&ShotsPerSecond)
				ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/BSQuadHmgOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/BSAmmo_std"
				Stats
				{
					DamagePerShot = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/STAT_DAMAGE
					ShotsPerSecond = 2 * 1 / ((&~/Part/Components/Turret/FireInterval/BaseValue) * (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR))
					DamagePerSecond = (&DamagePerShot) * (&ShotsPerSecond)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ROF = &ShotsPerSecond
					Range = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/Range
					Spread = deg(&~/OVERCLOCK/HALF_SPREAD)
					ShotSpeed = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/Speed
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					HeatGeneration = (&~/OVERCLOCK/HEAT_PER_SECOND)
					Penetration = &~/Part/Components/Fire_0_OC/Components/TargetEmitter/Bullet/STAT_PENETRATION
				}
			}
		]
	}
