			MediaEffects
			[
				&<./Data/ships/terran/chaingun/particles/chaingun_shoot.rules>
				&<./Data/ships/terran/chaingun/particles/chaingun_shoot_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
