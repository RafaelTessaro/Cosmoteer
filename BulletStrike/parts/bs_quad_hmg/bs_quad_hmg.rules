// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Arma: Quad Heavy Machine Gun / Metralhadora Pesada Quádrupla

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 0.7143
	HALF_SPREAD = 2.8d
	RECOIL_FACTOR = 160%
	HEAT_PER_SHOT = 30
	HEAT_PER_SECOND = 40
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 0.1429
Part : <./Data/ships/terran/base_med_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSQuadHmg"
	IconNameKey = "Parts/BSQuadHmgIcon"
	DescriptionKey = "Parts/BSQuadHmgDesc"
	ID = rafaeltessaro.bs_quad_hmg
	EditorGroups = ["BulletStrike", "WeaponsProjectile"]
	Resources = [[steel, 60], [coil2, 6], [tristeel, 4]]
	Size = [2, 2]
	SelectionPriority = 1
	MaxHealth = 8000
	TypeCategories = [weapon, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-1, -1, 4, 1]]
		[tall, [-1, 0, 1, 2]]
		[tall, [2, 0, 1, 2]]
	]
	AllowedDoorLocations = [[-1, 0], [-1, 1], [2, 0], [2, 1], [0, 2], [1, 2], [0, -1], [1, -1]]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [42.67, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 3
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		FirePrefToggle
		{
			Type = UIToggle
			ToggleID = "fire_pref"
			Default = 2
		}
		FirePrefAttack
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [0, 2]
		}
		FirePrefDefend
		{
			Type = ModeToggle
			Mode = FirePrefToggle
			OnModes = [1, 2]
		}
		AttackToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefAttack]
			Mode = All
		}
		DefendToggle
		{
			Type = MultiToggle
			Toggles = [AutoTargetToggle, FirePrefDefend]
			Mode = All
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, { Toggle=IsOverclocked; Invert=true }]
			Mode = All
		}
		// ---- municao (carregadores abertos em N tiros) ----
		MagStorage_0
		{
			Type = ResourceStorage
			ResourceType = rafaeltessaro.bs_mag_std
			MaxResources = 6
			UITileRect = [0 + 7/64, 1 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
		Splitter_0
		{
			Type = InlineResourceConverter
			ResourceType = rafaeltessaro.bs_mag_std
			FromStorage = MagStorage_0
			FromQuantity = 1
			ToQuantity = 50
		}
		MagConsumer_0
		{
			Type = ResourceConsumer
			ResourceType = rafaeltessaro.bs_mag_std
			Storage = MagStorage_0
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		AmmoPrereq
		{
			Type = MultiToggle
			Toggles = [Splitter_0]
			Mode = Any
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [1, 0.95]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FireModeToggle
			FireInterval
			{
				BaseValue = &~/FIRE_INTERVAL
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR)]
					}
				]
			}
			FiringArc = 360d
			RotateSpeed = 150d
			FireThresholdAngle = 2d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = TargetEmitterProxy
			IgnoreFriendlyShipLowLOSChecks = true
			AutoTargets
			[
				{
					TargetType = Bullets
					BulletTargetCategories = [missile, mine, bullet]
					Toggle = DefendToggle
				}
				{
					TargetType = ShipParts
					Toggle = AttackToggle
					Overridable = true
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
			TargetSearchesPerSecond = 6
			AllowShipWideExplicitTargetsToggle = FirePrefAttack
			EstimateFirepowerToggle = AttackToggle
			AllowDirectControlToggle = FirePrefAttack
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 0.86
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
		ShootCycle
		{
			Type = ModeCycle
			ModeRange = [0, 1]
			IncrementTrigger = Turret
			StartingMode = 1
		}
		ShootTrigger1
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [0]
		}
		ShootTrigger2
		{
			Type = ModeTrigger
			Mode = ShootCycle
			TriggerInModes = [1]
		}
		// ---- emissores: um bloco por tipo de municao (e por estado de overclock) ----
		Fire_0_N
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				TargetEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger
					GetTargetFrom = Turret
					Location = [1.55, 0]
					OperationalToggle = IsOperational
					Bullet = &<../../shots/bs_shot_quad_hmg_std/bs_shot_quad_hmg_std.rules>
					Spread = [-2.0d, 2.0d]
					ResourceStorage = Splitter_0
					ResourcesUsed = 1
					Recoil = 2
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : TargetEmitter
				{
					Location = [1.55, -0.27]
					FireTrigger = ShootTrigger1
				}
				Emitter2 : TargetEmitter
				{
					Location = [1.55, -0.09]
					FireTrigger = ShootTrigger2
				}
				Emitter3 : TargetEmitter
				{
					Location = [1.55, 0.09]
					FireTrigger = ShootTrigger1
				}
				Emitter4 : TargetEmitter
				{
					Location = [1.55, 0.27]
					FireTrigger = ShootTrigger2
				}
			}
		}
		Fire_0_OC
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			IncludeInBlueprints = false
			Components
			{
				TargetEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger
					GetTargetFrom = Turret
					Location = [1.55, 0]
					OperationalToggle = IsOperational
					Bullet = &<../../shots/bs_shot_quad_hmg_std/bs_shot_quad_hmg_std.rules>
					Spread = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					ResourceStorage = Splitter_0
					ResourcesUsed = 1
					Recoil = 2 * (&~/OVERCLOCK/RECOIL_FACTOR)
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : TargetEmitter
				{
					Location = [1.55, -0.27]
					FireTrigger = ShootTrigger1
				}
				Emitter2 : TargetEmitter
				{
					Location = [1.55, -0.09]
					FireTrigger = ShootTrigger2
				}
				Emitter3 : TargetEmitter
				{
					Location = [1.55, 0.09]
					FireTrigger = ShootTrigger1
				}
				Emitter4 : TargetEmitter
				{
					Location = [1.55, 0.27]
					FireTrigger = ShootTrigger2
				}
			}
		}
		TargetEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = TargetEmitter
			ChainedTo = Turret
		}
		Emitter1Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter1
			ChainedTo = Turret
			Location = [1.55, -0.27]
		}
		Emitter1Proxy_OC : Emitter1Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter1Proxy_N : Emitter1Proxy_OC
		{
			InvertProxyToggle = true
		}
		Emitter2Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter2
			ChainedTo = Turret
			Location = [1.55, -0.09]
		}
		Emitter2Proxy_OC : Emitter2Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter2Proxy_N : Emitter2Proxy_OC
		{
			InvertProxyToggle = true
		}
		Emitter3Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter3
			ChainedTo = Turret
			Location = [1.55, 0.09]
		}
		Emitter3Proxy_OC : Emitter3Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter3Proxy_N : Emitter3Proxy_OC
		{
			InvertProxyToggle = true
		}
		Emitter4Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter4
			ChainedTo = Turret
			Location = [1.55, 0.27]
		}
		Emitter4Proxy_OC : Emitter4Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter4Proxy_N : Emitter4Proxy_OC
		{
			InvertProxyToggle = true
		}
		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Emitter1Proxy_N
			Trigger = Emitter1Proxy_N
			Location = [-0.3, 0]
			MediaEffects
			[
				&<./Data/ships/terran/chaingun/particles/chaingun_shoot.rules>
				&<./Data/ships/terran/chaingun/particles/chaingun_shoot_flash.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"./Data/ships/terran/chaingun/sounds/chain_gun_shot_01.wav"
						"./Data/ships/terran/chaingun/sounds/chain_gun_shot_02.wav"
						"./Data/ships/terran/chaingun/sounds/chain_gun_shot_03.wav"
						"./Data/ships/terran/chaingun/sounds/chain_gun_shot_04.wav"
						"./Data/ships/terran/chaingun/sounds/chain_gun_shot_05.wav"
					]
					Volume = 0.55
					SpeedVariation = 0.15
					MaxConcurrent = 40
				}
			]
		}
