		Barrel1Graphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [2.83, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			ResetAnimationTrigger = Emitter1Proxy
			OperationalDoodad
			{
				Layer = "roof_turrets"
				DamageLevels
				[
					{
