// Bullet Strike - arquivo gerado por tools/build_mod.py (nao edite a mao; edite tools/bs_data.py).
// Arma: Nuclear Deck Howitzer / Obuseiro Nuclear de Convés

OVERCLOCK
{
	FIRE_INTERVAL_FACTOR = 1
	HALF_SPREAD = 0.625d
	RECOIL_FACTOR = 160%
	HEAT_PER_SHOT = 15000
	HEAT_PER_SECOND = 200
	CREW_STUN_DURATION = 1.5
	CREW_STUN_RADIUS = 10.4
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
FIRE_INTERVAL = 10
Part : <./Data/ships/terran/base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/BSNukeHowitzer"
	IconNameKey = "Parts/BSNukeHowitzerIcon"
	DescriptionKey = "Parts/BSNukeHowitzerDesc"
	ID = rafaeltessaro.bs_nuke_howitzer
	EditorGroups = ["BulletStrike", "WeaponsProjectile"]
	Resources = [[steel, 300], [coil2, 80], [tristeel, 60], [enriched_uranium, 4]]
	Size = [5, 6]
	SelectionPriority = 1
	MaxHealth = 36000
	TypeCategories = [weapon, uses_ammo, is_crewed, bs_limit_nuke]
	SignificanceToggle = ScorchedToggle
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-2, -2, 9, 2]]
		[tall, [-2, 0, 2, 6]]
		[tall, [5, 0, 2, 6]]
	]
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[-1, 3]
		[-1, 4]
		[-1, 5]
		[5, 0]
		[5, 1]
		[5, 2]
		[5, 3]
		[5, 4]
		[5, 5]
		[0, 6]
		[1, 6]
		[2, 6]
		[3, 6]
		[4, 6]
		[0, -1]
		[1, -1]
		[2, -1]
		[3, -1]
		[4, -1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [51.11, 92]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}
		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}
		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 12
		}
		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, { Toggle=IsOverclocked; Invert=true }]
			Mode = All
		}
		// ---- municao (carregadores abertos em N tiros) ----
		MagStorage_0
		{
			Type = ResourceStorage
			ResourceType = rafaeltessaro.bs_shell_nuke
			MaxResources = 10
			UITileRect = [0 + 7/64, 5 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}
		Splitter_0
		{
			Type = InlineResourceConverter
			ResourceType = rafaeltessaro.bs_shell_nuke
			FromStorage = MagStorage_0
			FromQuantity = 1
			ToQuantity = 1
		}
		MagConsumer_0
		{
			Type = ResourceConsumer
			ResourceType = rafaeltessaro.bs_shell_nuke
			Storage = MagStorage_0
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -0.4]
		}
		AmmoPrereq
		{
			Type = MultiToggle
			Toggles = [Splitter_0]
			Mode = Any
		}
		// ---- torre ----
		Turret
		{
			Type = TurretWeapon
			Location = [2.5, 2.5]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FireModeToggle
			FireInterval
			{
				BaseValue = &~/FIRE_INTERVAL
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/FIRE_INTERVAL_FACTOR)]
					}
				]
			}
			FiringArc = 270d
			RotateSpeed = 10d
			FireThresholdAngle = 2d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = TargetEmitterProxy
			IgnoreFriendlyShipLowLOSChecks = true
			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]
			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64
		}
		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 2.2
			IsHigh = true
		}
		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}
		// ---- emissores: um bloco por tipo de municao (e por estado de overclock) ----
		Fire_0_N
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				TargetEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger
					GetTargetFrom = Turret
					Location = [5.1, 0]
					OperationalToggle = IsOperational
					Bullet = &<../../shots/bs_shot_nuke_howitzer_nuclear/bs_shot_nuke_howitzer_nuclear.rules>
					Spread = [-0.5d, 0.5d]
					ResourceStorage = Splitter_0
					ResourcesUsed = 1
					Recoil = 400
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : TargetEmitter
				{
					Location = [5.1, 0]
					FireTrigger = Turret
				}
			}
		}
		Fire_0_OC
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			IncludeInBlueprints = false
			Components
			{
				TargetEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger
					GetTargetFrom = Turret
					Location = [5.1, 0]
					OperationalToggle = IsOperational
					Bullet = &<../../shots/bs_shot_nuke_howitzer_nuclear_oc/bs_shot_nuke_howitzer_nuclear_oc.rules>
					Spread = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					ResourceStorage = Splitter_0
					ResourcesUsed = 1
					Recoil = 400 * (&~/OVERCLOCK/RECOIL_FACTOR)
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : TargetEmitter
				{
					Location = [5.1, 0]
					FireTrigger = Turret
				}
			}
		}
		TargetEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = TargetEmitter
			ChainedTo = Turret
		}
		Emitter1Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter1
			ChainedTo = Turret
			Location = [5.1, 0]
		}
		Emitter1Proxy_OC : Emitter1Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter1Proxy_N : Emitter1Proxy_OC
		{
			InvertProxyToggle = true
		}
		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Emitter1Proxy_N
			Trigger = Emitter1Proxy_N
			Location = [-0.5, 0]
			MediaEffects
			[
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck_flash.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck_flare.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_smoke_deck.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/ships/terran/cannon_deck/sounds/deck_cannon_overclocked_shot.wav"
					Volume = 1
					SpeedVariation = 0.15
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.16
					Duration = 0.9
				}
			]
		}
		Overclock_FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Emitter1Proxy_OC
			Trigger = Emitter1Proxy_OC
			Location = [-0.5, 0]
			MediaEffects
			[
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck_flash.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_shoot_deck_flare.rules>
				&<./Data/ships/terran/cannon_deck/particles/cannon_smoke_deck.rules>
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/ships/terran/cannon_deck/sounds/deck_cannon_overclocked_shot.wav"
					Volume = 1
					SpeedVariation = 0.15
				}
				: /BASE_SHAKE
				{
					ShakeAmount = 0.16
					Duration = 0.9
				}
			]
		}
		StunTrigger
		{
			Type = MultiTrigger
			Triggers = [Emitter1Proxy]
		}
		StunEffect
		{
			Type = TriggeredEffects
			Location = [2.5, 2.5]
			Trigger = StunTrigger
			HitEffects
			[
				{
					Type = AreaCrewStun
					Duration
					{
						BaseValue = 1
						BuffType = Overclock
						BuffMode = Lerp
						MinValue = &BaseValue
						MaxValue = &~/OVERCLOCK/CREW_STUN_DURATION
					}
					Falloff = 1
					Radius
					{
						BaseValue = 8
						BuffType = Overclock
						BuffMode = Lerp
						MinValue = &BaseValue
						MaxValue = &~/OVERCLOCK/CREW_STUN_RADIUS
					}
					Filter
					{
						Friendlies = true
						IgnoreInvulnerability = true
					}
					Cumulative = true
					HitShipOnly = true
				}
			]
		}
		// ---- tripulacao ----
		CrewLocation1
		{
			Type = CrewLocation
			Location = [0.417, 5.55]
			Rotation = 0d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [1.25, 5.55]
			Rotation = 0d
		}
		CrewLocation3
		{
			Type = CrewLocation
			Location = [2.083, 5.55]
			Rotation = 0d
		}
		CrewLocation4
		{
			Type = CrewLocation
			Location = [2.917, 5.55]
			Rotation = 0d
		}
		CrewLocation5
		{
			Type = CrewLocation
			Location = [3.75, 5.55]
			Rotation = 0d
		}
		CrewLocation6
		{
			Type = CrewLocation
			Location = [4.583, 5.55]
			Rotation = 0d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 6
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [AmmoPrereq]
			CrewDestinations
			[
				&../../CrewLocation1/Location
				&../../CrewLocation2/Location
				&../../CrewLocation3/Location
				&../../CrewLocation4/Location
				&../../CrewLocation5/Location
				&../../CrewLocation6/Location
			]
			CrewLocations = [CrewLocation1, CrewLocation2, CrewLocation3, CrewLocation4, CrewLocation5, CrewLocation6]
		}
		// ---- overclock (base_part_overclock.rules + cannon_deck.rules l.323-413) ----
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [2.5, 3]
		}
		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [Emitter1Proxy]
		}
		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
		Port_Thermal_L0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_L1 : Port_Thermal_L0
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_L2 : Port_Thermal_L0
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_L3 : Port_Thermal_L0
		{
			Location = [0, 3]
			Direction = Left
		}
		Port_Thermal_L4 : Port_Thermal_L0
		{
			Location = [0, 4]
			Direction = Left
		}
		Port_Thermal_L5 : Port_Thermal_L0
		{
			Location = [0, 5]
			Direction = Left
		}
		Port_Thermal_R0 : Port_Thermal_L0
		{
			Location = [4, 0]
			Direction = Right
		}
		Port_Thermal_R1 : Port_Thermal_L0
		{
			Location = [4, 1]
			Direction = Right
		}
		Port_Thermal_R2 : Port_Thermal_L0
		{
			Location = [4, 2]
			Direction = Right
		}
		Port_Thermal_R3 : Port_Thermal_L0
		{
			Location = [4, 3]
			Direction = Right
		}
		Port_Thermal_R4 : Port_Thermal_L0
		{
			Location = [4, 4]
			Direction = Right
		}
		Port_Thermal_R5 : Port_Thermal_L0
		{
			Location = [4, 5]
			Direction = Right
		}
		Port_Thermal_D0 : Port_Thermal_L0
		{
			Location = [0, 5]
			Direction = Down
		}
		Port_Thermal_D1 : Port_Thermal_L0
		{
			Location = [1, 5]
			Direction = Down
		}
		Port_Thermal_D2 : Port_Thermal_L0
		{
			Location = [2, 5]
			Direction = Down
		}
		Port_Thermal_D3 : Port_Thermal_L0
		{
			Location = [3, 5]
			Direction = Down
		}
		Port_Thermal_D4 : Port_Thermal_L0
		{
			Location = [4, 5]
			Direction = Down
		}
		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ShotsPerSecond)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
		// ---- graficos ----
		Graphics
		{
			Type = Graphics
			Location = [2.5, 3]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [5, 6]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [5, 6]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
