		// ---- modo emp (Poraquê): rack, autoloader, troca de modo, salva parcial ----
		ReadyRack_emp
		{
			Type = ResourceStorage
			ResourceType = missile_part_emp
			MaxResources = &~/MODE_emp/CELLS
			ToggleOnResources = &~/MODE_emp/CELLS
			ToggleOffResources = 0
			AnticipateMoreResourcesFrom = [MagStorage_EMP]
			DropResourcesWhenDestroyed = false
		}
		RackAny_emp
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_emp
			ResourceStorages = [ReadyRack_emp]
			ToggleOnResources = 1
			ToggleOffResources = 0
		}
		MagCanLoad_emp
		{
			Type = MultiResourceStorage
			ResourceType = missile_part_emp
			ResourceStorages = [MagStorage_EMP]
			ToggleOnResources = &~/MODE_emp/PARTS
			ToggleOffResources = (&ToggleOnResources) - 1
		}
		LoaderOn_emp
		{
			Type = MultiToggle
			Toggles = [IsOperational, ModeToggle_emp, { Toggle=ReadyRack_emp; Invert=true }]
			Mode = All
		}
		Autoloader_emp
		{
			Type = ResourceConverter
			OperationalToggle = LoaderOn_emp
			CheckResourceLimits = true
			FromStorage = MagStorage_EMP
			FromQuantity = &~/MODE_emp/PARTS
			ToStorage = ReadyRack_emp
			ToQuantity = 1
			Interval
			{
				BaseValue = &~/MODE_emp/RELOAD
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/MODE_emp/OC_FACTOR]
						ModificationMode = Divide
					}
				]
			}
		}
		ReloadEffect_emp
		{
			Type = TriggeredEffects
			Trigger = Autoloader_emp
			Location = &../DestroyedEffects/Location
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
