		{
			Type = StaticValue
			LOAD_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_PART) * (&~/MODE_he/PARTS) * (&~/MODE_he/OC_FACTOR) / (&~/MODE_he/RELOAD)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&LOAD_HEAT_PER_SECOND)
		}
