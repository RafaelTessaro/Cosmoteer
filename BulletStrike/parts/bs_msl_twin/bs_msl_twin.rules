// Lancador de misseis: Twin-Pod Deck Missile Launcher / Lançador de Mísseis de Convés de Casulo Duplo ("Caipora")

OVERCLOCK
{
	RELOAD_FACTOR = 1.5
	HEAT_PER_PART = 425
	HEAT_PER_SECOND = 100
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
RIPPLE = 4/30
MODE_he
{
	CELLS = 16
	PARTS = 2
	MISSILES_PER_UNIT = 1
	RELOAD = 1.06
	VENT = 2
	OC_FACTOR = 1.5
	SALVO_TIME = ((&CELLS) - 1) * (&~/RIPPLE)
	CYCLE = (&CELLS) * (&RELOAD) + (&SALVO_TIME)
	OC_CYCLE = (&CELLS) * (&RELOAD) / (&OC_FACTOR) + (&SALVO_TIME)
}
