  "body_width": "c^0.6",
  "cannon_flame": "sqrt(c/155) x cannon_shoot_deck",
  "mg_flame": "(c/27)^0.75 x chaingun_shoot",
  "he_mes": "raio/4 (missile_he = r4)",
  "light_split": "luz do projetil = halo SO NO ESPACO (glow/4, refl 0, add 0, unlit 0,8 tracante / 0,5 granada) + luz de casco (palette.hull, refl 6; AC e slug 4; canal mais fraco <= floor(0,5 x 255 / (0,85 x refl))): fxkit.light_pair",
  "pen_media": "pecas atravessadas = PEN_S/M/L (seam_tier_map) a pen_mes, sem tremor; preset cheio so no primeiro acerto e onde a granada para",
  "start_time": "StartTime das luzes = clamp((raio da torre + 1) / velocidade, 0,01, 0,05) s"
 },
